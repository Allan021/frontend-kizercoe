{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "astro",
  "trailingSlash": true,
  "redirects": [
    { "source": "/servicios/reparacion-telefonos/", "destination": "/servicios/reparacion-computadoras/", "permanent": true },
    { "source": "/en/services/phone-repair/", "destination": "/en/services/computer-repair/", "permanent": true },
    { "source": "/servicios/diseno-ux-ui", "destination": "/servicios/sistemas-a-la-medida/", "permanent": true },
    { "source": "/servicios/diseno-ux-ui/", "destination": "/servicios/sistemas-a-la-medida/", "permanent": true },
    { "source": "/servicios/identidad-visual", "destination": "/servicios/paginas-web/", "permanent": true },
    { "source": "/servicios/identidad-visual/", "destination": "/servicios/paginas-web/", "permanent": true },
    { "source": "/en/services/ux-ui-design", "destination": "/en/services/custom-software/", "permanent": true },
    { "source": "/en/services/ux-ui-design/", "destination": "/en/services/custom-software/", "permanent": true },
    { "source": "/en/services/branding", "destination": "/en/services/websites/", "permanent": true },
    { "source": "/en/services/branding/", "destination": "/en/services/websites/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/kizercode.vcf",
      "headers": [
        { "key": "Content-Type", "value": "text/vcard; charset=utf-8" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"Kizercode.vcf\"" }
      ]
    }
  ]
}
