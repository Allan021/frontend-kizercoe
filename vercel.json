{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "astro",
  "redirects": [
    { "source": "/servicios/diseno-ux-ui", "destination": "/servicios/sistemas-a-la-medida/", "permanent": true },
    { "source": "/servicios/diseno-ux-ui/", "destination": "/servicios/sistemas-a-la-medida/", "permanent": true },
    { "source": "/servicios/identidad-visual", "destination": "/servicios/paginas-web/", "permanent": true },
    { "source": "/servicios/identidad-visual/", "destination": "/servicios/paginas-web/", "permanent": true },
    { "source": "/en/services/ux-ui-design", "destination": "/en/services/custom-software/", "permanent": true },
    { "source": "/en/services/ux-ui-design/", "destination": "/en/services/custom-software/", "permanent": true },
    { "source": "/en/services/branding", "destination": "/en/services/websites/", "permanent": true },
    { "source": "/en/services/branding/", "destination": "/en/services/websites/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
