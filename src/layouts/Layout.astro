---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  keywords?: string;
  locale?: string;
  type?: 'website' | 'article';
  /** Páginas que no van a Google (el panel, por ejemplo). */
  noindex?: boolean;
}

const {
  title = 'Kizercode — Brand · Software · Growth | Honduras',
  description = 'Custom software, web & mobile apps, branding, digital marketing and billing systems for enterprises in Honduras and Latin America.',
  image = '/og-image.png',
  imageAlt = 'Kizercode — Software & Branding Agency in Honduras',
  keywords = 'software development Honduras, web apps, mobile apps, branding, marketing digital, billing systems, digital transformation, enterprise software, reparación de computadoras El Progreso, reparación de celulares Honduras, compra y venta de computadoras, El Progreso Yoro',
  locale = 'en_US',
  type = 'website',
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);

// Herramientas de Google, activadas por env para no ensuciar el desarrollo:
// GA_ID viene de Analytics (G-XXXXXXX) y la verificación de Search Console.
const GA_ID = import.meta.env.PUBLIC_GA_ID;
const GOOGLE_VERIFICATION = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
---
<!doctype html>
<html lang="en" data-theme="dark" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="view-transition" content="same-origin" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="author" content="Kizercode" />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
  <meta name="theme-color" content="#0a0a0a" />
  <link rel="canonical" href={canonicalURL} />
  {GOOGLE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_VERIFICATION} />}

  {/* Google Analytics 4. Solo si hay ID: en local no mide nada. */}
  {GA_ID && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
      <script is:inline define:vars={{ GA_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', GA_ID, { anonymize_ip: true });
      </script>
    </>
  )}

  <!-- Open Graph -->
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={imageAlt} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:locale" content={locale} />
  <meta property="og:locale:alternate" content="es_HN" />
  <meta property="og:site_name" content="Kizercode" />

  <!-- Twitter / X Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@kizercode" />
  <meta name="twitter:creator" content="@kizercode" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />
  <meta name="twitter:image:alt" content={imageAlt} />

  <!-- Fonts — non-render-blocking: preload + swap -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap"
  />
  <link
    href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap"
    rel="stylesheet"
    media="print"
    onload="this.media='all'"
  />
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  </noscript>

  <!-- hreflang — bilingual EN/ES -->
  <link rel="alternate" hreflang="en" href={canonicalURL} />
  <link rel="alternate" hreflang="es" href={canonicalURL} />
  <link rel="alternate" hreflang="x-default" href={canonicalURL} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Schema.org -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "LocalBusiness",
        "@id": "https://www.kizercode.com/#business",
        "name": "Kizercode",
        "description": description,
        "url": "https://www.kizercode.com",
        "logo": {
          "@type": "ImageObject",
          "url": "https://www.kizercode.com/og-image.png",
          "width": 1200,
          "height": 630
        },
        "image": "https://www.kizercode.com/og-image.png",
        "priceRange": "$$",
        "areaServed": [
          { "@type": "Country", "name": "Honduras" },
          { "@type": "Country", "name": "Guatemala" },
          { "@type": "Country", "name": "El Salvador" },
          { "@type": "Country", "name": "Costa Rica" }
        ],
        "telephone": "+50498622160",
        "address": {
          "@type": "PostalAddress",
          "addressCountry": "HN",
          "addressLocality": "El Progreso",
          "addressRegion": "Yoro"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "sales",
          "telephone": "+50498622160",
          "email": "hello@kizercode.com",
          "availableLanguage": ["English", "Spanish"]
        },
        "makesOffer": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Custom software and web applications" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "AI automation and integrations" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Digital marketing and SEO" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Reparación de computadoras y teléfonos" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Compra y venta de equipos" } }
        ],
        "sameAs": [
          "https://www.linkedin.com/company/kizercode",
          "https://github.com/kizercode"
        ]
      },
      {
        "@type": "WebSite",
        "@id": "https://www.kizercode.com/#website",
        "url": "https://www.kizercode.com",
        "name": "Kizercode",
        "publisher": { "@id": "https://www.kizercode.com/#business" }
      }
    ]
  })} />

  <!-- Theme init — runs before paint to prevent flash -->
  <script is:inline>
    (function() {
      const saved = localStorage.getItem('kz-theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = saved || (prefersDark ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);

      const lang = localStorage.getItem('kz-lang') || 'en';
      document.documentElement.setAttribute('lang', lang);
    })();
  </script>
</head>
<body>
  <!-- Primer elemento enfocable de la página: quien navega con teclado o
       lector de pantalla salta el menú de una vez, en vez de tabular por los
       ocho enlaces del nav en cada carga. -->
  <a href="#contenido" class="kz-skip">
    <span class="en">Skip to content</span><span class="es">Saltar al contenido</span>
  </a>
  <slot />
  <script>
    // Defer GSAP to after first paint — reduces forced reflows and LCP render delay
    async function bootAnimations() {
      const { initGSAP, animateHero, animateSections, initMagneticButtons, initNavScroll } =
        await import('@/lib/animations/gsap');

      initGSAP();
      // Hero animates immediately (above the fold)
      animateHero();
      // Defer below-the-fold animations to idle time
      if ('requestIdleCallback' in window) {
        requestIdleCallback(() => {
          animateSections();
          initMagneticButtons();
          initNavScroll();
        });
      } else {
        setTimeout(() => {
          animateSections();
          initMagneticButtons();
          initNavScroll();
        }, 100);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bootAnimations);
    } else {
      // DOM already ready — schedule on next frame to avoid blocking paint
      requestAnimationFrame(bootAnimations);
    }
  </script>
</body>
</html>
