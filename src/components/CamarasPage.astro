  <script is:inline>
    // El reloj del HUD. Es el detalle que convierte un marco dibujado en algo
    // que parece una cámara encendida — y cuesta seis líneas.
    (function () {
      var el = document.getElementById('kz-reloj');
      if (!el) return;
      var dos = function (n) { return String(n).padStart(2, '0'); };
      var tic = function () {
        var d = new Date();
        el.textContent = dos(d.getHours()) + ':' + dos(d.getMinutes()) + ':' + dos(d.getSeconds());
      };
      tic();
      setInterval(tic, 1000);
    })();
  </script>

  <script is:inline define:vars={{ otra }}>
    // En páginas con URL por idioma, el toggle ES/EN navega a la contraparte
    // en vez de solo cambiar el CSS: así Google indexa las dos versiones.
    document.getElementById('lang-toggle')?.addEventListener(
      'click',
      (e) => {
        e.stopImmediatePropagation();
        localStorage.setItem('kz-lang', otra.startsWith('/en/') ? 'en' : 'es');
        location.href = otra;
      },
      { capture: true },
    );
  </script>
</Layout>

<style>
  /* La maqueta pide JetBrains Mono. Traer una fuente completa para seis
     renglones de etiquetas no se paga: la pila del sistema es la que el
     design system ya define para números y tags. */
  .kz-mono {
    font-family: ui-monospace, Menlo, Consolas, monospace;
  }

  .kz-wrap {
    max-width: 1240px;
    margin: 0 auto;
    padding-left: 28px;
    padding-right: 28px;
  }
  .kz-sec {
    padding-top: clamp(64px, 8vw, 112px);
    padding-bottom: clamp(64px, 8vw, 112px);
  }

  .kz-eyebrow {
    font-family: ui-monospace, Menlo, Consolas, monospace;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--green2);
    margin-bottom: 18px;
  }
  .kz-h2-cam {
    font-weight: 700;
    font-size: clamp(32px, 3.8vw, 48px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  /* Encabezado a dos columnas: el título manda y el párrafo lo acompaña al
     mismo ras de base. */
  .kz-encabe {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 32px 64px;
    align-items: end;
    margin-bottom: 56px;
  }

  /* ── Hero ─────────────────────────────────────────────────────────── */
  .kz-cam-hero {
    background-color: var(--bg);
    background-image:
      linear-gradient(color-mix(in srgb, var(--ink) 4%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--ink) 4%, transparent) 1px, transparent 1px);
    background-size: 56px 56px;
    position: relative;
    overflow: hidden;
  }
  .kz-hero-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 480px), 1fr));
    gap: 64px;
    align-items: center;
    padding-top: 72px;
    padding-bottom: 88px;
  }
  .kz-cam-h1 {
    font-weight: 700;
    font-size: clamp(38px, 5vw, 64px);
    line-height: 1.04;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .kz-cta-verde,
  .kz-cta-borde {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 26px;
    border-radius: 12px;
    font-weight: 600;
    font-size: 16px;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .kz-cta-verde {
    background: var(--green);
    color: #fff;
    box-shadow: 0 10px 30px -10px color-mix(in srgb, var(--green) 70%, transparent);
  }
  .kz-cta-verde:hover {
    background: var(--green2);
    color: #fff;
  }
  .kz-cta-borde {
    border: 1px solid var(--line);
    color: var(--ink);
  }
  .kz-cta-borde:hover {
    background: var(--bg2);
    border-color: var(--green);
  }

  /* Rejilla de números: un solo borde compartido, como la maqueta. */
  .kz-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
  }
  .kz-stat {
    background: var(--bg2);
    padding: 16px 18px;
  }

  /* ── El marco de cámara sobre la foto ─────────────────────────────── */
  .kz-hud {
    position: relative;
    margin: 0;
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: #111;
    border: 1px solid var(--line);
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.55);
  }
  .kz-hud img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .kz-hud-velo {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.35) 0%, transparent 22%, transparent 70%, rgba(0, 0, 0, 0.6) 100%);
    pointer-events: none;
  }
  .kz-esq {
    position: absolute;
    width: 34px;
    height: 34px;
    border-color: rgba(255, 255, 255, 0.85);
    border-style: solid;
    border-width: 0;
  }
  .kz-esq-si { top: 18px; left: 18px; border-top-width: 2px; border-left-width: 2px; }
  .kz-esq-sd { top: 18px; right: 18px; border-top-width: 2px; border-right-width: 2px; }
  .kz-esq-ii { bottom: 18px; left: 18px; border-bottom-width: 2px; border-left-width: 2px; }
  .kz-esq-id { bottom: 18px; right: 18px; border-bottom-width: 2px; border-right-width: 2px; }
  .kz-hud-fila {
    position: absolute;
    left: 64px;
    right: 64px;
    display: flex;
    justify-content: space-between;
    font-family: ui-monospace, Menlo, Consolas, monospace;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: #fff;
  }
  .kz-hud-arriba { top: 30px; }
  .kz-hud-abajo { bottom: 30px; }
  .kz-rec {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #ff4d4d;
    display: inline-block;
    animation: kzparpadeo 1.6s infinite;
  }
  @keyframes kzparpadeo {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.25; }
  }
  @media (prefers-reduced-motion: reduce) {
    .kz-rec { animation: none; }
  }

  /* ── Pilares ──────────────────────────────────────────────────────── */
  .kz-pilares {
    background: var(--bg);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .kz-pilares-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  }
  .kz-pilar {
    padding: 44px 28px;
    border-right: 1px solid var(--line);
  }
  .kz-pilar:first-child { padding-left: 0; }
  .kz-pilar:last-child { padding-right: 0; border-right: 0; }

  /* ── Proceso ──────────────────────────────────────────────────────── */
  .kz-grid-250 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: 16px;
  }
  .kz-paso {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 32px 28px;
  }
  /* El último paso va en verde: es el que contesta "¿y después qué?", que es
     la pregunta con la que la gente llama. */
  .kz-paso-fin {
    background: var(--green-soft);
    border-color: color-mix(in srgb, var(--green) 35%, transparent);
  }
  .kz-paso-n {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
