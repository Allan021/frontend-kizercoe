---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import FloatingWhatsApp from '@/components/FloatingWhatsApp.astro';
import type { Servicio } from '@/lib/servicios';

/**
 * La landing de cámaras de seguridad. Tiene plantilla propia y no la genérica
 * de servicios por una razón de negocio: es la única página del sitio a la que
 * llega gente desde Google buscando un oficio —"instalación de cámaras en El
 * Progreso"— y no desde el sitio buscando software.
 *
 * Esa persona no viene a comparar tecnologías: viene a decidir a quién le deja
 * entrar a su casa con un taladro. Entonces la página está ordenada como una
 * visita: primero cómo trabajamos y el precio por escrito, después el catálogo
 * técnico con sus limitaciones a la vista, y recién al final las fotos, que
 * ahí ya son prueba y no publicidad.
 *
 * Diseño implementado desde la maqueta "Instalación Cámaras v2". Dos traducciones
 * que la maqueta no podía hacer sola:
 *
 *  - Los colores van en tokens (`var(--ink)`, `var(--bg2)`…) y no en los hex de
 *    la maqueta. Pegar los hex habría dejado la única página del sitio que no
 *    responde al modo oscuro.
 *  - La maqueta pide JetBrains Mono para los números y las etiquetas. No vamos
 *    a traer una fuente entera para seis renglones: se usa la pila mono del
 *    sistema, que es la que ya define el design system.
 */
interface Props {
  servicio: Servicio;
  lang: 'es' | 'en';
}
const { servicio: s, lang } = Astro.props;
const es = lang === 'es';

const urlEs = `/servicios/${s.slug}/`;
const urlEn = `/en/services/${s.slugEn}/`;
const propia = es ? urlEs : urlEn;
const otra = es ? urlEn : urlEs;
const cotizar = `/contacto/?servicio=${encodeURIComponent(s.formServicio)}`;
const wa = 'https://wa.me/50488091744';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: es ? s.nombre : s.name,
      description: es ? s.descEs : s.descEn,
      url: new URL(propia, Astro.site).href,
      areaServed: [
        { '@type': 'City', name: 'El Progreso' },
        { '@type': 'City', name: 'San Pedro Sula' },
        { '@type': 'AdministrativeArea', name: 'Yoro, Honduras' },
      ],
      provider: { '@id': 'https://www.kizercode.com/#business' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: s.faq.map((f) => ({
        '@type': 'Question',
        name: es ? f.qEs : f.qEn,
        acceptedAnswer: { '@type': 'Answer', text: es ? f.aEs : f.aEn },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Kizercode', item: 'https://www.kizercode.com/' },
        { '@type': 'ListItem', position: 2, name: es ? 'Servicios' : 'Services', item: new URL(es ? '/servicios/' : '/en/services/', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: es ? s.nombre : s.name, item: new URL(propia, Astro.site).href },
      ],
    },
  ],
};

const pilares = [
  { tEs: 'Se mide antes de cotizar', tEn: 'Measured before quoting', dEs: 'Caminamos el lugar y marcamos los puntos ciegos. La cantidad de cámaras sale del levantamiento, no de un paquete armado por teléfono.', dEn: 'We walk the property and mark the blind spots. The number of cameras comes from the survey, not from a package quoted over the phone.' },
  { tEs: 'Video que identifica', tEn: 'Footage that identifies', dEs: 'Resolución, lente y altura elegidos para reconocer un rostro o una placa — no solo para ver que alguien pasó.', dEn: 'Resolution, lens and height chosen to recognize a face or a plate — not just to see that someone walked by.' },
  { tEs: 'Instalación que aguanta', tEn: 'Installation that lasts', dEs: 'Cable canalizado, cajas selladas contra la lluvia y conectores ponchados. Lo que falla primero nunca es la cámara: es el cable.', dEn: 'Cable in conduit, boxes sealed against rain and crimped connectors. What fails first is never the camera: it is the cable.' },
  { tEs: 'El sistema queda a tu nombre', tEn: 'The system stays yours', dEs: 'Usuarios, contraseñas y acceso al grabador en tus manos, y la app configurada en los celulares que indiqués.', dEn: 'Users, passwords and recorder access in your hands, with the app set up on the phones you choose.' },
];

const proceso = [
  { tEs: 'Visita y levantamiento', tEn: 'Site visit and survey', dEs: 'Vamos al lugar, caminamos el perímetro y marcamos los puntos ciegos. Sale un plano simple con cuántas cámaras, de qué tipo y dónde va cada una. Sin costo y sin compromiso.', dEn: 'We walk the property, check the perimeter and mark the blind spots. The result is a simple plan: how many cameras, which type, and where each one goes. Free and with no commitment.' },
  { tEs: 'Propuesta por escrito', tEn: 'Written proposal', dEs: 'Equipos con marca y modelo, metros de cable, accesorios y mano de obra, con el total. Lo que firmes es lo que pagás. Nada empieza hasta que la aprobás.', dEn: 'Equipment with brand and model, meters of cable, accessories and labor, with the total. What you sign is what you pay. Nothing starts until you approve it.' },
  { tEs: 'Instalación', tEn: 'Installation', dEs: 'Cableado por canaleta o tubería, cajas de conexión selladas, grabador y switch montados en su gabinete, todo etiquetado. Dejamos el lugar limpio.', dEn: 'Cabling in conduit, sealed junction boxes, recorder and switch mounted in their cabinet, everything labeled. We leave the place clean.' },
  { tEs: 'Entrega y capacitación', tEn: 'Handover and training', dEs: 'Probamos cámara por cámara con vos presente, configuramos la app en los celulares que indiqués y te enseñamos a buscar una fecha y exportar un video. Te queda la contraseña del sistema. Es tuyo.', dEn: 'We test camera by camera with you present, set up the app on the phones you choose, and teach you to find a date and export a clip. You keep the system password. It is yours.', destacado: true },
];

const tipos = [
  { n: '01', tEs: 'Bala', tEn: 'Bullet', pEs: 'Cuerpo alargado y vista fija. Cubre distancias largas en una sola dirección y su presencia se nota, que es parte del trabajo.', pEn: 'Long body, fixed view. It covers long distances in one direction, and its presence is noticed — which is part of the job.', dEs: 'Portones, fachadas, pasillos y parqueos.', dEn: 'Gates, façades, corridors and parking lots.' },
  { n: '02', tEs: 'Domo', tEn: 'Dome', pEs: 'Media esfera a ras de techo. Desde abajo no se distingue hacia dónde apunta, y la carcasa resiste golpes.', pEn: 'A half sphere flush with the ceiling. From below you cannot tell where it points, and the housing resists impact.', dEs: 'Caja, mostrador, salón, bodega y pasillos interiores.', dEn: 'Register, counter, dining room, storage and indoor aisles.' },
  { n: '03', tEs: 'PTZ motorizada', tEn: 'Motorized PTZ', pEs: 'Gira, se inclina y acerca por control o por recorrido programado. Una sola cubre un área que exigiría tres cámaras fijas.', pEn: 'Pans, tilts and zooms by control or on a programmed tour. One covers an area that would need three fixed cameras.', dEs: 'Patios, predios, lotes y perímetros amplios.', dEn: 'Yards, lots, plots and wide perimeters.' },
  { n: '04', tEs: 'IP con audio', tEn: 'IP with audio', pEs: 'Trabaja sobre red, con mayor resolución para identificar un rostro o una placa, y trae micrófono y bocina.', pEn: 'Runs over the network, with higher resolution to identify a face or a plate, and includes mic and speaker.', dEs: 'Casa, oficina, negocio pequeño y puntos de atención.', dEn: 'Home, office, small business and service counters.' },
  { n: '05', tEs: 'Panorámica 180° / 360°', tEn: 'Panoramic 180° / 360°', pEs: 'Una lente abre el ambiente completo. Reduce el número de cámaras, de cables y de perforaciones.', pEn: 'One lens opens the whole room. It reduces the number of cameras, cables and drill holes.', dEs: 'Salones, bodegas abiertas y recepciones.', dEn: 'Halls, open warehouses and receptions.' },
  { n: '06', tEs: 'Con reflector y sirena', tEn: 'With floodlight and siren', pEs: 'Detecta a una persona, enciende la luz y emite alarma. Deja de documentar el hecho y pasa a interrumpirlo.', pEn: 'Detects a person, turns on the light and sounds an alarm. It stops documenting the event and starts interrupting it.', dEs: 'Entradas traseras, techos y puntos ciegos nocturnos.', dEn: 'Back entrances, roofs and night blind spots.' },
];

/** La columna de limitaciones es la que hace creíbles a las otras tres. */
const comparativa = [
  { tEs: 'Bala', tEn: 'Bullet', mEs: 'Exteriores y distancias largas', mEn: 'Outdoors and long distances', aEs: '20 a 50 m de noche', aEn: '20 to 50 m at night', lEs: 'No gira: lo que queda fuera del encuadre, no se ve.', lEn: 'It does not move: whatever falls outside the frame is not seen.' },
  { tEs: 'Domo', tEn: 'Dome', mEs: 'Interiores y techos bajos', mEn: 'Indoors and low ceilings', aEs: '10 a 25 m', aEn: '10 to 25 m', lEs: 'Menos alcance. En exterior se ensucia el domo y hay que limpiarlo.', lEn: 'Less reach. Outdoors the dome gets dirty and needs cleaning.' },
  { tEs: 'PTZ', tEn: 'PTZ', mEs: 'Áreas amplias con vigilancia activa', mEn: 'Wide areas with active monitoring', aEs: '50 a 150 m con zoom', aEn: '50 to 150 m with zoom', lEs: 'Si está mirando a un lado, el otro queda sin grabar. Se combina con fijas.', lEn: 'While it looks one way, the other side is not recorded. Pair it with fixed cameras.' },
  { tEs: 'IP con audio', tEn: 'IP with audio', mEs: 'Identificar personas de cerca', mEn: 'Identifying people up close', aEs: '8 a 20 m', aEn: '8 to 20 m', lEs: 'Consume más red y disco. Grabar audio de terceros tiene límites legales.', lEn: 'Uses more network and storage. Recording third-party audio has legal limits.' },
  { tEs: 'Panorámica', tEn: 'Panoramic', mEs: 'Cubrir un ambiente completo', mEn: 'Covering an entire room', aEs: '6 a 15 m útiles', aEn: '6 to 15 m usable', lEs: 'A distancia pierde detalle: sirve para saber qué pasó, no quién fue.', lEn: 'It loses detail at a distance: good for what happened, not for who did it.' },
  { tEs: 'Con reflector', tEn: 'With floodlight', mEs: 'Disuadir de noche', mEn: 'Deterrence at night', aEs: '10 a 30 m', aEn: '10 to 30 m', lEs: 'Mal configurada se dispara con animales y lluvia. Se ajusta en sitio.', lEn: 'Badly tuned it triggers on animals and rain. It gets adjusted on site.' },
];

const equipo = [
  { tEs: 'Grabador DVR o NVR', tEn: 'DVR or NVR recorder', dEs: 'El centro del sistema: almacena, administra los accesos y publica el video hacia tu celular. DVR para cableado coaxial, NVR para cámaras IP sobre red.', dEn: 'The core of the system: it stores, manages access and publishes video to your phone. DVR for coaxial wiring, NVR for IP cameras over the network.' },
  { tEs: 'Disco de vigilancia', tEn: 'Surveillance drive', dEs: 'Diseñado para escribir las 24 horas, a diferencia del disco de una computadora. Su capacidad define cuántos días podés revisar hacia atrás.', dEn: 'Built to write 24 hours a day, unlike a regular computer drive. Its capacity defines how many days you can review.' },
  { tEs: 'Switch PoE', tEn: 'PoE switch', dEs: 'Entrega datos y alimentación por el mismo cable de red: una cámara en el poste del portón no necesita tomacorriente propio.', dEn: 'Delivers data and power over the same network cable: a camera on the gate post needs no outlet of its own.' },
  { tEs: 'Gabinete o rack', tEn: 'Cabinet or rack', dEs: 'Grabador, switch y conexiones montados y etiquetados, bajo llave. Una falla se ubica en minutos y nadie desconecta nada por error.', dEn: 'Recorder, switch and connections mounted, labeled and locked. A fault is located in minutes and nobody unplugs anything by mistake.' },
  { tEs: 'Respaldo de energía', tEn: 'Power backup', dEs: 'Una UPS mantiene grabador y red en línea durante el apagón. Sin ella, el corte de luz es exactamente el intervalo que nadie registra.', dEn: 'A UPS keeps recorder and network online during a blackout. Without it, the outage is exactly the interval nobody records.' },
  { tEs: 'Cableado y canalización', tEn: 'Cabling and conduit', dEs: 'Cable certificado, protegido en canaleta o tubería, con conectores ponchados y prueba de continuidad. Es lo que decide si el sistema aguanta el invierno.', dEn: 'Certified cable, protected in conduit, with crimped connectors and a continuity test. It decides whether the system survives the rainy season.' },
];

const paquetes = [
  { n: '4', tEs: 'Vivienda o local pequeño', tEn: 'Home or small shop', puntosEs: ['Portón y fachada', 'Entrada principal', 'Caja o sala', 'Patio o acceso trasero'], puntosEn: ['Gate and façade', 'Main entrance', 'Register or living room', 'Yard or back access'] },
  { n: '8', tEs: 'Negocio con bodega', tEn: 'Business with storage', puntosEs: ['Todo lo del sistema de 4', 'Bodega y puerta de carga', 'Pasillos de venta', 'Área de personal'], puntosEn: ['Everything in the 4-camera system', 'Storage and loading door', 'Sales aisles', 'Staff area'] },
  { n: '16', tEs: 'Local grande o varias plantas', tEn: 'Large premises or several floors', puntosEs: ['Cobertura por planta', 'Parqueo completo', 'Varias cajas', 'Perímetro con PTZ'], puntosEn: ['Coverage per floor', 'Full parking lot', 'Several registers', 'Perimeter with PTZ'] },
];

const reglas = [
  { r: 'I', tEs: 'La visita no se cobra', tEn: 'The visit is free', dEs: 'Vamos, medimos y te entregamos la propuesta. Si decidís no hacerlo, no debés nada.', dEn: 'We come, measure and hand you the proposal. If you decide not to go ahead, you owe nothing.' },
  { r: 'II', tEs: 'Si se puede reparar, se repara', tEn: 'If it can be repaired, we repair it', dEs: '¿Ya tenés cámaras? Revisamos qué equipo y qué cableado sirve, y cotizamos solo lo que falta.', dEn: 'Already have cameras? We check which equipment and wiring still work, and quote only what is missing.' },
  { r: 'III', tEs: 'Marca y modelo a la vista', tEn: 'Brand and model stated', dEs: 'La propuesta dice exactamente qué equipo se instala. Nada de "cámaras HD" sin apellido.', dEn: 'The proposal states exactly which equipment is installed. No nameless "HD cameras".' },
  { r: 'IV', tEs: 'El sistema queda a tu nombre', tEn: 'The system is yours', dEs: 'Usuarios, contraseñas y acceso al grabador quedan en tus manos. No dependés de nosotros para entrar.', dEn: 'Users, passwords and recorder access stay with you. You do not depend on us to get in.' },
];

const zonas = ['El Progreso', 'San Pedro Sula', 'La Lima', 'Villanueva', 'Santa Rita', 'Morazán', 'Tela', 'Yoro'];
---

<Layout
  title={es ? s.titleEs : s.titleEn}
  description={es ? s.descEs : s.descEn}
  locale={es ? 'es_HN' : 'en_US'}
  forzarLang={lang}
  urlEs={urlEs}
  urlEn={urlEn}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <Nav />
  <main id="contenido">
    <!-- ── 01 · Hero ───────────────────────────────────────────────────── -->
    <section id="portada" class="kz-cam-hero">
      <div class="kz-wrap kz-hero-grid">
        <div>
          <nav aria-label="breadcrumb" class="mb-7 text-[13px] font-medium" style="color: var(--mute)">
            <a href="/" class="transition-colors hover:text-[var(--green2)]" style="color: var(--mute)">Kizercode</a>
            <span aria-hidden="true"> / </span>
            <a href={es ? '/servicios/' : '/en/services/'} class="transition-colors hover:text-[var(--green2)]" style="color: var(--mute)">{es ? 'Servicios' : 'Services'}</a>
            <span aria-hidden="true"> / </span>
            <span style="color: var(--green2)">{es ? s.nombre : s.name}</span>
          </nav>

          <h1 class="kz-cam-h1">{es ? s.h1Es : s.h1En}</h1>

          <p class="mt-7 max-w-[580px] text-[19px] leading-relaxed" style="color: var(--ink2); text-wrap: pretty">
            {es
              ? 'Un negocio sin cámaras depende de la buena fe de todos: del cliente, del empleado y del que pasa por la calle. Con cámaras bien puestas ves tu local en vivo desde el celular y, si algo pasa, tenés el video.'
              : 'A business without cameras depends on everyone’s good faith: the customer, the employee and whoever walks by. With cameras placed properly you watch your place live from your phone and, if something happens, you have the footage.'}
          </p>
          <p class="mt-4 max-w-[580px] text-[16px] leading-relaxed" style="color: var(--ink2); text-wrap: pretty">
            {es ? s.subEs : s.subEn}
          </p>

          <div class="mt-9 flex flex-wrap gap-3">
            <a href={cotizar} class="kz-cta-verde">{es ? 'Cotización gratis' : 'Free quote'}</a>
            <a href={wa} target="_blank" rel="noopener noreferrer" class="kz-cta-borde">
              <img src="/whatsapp.svg" alt="" width="18" height="18" class="block" />
              WhatsApp
            </a>
          </div>

          <div class="kz-stats mt-12">
            {(s.stats ?? []).map((st) => (
              <div class="kz-stat">
                <div class="text-[15px] font-semibold">{es ? st.n : (st.nEn ?? st.n)}</div>
                <div class="mt-0.5 text-[13px]" style="color: var(--ink2)">{es ? st.es : st.en}</div>
              </div>
            ))}
          </div>
        </div>

        <!-- La foto con marco de cámara: lo que mira el visitante antes de leer
             nada. El HUD no es decoración — dice dónde fue y qué es. -->
        <figure class="kz-hud">
          <img
            src="/camaras/instalacion-el-progreso-1.jpg"
            alt={es
              ? 'Técnico de Kizercode montando una cámara bala en el poste de un portón en El Progreso, Yoro'
              : 'Kizercode technician mounting a bullet camera on a gate post in El Progreso, Yoro'}
            width="1200"
            height="1600"
            fetchpriority="high"
            decoding="async"
          />
          <div class="kz-hud-velo" aria-hidden="true"></div>
          <span class="kz-esq kz-esq-si" aria-hidden="true"></span>
          <span class="kz-esq kz-esq-sd" aria-hidden="true"></span>
          <span class="kz-esq kz-esq-ii" aria-hidden="true"></span>
          <span class="kz-esq kz-esq-id" aria-hidden="true"></span>
          <div class="kz-hud-fila kz-hud-arriba" aria-hidden="true">
            <span class="flex items-center gap-2"><span class="kz-rec"></span>REC</span>
            <span>{es ? 'CAM 01 · PORTÓN' : 'CAM 01 · GATE'}</span>
          </div>
          <div class="kz-hud-fila kz-hud-abajo" aria-hidden="true">
            <span id="kz-reloj">--:--:--</span>
            <span>EL PROGRESO, YORO</span>
          </div>
        </figure>
      </div>
    </section>

    <!-- ── 02 · Pilares ────────────────────────────────────────────────── -->
    <section id="pilares" class="kz-pilares">
      <div class="kz-wrap kz-pilares-grid">
        {pilares.map((p, i) => (
          <div class="kz-pilar">
            <div class="kz-mono text-[12px]" style="color: var(--green)">{String(i + 1).padStart(2, '0')}</div>
            <h3 class="mt-3.5 text-[18px] font-semibold">{es ? p.tEs : p.tEn}</h3>
            <p class="mt-2.5 text-[15px] leading-relaxed" style="color: var(--ink2)">{es ? p.dEs : p.dEn}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ── 03 · Proceso ────────────────────────────────────────────────── -->
    <section id="proceso" style="background: var(--bg2)">
      <div class="kz-wrap kz-sec">
        <div class="kz-encabe">
          <div>
            <div class="kz-eyebrow">{es ? 'Cómo trabajamos' : 'How we work'}</div>
            <h2 class="kz-h2-cam">{es ? 'Cuatro pasos, y el precio antes del taladro' : 'Four steps, and the price before the drill'}</h2>
          </div>
          <p class="text-[18px] leading-relaxed" style="color: var(--ink2); text-wrap: pretty">
            {es
              ? 'Ninguna instalación empieza con una cotización por teléfono. Empieza con alguien parado en tu portón viendo por dónde entra la gente.'
              : 'No installation starts with a quote over the phone. It starts with someone standing at your gate, seeing where people come in.'}
          </p>
        </div>

        <div class="kz-grid-250">
          {proceso.map((p, i) => (
            <div class={p.destacado ? 'kz-paso kz-paso-fin' : 'kz-paso'}>
              <div class="mb-7 flex items-center gap-3">
                <span class="kz-paso-n">{i + 1}</span>
                <span class="h-px flex-1" style="background: var(--line)"></span>
              </div>
              <h3 class="text-[19px] font-semibold">{es ? p.tEs : p.tEn}</h3>
              <p class="mt-3 text-[15px] leading-relaxed" style="color: var(--ink2)">{es ? p.dEs : p.dEn}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── 04 · Catálogo ───────────────────────────────────────────────── -->
    <section id="catalogo" style="background: var(--bg)">
      <div class="kz-wrap kz-sec">
        <div class="max-w-[760px]">
          <div class="kz-eyebrow">{es ? 'Catálogo técnico' : 'Technical catalog'}</div>
          <h2 class="kz-h2-cam">{es ? 'Cada cámara resuelve un problema distinto' : 'Each camera solves a different problem'}</h2>
          <p class="mt-5 text-[18px] leading-relaxed" style="color: var(--ink2); text-wrap: pretty">
            {es
              ? 'La cámara equivocada en el lugar equivocado explica casi todos los casos de "tengo cámaras, pero no se reconoce a nadie". Esto es lo que instalamos y para qué sirve cada tipo.'
              : 'The wrong camera in the wrong place explains nearly every case of "I have cameras, but nobody is recognizable". This is what we install and what each type is for.'}
          </p>
        </div>

        <div class="kz-malla mt-14">
          {tipos.map((t) => (
            <article class="kz-celda">
              <div class="flex items-baseline justify-between gap-4">
                <h3 class="text-[21px] font-semibold">{es ? t.tEs : t.tEn}</h3>
                <span class="kz-mono text-[12px]" style="color: var(--mute)">{t.n}</span>
              </div>
              <p class="mt-3.5 flex-1 text-[15px] leading-relaxed" style="color: var(--ink2)">{es ? t.pEs : t.pEn}</p>
              <div class="mt-4 border-t border-dashed pt-3.5" style="border-color: var(--line)">
                <div class="kz-mono text-[11px] uppercase" style="letter-spacing: .1em; color: var(--green2)">
                  {es ? 'Dónde se instala' : 'Where it goes'}
                </div>
                <div class="mt-1.5 text-[14px] font-medium">{es ? t.dEs : t.dEn}</div>
              </div>
            </article>
          ))}
        </div>

        <h3 class="mt-[88px] text-[24px] font-semibold" style="letter-spacing: -.01em">
          {es ? 'Comparación, con las limitaciones incluidas' : 'Comparison, limitations included'}
        </h3>
        <div class="kz-tabla mt-6">
          <table>
            <thead>
              <tr>
                <th>{es ? 'Tipo' : 'Type'}</th>
                <th>{es ? 'Mejor para' : 'Best for'}</th>
                <th>{es ? 'Alcance útil' : 'Usable range'}</th>
                <th>{es ? 'Lo que no hace' : 'What it does not do'}</th>
              </tr>
            </thead>
            <tbody>
              {comparativa.map((c) => (
                <tr>
                  <td class="font-semibold whitespace-nowrap">{es ? c.tEs : c.tEn}</td>
                  <td>{es ? c.mEs : c.mEn}</td>
                  <td class="kz-mono whitespace-nowrap text-[13px]" style="color: var(--green2)">{es ? c.aEs : c.aEn}</td>
                  <td style="color: var(--ink2)">{es ? c.lEs : c.lEn}</td>
                </tr>
