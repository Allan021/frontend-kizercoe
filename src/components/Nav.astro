---
/**
 * Header del rediseño: barra superior navy (estado, horario, contacto, ES/EN),
 * nav sticky con franja degradada navy→verde y menú "Servicios" desplegable
 * en 4 grupos. El logo cambia con el tema vía CSS ([data-logo-*]).
 */
const WA = 'https://wa.me/50488091744?text=Hola!%20Quiero%20cotizar%20con%20Kizercode.';

const grupos = [
  {
    g_en: 'Development', g_es: 'Desarrollo',
    items: [
      { href: '#precios', t_en: 'Websites', t_es: 'Páginas web', d_en: 'Own design, fast, with WhatsApp', d_es: 'Diseño propio, rápidas, con WhatsApp' },
      { href: '#precios', t_en: 'Online stores', t_es: 'Tiendas en línea', d_en: 'Catalog, cart and payments', d_es: 'Catálogo, carrito y pagos' },
      { href: '#precios', t_en: 'Mobile apps', t_es: 'Apps móviles', d_en: 'iOS and Android, one codebase', d_es: 'iOS y Android, una base' },
    ],
  },
  {
    g_en: 'AI and software', g_es: 'IA y software',
    items: [
      { href: '#servicios', t_en: 'Custom systems', t_es: 'Sistemas a la medida', d_en: 'Inventory, billing, orders', d_es: 'Inventario, facturación, pedidos' },
      { href: '#servicios', t_en: 'AI automation', t_es: 'Automatización con IA', d_en: 'Answers and quotes 24/7', d_es: 'Atiende y cotiza 24/7' },
      { href: '#productos', t_en: 'Ready-to-use software', t_es: 'Software listo para usar', d_en: 'KizerPOS, Resto, Cobros, Check', d_es: 'KizerPOS, Resto, Cobros, Check' },
    ],
  },
  {
    g_en: 'Marketing', g_es: 'Marketing',
    items: [
      { href: '#servicios', t_en: 'Ads and acquisition', t_es: 'Anuncios y captación', d_en: 'Google and Meta, weekly report', d_es: 'Google y Meta con reporte semanal' },
      { href: '#servicios', t_en: 'SEO', t_es: 'Posicionamiento (SEO)', d_en: 'Show up when they search', d_es: 'Aparecer cuando te buscan' },
      { href: '#servicios', t_en: 'Visual identity', t_es: 'Identidad visual', d_en: 'Logo, colors and pieces', d_es: 'Logo, colores y piezas' },
    ],
  },
  {
    g_en: 'Repair shop', g_es: 'Taller',
    items: [
      { href: '#taller', t_en: 'Computer repair', t_es: 'Reparación de computadoras', d_en: 'Free diagnosis', d_es: 'Diagnóstico gratis' },
      { href: '#taller', t_en: 'Phone repair', t_es: 'Reparación de teléfonos', d_en: 'Screens, batteries, ports', d_es: 'Pantallas, baterías, puertos' },
      { href: '#taller', t_en: 'Buy and sell devices', t_es: 'Compra y venta de equipo', d_en: 'Tested and working', d_es: 'Probado y funcionando' },
    ],
  },
];

const enlaces = [
  { href: '#casos', en: 'Cases', es: 'Casos' },
  { href: '#resenas', en: 'Reviews', es: 'Reseñas' },
  { href: '#productos', en: 'Products', es: 'Productos' },
  { href: '#precios', en: 'Pricing', es: 'Precios' },
  { href: '#faq', en: 'FAQ', es: 'Preguntas' },
];
---

<!-- Barra superior -->
<div style="background: var(--navy); color: var(--bg)">
  <div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-4 px-6 py-2 text-xs font-medium">
    <div class="flex flex-wrap items-center gap-4">
      <span class="inline-flex items-center gap-2">
        <span class="kz-latido" style="background: var(--green-bright)"></span>
        <span class="en">Accepting new projects</span><span class="es">Aceptando nuevos proyectos</span>
      </span>
      <span class="hidden sm:inline" style="color: color-mix(in srgb, var(--bg) 70%, transparent)">
        <span class="en">Mon–Sat · Reply in under 24 h</span><span class="es">Lun–Sáb · Respuesta en menos de 24 h</span>
      </span>
    </div>
    <div class="flex flex-wrap items-center gap-4">
      <a href="tel:+50488091744" class="kz-toplink hidden sm:inline">+504 8809-1744</a>
      <a href="mailto:hello@kizercode.com" class="kz-toplink hidden md:inline">hello@kizercode.com</a>
      <button
        id="lang-toggle"
        aria-label="Cambiar idioma / Toggle language"
        class="inline-flex cursor-pointer items-center rounded-full border p-0.5 text-[11px] font-semibold"
        style="border-color: color-mix(in srgb, var(--bg) 25%, transparent); background: transparent; color: inherit"
      >
        <span class="es rounded-full px-2.5 py-0.5" style="background: var(--bg); color: var(--navy)">ES</span>
        <span class="es px-2.5 py-0.5" style="color: color-mix(in srgb, var(--bg) 70%, transparent)">EN</span>
        <span class="en px-2.5 py-0.5" style="color: color-mix(in srgb, var(--bg) 70%, transparent)">ES</span>
        <span class="en rounded-full px-2.5 py-0.5" style="background: var(--bg); color: var(--navy)">EN</span>
      </button>
    </div>
  </div>
</div>

<!-- Nav sticky -->
<header
  id="main-nav"
  class="sticky top-0 z-40 border-b backdrop-blur-xl"
  style="background: var(--color-nav-bg); border-color: var(--line); box-shadow: 0 1px 0 color-mix(in srgb, var(--green) 25%, transparent), 0 10px 30px -20px rgba(11,26,51,.25)"
>
  <div class="h-[3px]" style="background: linear-gradient(90deg, var(--navy) 0%, var(--green) 55%, var(--green-bright) 100%)"></div>
  <div class="mx-auto flex max-w-[1200px] items-center justify-between gap-5 px-6 py-3">
    <a href="#top" aria-label="Kizercode — inicio" class="flex shrink-0 items-center">
      <img data-logo-light="1" src="/kizercode-logo.png" alt="Kizercode" width="126" height="42" class="block h-[42px] w-[126px] object-contain" />
      <img data-logo-dark="1" src="/kizercode-logo-dark.png" alt="Kizercode" width="126" height="42" class="h-[42px] w-[126px] object-contain" />
    </a>

    <nav class="hidden items-center justify-center gap-1 text-sm font-medium lg:flex" aria-label="Principal">
      <button id="menu-servicios-btn" class="kz-navlink inline-flex cursor-pointer items-center gap-1.5 border-0 bg-transparent" aria-expanded="false" aria-controls="menu-servicios">
        <span class="en">Services</span><span class="es">Servicios</span>
        <span class="text-[10px]" aria-hidden="true">▾</span>
      </button>
      {enlaces.map((l) => (
        <a href={l.href} class="kz-navlink"><span class="en">{l.en}</span><span class="es">{l.es}</span></a>
      ))}
    </nav>

    <div class="flex items-center gap-2.5">
      <button id="menu-movil-btn" class="kz-btn-secundario inline-flex cursor-pointer items-center gap-2 rounded-[10px] px-3.5 py-2 text-sm lg:hidden" aria-expanded="false" aria-controls="menu-servicios">
        <span class="en">Menu</span><span class="es">Menú</span>
        <span class="text-[10px]" aria-hidden="true">▾</span>
      </button>
      <button
        id="theme-toggle"
        aria-label="Cambiar tema"
        class="inline-flex h-[38px] w-[38px] shrink-0 cursor-pointer items-center justify-center rounded-full border transition-colors hover:border-[var(--green)]"
        style="border-color: var(--line); background: transparent; color: var(--ink2)"
      >
        <svg id="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
        <svg id="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="hidden"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      </button>
      <a href="#contacto" class="kz-btn-secundario hidden items-center rounded-[10px] px-4 py-2 text-sm font-semibold sm:inline-flex" style="border-width: 1.5px">
        <span class="en">Get a quote</span><span class="es">Cotizar</span>
      </a>
      <a href={WA} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-[10px] px-4 py-2.5 text-sm font-semibold text-white transition-colors" style="background: var(--green)" onmouseover="this.style.background='var(--green2)'" onmouseout="this.style.background='var(--green)'">
        <img src="/whatsapp.svg" alt="" width="18" height="18" class="block brightness-0 invert" />
        <span class="en">Let's talk</span><span class="es">Hablemos</span>
      </a>
    </div>
  </div>

  <!-- Menú desplegable de servicios -->
  <div id="menu-servicios" hidden class="border-t" style="border-color: var(--line); background: var(--bg); box-shadow: 0 20px 40px rgba(11,26,51,.10)">
    <div class="mx-auto grid max-w-[1200px] gap-6 px-6 pb-7 pt-6" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr))">
      <!-- Enlaces principales, solo en móvil (el nav de arriba está oculto) -->
      <div class="col-[1/-1] flex flex-wrap gap-2 lg:hidden">
        {enlaces.map((l) => (
          <a href={l.href} class="kz-menupill"><span class="en">{l.en}</span><span class="es">{l.es}</span></a>
        ))}
        <a href="#taller" class="kz-menupill"><span class="en">Repair shop</span><span class="es">Taller</span></a>
        <a href="#contacto" class="kz-menupill" style="border-color: var(--green); color: var(--green2)"><span class="en">Get a quote</span><span class="es">Cotizar</span></a>
      </div>

      {grupos.map((g) => (
        <div class="flex flex-col gap-1.5">
          <span class="px-2.5 pb-1.5 text-[11px] font-semibold uppercase tracking-[0.08em]" style="color: var(--green2)">
            <span class="en">{g.g_en}</span><span class="es">{g.g_es}</span>
          </span>
          {g.items.map((it) => (
            <a href={it.href} class="kz-menuitem">
              <span class="text-sm font-semibold"><span class="en">{it.t_en}</span><span class="es">{it.t_es}</span></span>
              <span class="text-xs" style="color: var(--mute)"><span class="en">{it.d_en}</span><span class="es">{it.d_es}</span></span>
            </a>
          ))}
        </div>
      ))}

      <div class="flex flex-col gap-2.5 rounded-[14px] p-5" style="background: var(--navy); color: var(--bg)">
        <span class="text-[11px] font-semibold uppercase tracking-[0.08em]" style="color: var(--green-bright)">
          <span class="en">Not sure what you need?</span><span class="es">¿No sabés qué necesitás?</span>
        </span>
        <strong class="text-base font-semibold leading-snug">
          <span class="en">Free 30-minute diagnosis call.</span><span class="es">Llamada de diagnóstico gratis, 30 minutos.</span>
        </strong>
        <span class="text-[13px]" style="color: color-mix(in srgb, var(--bg) 70%, transparent)">
          <span class="en">We tell you what suits you and what it costs, in writing.</span>
          <span class="es">Te decimos qué te conviene y cuánto cuesta, por escrito.</span>
        </span>
        <a href="#contacto" class="mt-auto self-start rounded-[9px] px-4 py-2.5 text-[13px] font-semibold text-white transition-colors" style="background: #16a36c" onmouseover="this.style.background='#3ed39a'; this.style.color='#0b1a33'" onmouseout="this.style.background='#16a36c'; this.style.color='#fff'">
          <span class="en">Book the call</span><span class="es">Agendar llamada</span>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .kz-toplink { color: var(--bg); transition: color 0.2s ease; }
  .kz-toplink:hover { color: var(--green-bright); }

  .kz-navlink {
    color: var(--ink2);
    padding: 9px 12px;
    border-radius: 9px;
    font-size: 14px;
    font-weight: 500;
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  .kz-navlink:hover { color: var(--green2); background: var(--bg2); }

  .kz-menupill {
    border: 1px solid var(--line);
    color: var(--ink);
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .kz-menupill:hover { border-color: var(--green); color: var(--green2); }

  .kz-menuitem {
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 9px 10px;
    border-radius: 10px;
    color: var(--ink);
    transition: background-color 0.2s ease;
  }
  .kz-menuitem:hover { background: var(--bg2); }
</style>

<script>
  // ── Menú de servicios: abre por hover (desktop) o clic; cierra al salir
  //    del header, al hacer clic en un enlace o con Escape. ──
  const menu = document.getElementById('menu-servicios')!;
  const btnServicios = document.getElementById('menu-servicios-btn');
  const btnMovil = document.getElementById('menu-movil-btn');
  const header = document.getElementById('main-nav')!;

  function ponerMenu(abierto: boolean) {
    menu.hidden = !abierto;
    btnServicios?.setAttribute('aria-expanded', String(abierto));
    btnMovil?.setAttribute('aria-expanded', String(abierto));
  }
  btnServicios?.addEventListener('click', () => ponerMenu(menu.hidden));
  btnServicios?.addEventListener('mouseenter', () => ponerMenu(true));
  btnMovil?.addEventListener('click', () => ponerMenu(menu.hidden));
  header.addEventListener('mouseleave', () => ponerMenu(false));
  menu.addEventListener('click', (e) => {
    if (e.target instanceof Element && e.target.closest('a')) ponerMenu(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') ponerMenu(false);
  });

  // ── Tema ──
  function pintarTema(t: string) {
    document.getElementById('icon-moon')?.classList.toggle('hidden', t === 'dark');
    document.getElementById('icon-sun')?.classList.toggle('hidden', t !== 'dark');
  }
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const actual = document.documentElement.getAttribute('data-theme') || 'light';
    const siguiente = actual === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', siguiente);
    localStorage.setItem('kz-theme', siguiente);
    pintarTema(siguiente);
  });
  pintarTema(document.documentElement.getAttribute('data-theme') || 'light');

  // ── Idioma (la moneda acompaña, salvo elección explícita del toggle) ──
  document.getElementById('lang-toggle')?.addEventListener('click', () => {
    const actual = document.documentElement.getAttribute('lang') || 'es';
    const siguiente = actual === 'es' ? 'en' : 'es';
    document.documentElement.setAttribute('lang', siguiente);
    localStorage.setItem('kz-lang', siguiente);
    if (!localStorage.getItem('kz-moneda')) {
      document.documentElement.setAttribute('data-moneda', siguiente === 'es' ? 'lps' : 'usd');
    }
  });
</script>
