---
/**
 * Header del rediseño: barra superior navy (estado, horario, contacto, ES/EN),
 * nav sticky con franja degradada navy→verde y menú "Servicios" desplegable
 * en 4 grupos. El logo cambia con el tema vía CSS ([data-logo-*]).
 */
const WA = 'https://wa.me/50488091744?text=Hola!%20Quiero%20cotizar%20con%20Kizercode.';

// Cada servicio enlaza a su página dedicada: eso teje el SEO interno.
const grupos = [
  {
    g_en: 'Development', g_es: 'Desarrollo',
    items: [
      { href: '/servicios/paginas-web/', t_en: 'Websites', t_es: 'Páginas web', d_en: 'Own design, fast, with WhatsApp', d_es: 'Diseño propio, rápidas, con WhatsApp' },
      { href: '/servicios/modernizacion-web/', t_en: 'Website redesign', t_es: 'Modernizar tu sitio', d_en: "Today's design, keep your content", d_es: 'Diseño de hoy, tu contenido se queda' },
      { href: '/servicios/tiendas-en-linea/', t_en: 'E-commerce', t_es: 'Tiendas en línea', d_en: 'Catalog, cart and payments', d_es: 'Catálogo, carrito y pagos' },
      { href: '/servicios/apps-moviles/', t_en: 'Mobile apps', t_es: 'Apps móviles', d_en: 'iOS and Android, one codebase', d_es: 'iOS y Android, una base' },
    ],
  },
  {
    g_en: 'AI and software', g_es: 'IA y software',
    items: [
      { href: '/servicios/sistemas-a-la-medida/', t_en: 'Custom systems', t_es: 'Sistemas a la medida', d_en: 'Inventory, billing, orders', d_es: 'Inventario, facturación, pedidos' },
      { href: '/servicios/automatizacion-ia/', t_en: 'AI automation', t_es: 'Automatización con IA', d_en: 'Answers and quotes 24/7', d_es: 'Atiende y cotiza 24/7' },
      { href: '/servicios/crm-a-la-medida/', t_en: 'Custom CRM', t_es: 'CRM a la medida', d_en: 'Customers and follow-ups', d_es: 'Clientes y seguimientos' },
      { href: '/productos/', t_en: 'Ready-to-use software', t_es: 'Software listo para usar', d_en: 'KizerPOS, Resto, Cobros, Check, ClínicoSalud', d_es: 'KizerPOS, Resto, Cobros, Check, ClínicoSalud' },
    ],
  },
  {
    g_en: 'Design', g_es: 'Diseño',
    items: [
      { href: '/servicios/diseno-ux-ui/', t_en: 'UX/UI design', t_es: 'Diseño UX/UI', d_en: 'Prototypes before code', d_es: 'Prototipos antes del código' },
      { href: '/servicios/identidad-visual/', t_en: 'Branding', t_es: 'Identidad visual', d_en: 'Logo, colors and pieces', d_es: 'Logo, colores y piezas' },
    ],
  },
  {
    g_en: 'Repair shop', g_es: 'Taller',
    items: [
      { href: '/servicios/reparacion-computadoras/', t_en: 'Computer repair', t_es: 'Reparación de computadoras', d_en: 'Free diagnosis, SSD, formatting', d_es: 'Diagnóstico gratis, SSD, formateo' },
      { href: '/servicios/reparacion-telefonos/', t_en: 'Phone repair', t_es: 'Reparación de celulares', d_en: 'Screens, batteries, ports', d_es: 'Pantallas, baterías, puertos' },
      { href: '/servicios/instalacion-camaras/', t_en: 'Security cameras', t_es: 'Cámaras de seguridad', d_en: 'Installed and on your phone', d_es: 'Instaladas y en tu celular' },
      { href: '/#taller', t_en: 'Buy and sell devices', t_es: 'Compra y venta de equipo', d_en: 'Tested and working', d_es: 'Probado y funcionando' },
    ],
  },
];

// Industrias del desplegable, agrupadas como en el mapa del negocio.
const gruposIndustrias = [
  {
    g_en: 'Retail and distribution', g_es: 'Comercio',
    items: [
      { href: '/industrias/farmacias/', t_en: 'Pharmacies', t_es: 'Farmacias', d_en: 'Batches and expiry with KizerPOS', d_es: 'Lotes y vencimientos con KizerPOS' },
      { href: '/industrias/ferreterias/', t_en: 'Hardware stores', t_es: 'Ferreterías', d_en: 'Units, measures and credit', d_es: 'Unidades, medidas y crédito' },
      { href: '/industrias/boutiques/', t_en: 'Boutiques', t_es: 'Boutiques y tiendas', d_en: 'Sizes, colors, online store', d_es: 'Tallas, colores y tienda en línea' },
      { href: '/industrias/distribuidoras/', t_en: 'Distributors', t_es: 'Distribuidoras', d_en: 'Field orders and warehouse', d_es: 'Pedidos en ruta y bodega' },
    ],
  },
  {
    g_en: 'Food and service', g_es: 'Comida y servicio',
    items: [
      { href: '/industrias/restaurantes/', t_en: 'Restaurants', t_es: 'Restaurantes', d_en: 'Tables and kitchen with KizerResto', d_es: 'Mesas y cocina con KizerResto' },
      { href: '/industrias/clinicas/', t_en: 'Clinics and healthcare', t_es: 'Clínicas y salud', d_en: 'Records and booking with ClínicoSalud', d_es: 'Expediente y citas con ClínicoSalud' },
      { href: '/industrias/talleres/', t_en: 'Auto shops', t_es: 'Talleres', d_en: 'Work orders and parts', d_es: 'Órdenes de trabajo y repuestos' },
    ],
  },
  {
    g_en: 'Professional', g_es: 'Profesional',
    items: [
      { href: '/industrias/prestamistas/', t_en: 'Lenders', t_es: 'Prestamistas', d_en: 'Portfolio with Kizer Cobros', d_es: 'Cartera con Kizer Cobros' },
      { href: '/industrias/bienes-raices/', t_en: 'Real estate', t_es: 'Bienes raíces', d_en: 'Portals like aabienes.com', d_es: 'Portales como aabienes.com' },
      { href: '/industrias/abogados/', t_en: 'Law firms', t_es: 'Abogados', d_en: 'Case files and deadlines', d_es: 'Expedientes y plazos' },
    ],
  },
];

// Anchors absolutos: funcionan desde la portada y desde cualquier página.
const gruposNosotros = [
  {
    g_en: 'The company', g_es: 'La empresa',
    items: [
      { href: '/nosotros/', t_en: 'History', t_es: 'Historia', d_en: 'From the bank to your business', d_es: 'Del banco a tu negocio' },
      { href: '/nosotros/#equipo', t_en: 'Founder and team', t_es: 'Fundador y equipo', d_en: 'Who designs and codes your project', d_es: 'Quién diseña y programa tu proyecto' },
      { href: '/nosotros/#paises', t_en: 'Countries we serve', t_es: 'Países donde trabajamos', d_en: 'Honduras, US, Colombia and remote', d_es: 'Honduras, EE. UU., Colombia y a distancia' },
    ],
  },
  {
    g_en: 'Our work', g_es: 'Nuestro trabajo',
    items: [
      { href: '/proyectos/', t_en: 'Projects', t_es: 'Proyectos', d_en: 'Live work you can open', d_es: 'Trabajo en línea que podés abrir' },
      { href: '/productos/', t_en: 'Products', t_es: 'Productos', d_en: 'Our own ready-to-use software', d_es: 'Software propio listo para usar' },
      { href: '/trabaja-con-nosotros/', t_en: 'Careers', t_es: 'Trabajá con nosotros', d_en: 'Send us your portfolio', d_es: 'Mandanos tu portafolio' },
    ],
  },
];

// Anchors absolutos: funcionan desde la portada y desde cualquier página.
const enlaces = [
  { href: '/productos/', en: 'Products', es: 'Productos' },
  { href: '/precios/', en: 'Pricing', es: 'Precios' },
  { href: '/#faq', en: 'FAQ', es: 'Preguntas' },
];
---

<!-- Barra superior -->
<div style="background: var(--navy); color: var(--bg)">
  <div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-4 px-6 py-2 text-xs font-medium">
    <div class="flex flex-wrap items-center gap-4">
      <span class="inline-flex items-center gap-2">
        <span class="kz-latido" style="background: var(--green-bright)"></span>
        <span class="en">Accepting new projects</span><span class="es">Aceptando nuevos proyectos</span>
      </span>
      <span class="hidden sm:inline" style="color: color-mix(in srgb, var(--bg) 70%, transparent)">
        <span class="en">Mon–Sat · Reply in under 24 h</span><span class="es">Lun–Sáb · Respuesta en menos de 24 h</span>
      </span>
    </div>
    <div class="flex flex-wrap items-center gap-4">
      <a href="tel:+50488091744" class="kz-toplink hidden sm:inline">+504 8809-1744</a>
      <a href="mailto:hello@kizercode.com" class="kz-toplink hidden md:inline">hello@kizercode.com</a>
      <button
        id="lang-toggle"
        aria-label="Cambiar idioma / Toggle language"
        class="inline-flex cursor-pointer items-center rounded-full border p-0.5 text-[11px] font-semibold"
        style="border-color: color-mix(in srgb, var(--bg) 25%, transparent); background: transparent; color: inherit"
      >
        <span class="es rounded-full px-2.5 py-0.5" style="background: var(--bg); color: var(--navy)">ES</span>
        <span class="es px-2.5 py-0.5" style="color: color-mix(in srgb, var(--bg) 70%, transparent)">EN</span>
        <span class="en px-2.5 py-0.5" style="color: color-mix(in srgb, var(--bg) 70%, transparent)">ES</span>
        <span class="en rounded-full px-2.5 py-0.5" style="background: var(--bg); color: var(--navy)">EN</span>
      </button>
    </div>
  </div>
</div>

<!-- Nav sticky -->
<header
  id="main-nav"
  class="sticky top-0 z-40 border-b backdrop-blur-xl"
  style="background: var(--color-nav-bg); border-color: var(--line); box-shadow: 0 1px 0 color-mix(in srgb, var(--green) 25%, transparent), 0 10px 30px -20px rgba(11,26,51,.25)"
>
  <div class="h-[3px]" style="background: linear-gradient(90deg, var(--navy) 0%, var(--green) 55%, var(--green-bright) 100%)"></div>
  <div class="mx-auto flex max-w-[1200px] items-center justify-between gap-5 px-6 py-3">
    <a href="/" aria-label="Kizercode — inicio" class="flex shrink-0 items-center">
      <img data-logo-light="1" src="/kizercode-logo.png" alt="Kizercode" width="126" height="42" class="block h-[42px] w-[126px] object-contain" />
      <img data-logo-dark="1" src="/kizercode-logo-dark.png" alt="Kizercode" width="126" height="42" class="h-[42px] w-[126px] object-contain" />
    </a>

    <nav class="hidden items-center justify-center gap-1 text-sm font-medium lg:flex" aria-label="Principal">
      <button id="menu-servicios-btn" data-menu-btn="menu-servicios" class="kz-navlink inline-flex cursor-pointer items-center gap-1.5 border-0 bg-transparent" aria-expanded="false" aria-controls="menu-servicios">
        <span class="en">Services</span><span class="es">Servicios</span>
        <span class="text-[10px]" aria-hidden="true">▾</span>
      </button>
      <button data-menu-btn="menu-industrias" class="kz-navlink inline-flex cursor-pointer items-center gap-1.5 border-0 bg-transparent" aria-expanded="false" aria-controls="menu-industrias">
        <span class="en">Industries</span><span class="es">Industrias</span>
        <span class="text-[10px]" aria-hidden="true">▾</span>
      </button>
      <button data-menu-btn="menu-nosotros" class="kz-navlink inline-flex cursor-pointer items-center gap-1.5 border-0 bg-transparent" aria-expanded="false" aria-controls="menu-nosotros">
        <span class="en">About us</span><span class="es">Nosotros</span>
        <span class="text-[10px]" aria-hidden="true">▾</span>
      </button>
      {enlaces.map((l) => (
        <a href={l.href} class="kz-navlink"><span class="en">{l.en}</span><span class="es">{l.es}</span></a>
      ))}
    </nav>

    <div class="flex items-center gap-2.5">
      <button id="menu-movil-btn" class="kz-btn-secundario inline-flex cursor-pointer items-center gap-2 rounded-[10px] px-3.5 py-2 text-sm lg:hidden" aria-expanded="false" aria-controls="menu-servicios">
        <span class="en">Menu</span><span class="es">Menú</span>
        <span class="text-[10px]" aria-hidden="true">▾</span>
      </button>
      <button
        id="theme-toggle"
        aria-label="Cambiar tema"
        class="inline-flex h-[38px] w-[38px] shrink-0 cursor-pointer items-center justify-center rounded-full border transition-colors hover:border-[var(--green)]"
        style="border-color: var(--line); background: transparent; color: var(--ink2)"
      >
        <svg id="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
        <svg id="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="hidden"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      </button>
      <a href="/contacto/" class="kz-btn-secundario hidden items-center rounded-[10px] px-4 py-2 text-sm font-semibold sm:inline-flex" style="border-width: 1.5px">
        <span class="en">Get a quote</span><span class="es">Cotizar</span>
      </a>
      <a href={WA} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-[10px] px-4 py-2.5 text-sm font-semibold text-white transition-colors" style="background: var(--green)" onmouseover="this.style.background='var(--green2)'" onmouseout="this.style.background='var(--green)'">
        <img src="/whatsapp.svg" alt="" width="18" height="18" class="block brightness-0 invert" />
        <span class="en">Let's talk</span><span class="es">Hablemos</span>
      </a>
    </div>
  </div>

  <!-- Menú desplegable de servicios -->
  <div id="menu-servicios" hidden class="kz-mega" style="--kz-mega-w: 1120px">
    <div class="kz-mega-card grid gap-6 p-6" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr))">
      <!-- Enlaces principales, solo en móvil (el nav de arriba está oculto) -->
      <div class="col-[1/-1] flex flex-wrap gap-2 lg:hidden">
        {enlaces.map((l) => (
          <a href={l.href} class="kz-menupill"><span class="en">{l.en}</span><span class="es">{l.es}</span></a>
        ))}
        <a href="/industrias/" class="kz-menupill"><span class="en">Industries</span><span class="es">Industrias</span></a>
        <a href="/nosotros/" class="kz-menupill"><span class="en">About us</span><span class="es">Nosotros</span></a>
        <a href="/proyectos/" class="kz-menupill"><span class="en">Projects</span><span class="es">Proyectos</span></a>
        <a href="/#taller" class="kz-menupill"><span class="en">Repair shop</span><span class="es">Taller</span></a>
        <a href="/contacto/" class="kz-menupill" style="border-color: var(--green); color: var(--green2)"><span class="en">Get a quote</span><span class="es">Cotizar</span></a>
      </div>

      {grupos.map((g) => (
        <div class="flex flex-col gap-1.5">
          <span class="px-3 pb-2 text-xs font-semibold uppercase tracking-[0.08em]" style="color: var(--green2)">
            <span class="en">{g.g_en}</span><span class="es">{g.g_es}</span>
          </span>
          {g.items.map((it) => (
            <a href={it.href} class="kz-menuitem">
              <span class="text-[15px] font-semibold"><span class="en">{it.t_en}</span><span class="es">{it.t_es}</span></span>
              <span class="text-[13px]" style="color: var(--mute)"><span class="en">{it.d_en}</span><span class="es">{it.d_es}</span></span>
            </a>
          ))}
        </div>
      ))}

      <div class="flex flex-col gap-2.5 rounded-[14px] p-5" style="background: var(--navy); color: var(--bg)">
        <span class="text-[11px] font-semibold uppercase tracking-[0.08em]" style="color: var(--green-bright)">
          <span class="en">Not sure what you need?</span><span class="es">¿No sabés qué necesitás?</span>
        </span>
        <strong class="text-base font-semibold leading-snug">
          <span class="en">Free 30-minute diagnosis call.</span><span class="es">Llamada de diagnóstico gratis, 30 minutos.</span>
        </strong>
        <span class="text-[13px]" style="color: color-mix(in srgb, var(--bg) 70%, transparent)">
          <span class="en">We tell you what suits you and what it costs, in writing.</span>
          <span class="es">Te decimos qué te conviene y cuánto cuesta, por escrito.</span>
        </span>
        <a href="/contacto/" class="mt-auto self-start rounded-[9px] px-4 py-2.5 text-[13px] font-semibold text-white transition-colors" style="background: #16a36c" onmouseover="this.style.background='#3ed39a'; this.style.color='#0b1a33'" onmouseout="this.style.background='#16a36c'; this.style.color='#fff'">
          <span class="en">Book the call</span><span class="es">Agendar llamada</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Menú desplegable de industrias -->
  <div id="menu-industrias" hidden class="kz-mega" style="--kz-mega-w: 940px">
    <div class="kz-mega-card grid gap-6 p-6" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr))">
      {gruposIndustrias.map((g) => (
        <div class="flex flex-col gap-1.5">
          <span class="px-3 pb-2 text-xs font-semibold uppercase tracking-[0.08em]" style="color: var(--green2)">
            <span class="en">{g.g_en}</span><span class="es">{g.g_es}</span>
          </span>
          {g.items.map((it) => (
            <a href={it.href} class="kz-menuitem">
              <span class="text-[15px] font-semibold"><span class="en">{it.t_en}</span><span class="es">{it.t_es}</span></span>
              <span class="text-[13px]" style="color: var(--mute)"><span class="en">{it.d_en}</span><span class="es">{it.d_es}</span></span>
            </a>
          ))}
        </div>
      ))}

      <div class="flex flex-col gap-2.5 rounded-[14px] p-5" style="background: var(--navy); color: var(--bg)">
        <span class="text-[11px] font-semibold uppercase tracking-[0.08em]" style="color: var(--green-bright)">
          <span class="en">Your trade not listed?</span><span class="es">¿Tu rubro no está?</span>
        </span>
        <strong class="text-base font-semibold leading-snug">
          <span class="en">We build for your business anyway.</span><span class="es">Igual construimos para tu negocio.</span>
        </strong>
        <span class="text-[13px]" style="color: color-mix(in srgb, var(--bg) 70%, transparent)">
          <span class="en">Custom systems on the same proven base.</span>
          <span class="es">Sistemas a la medida sobre la misma base probada.</span>
        </span>
        <a href="/industrias/" class="mt-auto self-start rounded-[9px] px-4 py-2.5 text-[13px] font-semibold text-white transition-colors" style="background: #16a36c" onmouseover="this.style.background='#3ed39a'; this.style.color='#0b1a33'" onmouseout="this.style.background='#16a36c'; this.style.color='#fff'">
          <span class="en">See all industries</span><span class="es">Ver todas las industrias</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Menú desplegable de nosotros -->
  <div id="menu-nosotros" hidden class="kz-mega" style="--kz-mega-w: 780px">
    <div class="kz-mega-card grid gap-6 p-6" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr))">
      {gruposNosotros.map((g) => (
        <div class="flex flex-col gap-1.5">
          <span class="px-3 pb-2 text-xs font-semibold uppercase tracking-[0.08em]" style="color: var(--green2)">
            <span class="en">{g.g_en}</span><span class="es">{g.g_es}</span>
          </span>
          {g.items.map((it) => (
            <a href={it.href} class="kz-menuitem">
              <span class="text-[15px] font-semibold"><span class="en">{it.t_en}</span><span class="es">{it.t_es}</span></span>
              <span class="text-[13px]" style="color: var(--mute)"><span class="en">{it.d_en}</span><span class="es">{it.d_es}</span></span>
            </a>
          ))}
        </div>
      ))}

      <div class="flex flex-col gap-2.5 rounded-[14px] p-5" style="background: var(--navy); color: var(--bg)">
        <span class="text-[11px] font-semibold uppercase tracking-[0.08em]" style="color: var(--green-bright)">
          <span class="en">5+ years building software</span><span class="es">+5 años construyendo software</span>
        </span>
        <strong class="text-base font-semibold leading-snug">
          <span class="en">For a bank, a US company and Honduran businesses.</span>
          <span class="es">Para un banco, una empresa de EE. UU. y negocios hondureños.</span>
        </strong>
        <a href="/nosotros/" class="mt-auto self-start rounded-[9px] px-4 py-2.5 text-[13px] font-semibold text-white transition-colors" style="background: #16a36c" onmouseover="this.style.background='#3ed39a'; this.style.color='#0b1a33'" onmouseout="this.style.background='#16a36c'; this.style.color='#fff'">
          <span class="en">Meet us</span><span class="es">Conocernos</span>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .kz-toplink { color: var(--bg); transition: color 0.2s ease; }
  .kz-toplink:hover { color: var(--green-bright); }

  .kz-navlink {
    color: var(--ink2);
    padding: 9px 12px;
    border-radius: 9px;
    font-size: 14px;
    font-weight: 500;
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  .kz-navlink:hover { color: var(--green2); background: var(--bg2); }

  .kz-menupill {
    border: 1px solid var(--line);
    color: var(--ink);
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .kz-menupill:hover { border-color: var(--green); color: var(--green2); }

  .kz-menuitem {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 11px 12px;
    border-radius: 10px;
    color: var(--ink);
    transition: background-color 0.2s ease;
  }
  .kz-menuitem:hover { background: var(--bg2); }

  /* Los desplegables flotan sobre la página en vez de empujarla: el header
     es sticky (posicionado), así que sirve de referencia para el absolute.
     El padding-top es el "puente" invisible entre el botón y la tarjeta:
     es parte del elemento, así que pasar el mouse por ahí no lo cierra. */
  .kz-mega {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    width: min(var(--kz-mega-w, 960px), calc(100vw - 24px));
    padding-top: 10px;
    z-index: 50;
  }
  .kz-mega-card {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 18px;
    box-shadow: 0 24px 60px -12px rgba(11, 26, 51, 0.28);
    max-height: calc(100vh - 150px);
    overflow-y: auto;
  }
  @media (prefers-reduced-motion: no-preference) {
    .kz-mega:not([hidden]) { animation: kz-mega-in 0.18s cubic-bezier(0.22, 1, 0.36, 1); }
  }
  @keyframes kz-mega-in {
    from { opacity: 0; transform: translate(-50%, -6px); }
    to { opacity: 1; transform: translate(-50%, 0); }
  }
</style>

<script>
  // ── Menús desplegables (servicios e industrias): abren por hover o clic;
  //    abrir uno cierra el otro; cierran al salir del header, al hacer clic
  //    en un enlace o con Escape. ──
  const header = document.getElementById('main-nav')!;
  const menus = ['menu-servicios', 'menu-industrias', 'menu-nosotros']
    .map((id) => document.getElementById(id))
    .filter((m): m is HTMLElement => m !== null);
  const btnMovil = document.getElementById('menu-movil-btn');

  function cerrarTodos() {
    menus.forEach((m) => (m.hidden = true));
    document.querySelectorAll('[data-menu-btn]').forEach((b) => b.setAttribute('aria-expanded', 'false'));
    btnMovil?.setAttribute('aria-expanded', 'false');
  }
  function abrir(id: string) {
    cerrarTodos();
    const m = document.getElementById(id);
    if (m) m.hidden = false;
    document.querySelector(`[data-menu-btn="${id}"]`)?.setAttribute('aria-expanded', 'true');
  }
  document.querySelectorAll<HTMLElement>('[data-menu-btn]').forEach((btn) => {
    const id = btn.dataset.menuBtn!;
    btn.addEventListener('click', () => {
      const m = document.getElementById(id);
      m && m.hidden ? abrir(id) : cerrarTodos();
    });
    btn.addEventListener('mouseenter', () => abrir(id));
  });
  // El botón móvil abre el menú de servicios (trae las pastillas de navegación).
  btnMovil?.addEventListener('click', () => {
    const m = document.getElementById('menu-servicios');
    if (m && m.hidden) {
      abrir('menu-servicios');
      btnMovil.setAttribute('aria-expanded', 'true');
    } else {
      cerrarTodos();
    }
  });
  header.addEventListener('mouseleave', cerrarTodos);
  menus.forEach((m) =>
    m.addEventListener('click', (e) => {
      if (e.target instanceof Element && e.target.closest('a')) cerrarTodos();
    }),
  );
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') cerrarTodos();
  });

  // ── Tema ──
  function pintarTema(t: string) {
    document.getElementById('icon-moon')?.classList.toggle('hidden', t === 'dark');
    document.getElementById('icon-sun')?.classList.toggle('hidden', t !== 'dark');
  }
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const actual = document.documentElement.getAttribute('data-theme') || 'light';
    const siguiente = actual === 'dark' ? 'light' : 'dark';
    const aplicar = () => {
      document.documentElement.setAttribute('data-theme', siguiente);
      localStorage.setItem('kz-theme', siguiente);
      pintarTema(siguiente);
    };
    // La cortina: el tema nuevo baja revelándose con un clip-path. Donde no
    // hay View Transitions (o se pidió menos movimiento), cambia y ya.
    const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!document.startViewTransition || reducido) {
      aplicar();
      return;
    }
    document.startViewTransition(aplicar).ready.then(() => {
      document.documentElement.animate(
        { clipPath: ['inset(0 0 100% 0)', 'inset(0)'] },
        { pseudoElement: '::view-transition-new(root)', duration: 600, easing: 'ease-in-out' },
      );
    });
  });
  pintarTema(document.documentElement.getAttribute('data-theme') || 'light');

  // ── Idioma (la moneda acompaña, salvo elección explícita del toggle) ──
  document.getElementById('lang-toggle')?.addEventListener('click', () => {
    const actual = document.documentElement.getAttribute('lang') || 'es';
    const siguiente = actual === 'es' ? 'en' : 'es';
    document.documentElement.setAttribute('lang', siguiente);
    localStorage.setItem('kz-lang', siguiente);
    if (!localStorage.getItem('kz-moneda')) {
      document.documentElement.setAttribute('data-moneda', siguiente === 'es' ? 'lps' : 'usd');
    }
  });
</script>
