---
import { Icon } from 'astro-icon/components';
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import FloatingWhatsApp from '@/components/FloatingWhatsApp.astro';
import { industrias } from '@/lib/industrias';
import type { Producto } from '@/lib/productos';

/**
 * Página de cada producto propio (/productos/x y /en/products/x): qué es,
 * qué hace, para qué negocios sirve, y el botón para abrirlo de verdad.
 */
interface Props {
  producto: Producto;
  lang: 'es' | 'en';
}
const { producto: p, lang } = Astro.props;
const es = lang === 'es';

const urlEs = `/productos/${p.slug}/`;
const urlEn = `/en/products/${p.slugEn}/`;
const propia = es ? urlEs : urlEn;
const otra = es ? urlEn : urlEs;

const paraQuien = p.industrias
  .map((slug) => industrias.find((i) => i.slug === slug))
  .filter((i) => i !== undefined);

const textoDemo = es ? `Hola! Quiero una demo de ${p.nombre}.` : `Hi! I would like a demo of ${p.nombre}.`;
const waDemo = 'https://wa.me/50488091744?text=' + encodeURIComponent(textoDemo);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: p.nombre,
      url: p.url,
      description: es ? p.descEs : p.descEn,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      author: { '@id': 'https://www.kizercode.com/#business' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Kizercode', item: 'https://www.kizercode.com/' },
        { '@type': 'ListItem', position: 2, name: es ? 'Productos' : 'Products', item: new URL(es ? '/productos/' : '/en/products/', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: p.nombre, item: new URL(propia, Astro.site).href },
      ],
    },
  ],
};
---

<Layout
  title={`${p.nombre} — ${es ? p.taglineEs : p.taglineEn} | Kizercode`}
  description={es ? p.descEs : p.descEn}
  locale={es ? 'es_HN' : 'en_US'}
  forzarLang={lang}
  urlEs={urlEs}
  urlEn={urlEn}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <Nav />
  <main id="contenido">
    <section class="relative overflow-hidden" style="background: linear-gradient(180deg, var(--bg2) 0%, var(--bg) 100%)">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0" style="background-image: linear-gradient(color-mix(in srgb, var(--ink) 6%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--ink) 6%, transparent) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, #000 30%, transparent 100%); -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, #000 30%, transparent 100%)"></div>
      <div class="relative mx-auto grid max-w-[1200px] items-start gap-12 px-6 pb-14 pt-14" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr))">
        <div class="flex max-w-[640px] flex-col gap-6">
          <nav aria-label="breadcrumb" class="text-[13px] font-medium" style="color: var(--mute)">
            <a href="/" class="transition-colors hover:text-[var(--green2)]" style="color: var(--mute)">Kizercode</a>
            <span aria-hidden="true"> / </span>
            <a href={es ? '/productos/' : '/en/products/'} class="transition-colors hover:text-[var(--green2)]" style="color: var(--mute)">{es ? 'Productos' : 'Products'}</a>
            <span aria-hidden="true"> / </span>
            <span style="color: var(--ink2)">{p.nombre}</span>
          </nav>
          <span class="kz-badge self-start">{es ? p.tagEs : p.tagEn}</span>
          <h1 class="font-bold" style="font-size: clamp(34px, 4.2vw, 52px); line-height: 1.1; letter-spacing: -0.02em; text-wrap: balance">
            {es ? p.taglineEs : p.taglineEn}
          </h1>
          {(es ? p.introEs : p.introEn).map((t) => (
            <p class="text-[17px] leading-relaxed" style="color: var(--ink2); text-wrap: pretty">{t}</p>
          ))}
          <div class="flex flex-wrap gap-3">
            <a href={p.url} target="_blank" rel="noopener noreferrer" class="kz-btn kz-btn-primario" style="padding: 15px 26px; font-size: 16px">
              {es ? `Abrir ${p.nombre}` : `Open ${p.nombre}`} ↗
            </a>
            <a href={waDemo} target="_blank" rel="noopener noreferrer" class="kz-btn kz-btn-secundario" style="padding: 15px 26px; font-size: 16px">
              <img src="/whatsapp.svg" alt="" width="18" height="18" class="block" />
              {es ? 'Pedir una demo' : 'Ask for a demo'}
            </a>
          </div>
        </div>

        <div class="flex flex-col gap-3.5 lg:pt-10">
          <div class="flex flex-col items-center gap-4 rounded-2xl p-8 text-center" style="background: var(--navy); color: var(--bg); box-shadow: 0 12px 30px rgba(11,26,51,.18)">
            <span class="flex h-20 w-20 items-center justify-center rounded-2xl" style="background: color-mix(in srgb, var(--green-bright) 16%, transparent); color: var(--green-bright)">
              <Icon name={p.icon} size={40} aria-hidden="true" />
            </span>
            <strong class="text-3xl font-bold" style="letter-spacing: -0.02em">{p.nombre}</strong>
            <span class="inline-flex items-center gap-2 text-[13px] font-semibold" style="color: var(--green-bright)">
              <span class="kz-latido" style="background: var(--green-bright)"></span>
              {es ? 'Disponible hoy' : 'Available today'}
            </span>
          </div>
          {[
            { es: 'Hecho en Honduras', en: 'Made in Honduras' },
            { es: 'Soporte del mismo equipo que lo construyó', en: 'Support from the team that built it' },
            p.sinInternet ? { es: 'Sigue funcionando sin internet', en: 'Keeps working offline' } : { es: 'Se usa desde cualquier navegador', en: 'Runs in any browser' },
          ].map((st) => (
            <div class="flex items-center gap-4 rounded-2xl border p-4" style="background: var(--bg); border-color: var(--line)">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl font-bold" style="background: var(--green-soft); color: var(--green2)">✓</span>
              <span class="text-[15px] font-medium" style="color: var(--ink2)">{es ? st.es : st.en}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Qué hace -->
    <section class="mx-auto max-w-[1200px] px-6 py-16">
      <h2 class="kz-h2 mb-8" style="font-size: clamp(24px, 2.6vw, 32px)">{es ? 'Qué hace' : 'What it does'}</h2>
      <ul class="grid list-none gap-4" style="grid-template-columns: repeat(auto-fit, minmax(240px, 1fr))">
        {p.features.map((f) => (
          <li class="kz-card flex items-center gap-3 p-5">
            <span class="shrink-0 text-lg font-bold" style="color: var(--green)">✓</span>
            <span class="text-[15px] font-semibold">{es ? f.es : f.en}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Para quién + a la medida -->
    <section class="border-y" style="background: var(--bg2); border-color: var(--line)">
      <div class="mx-auto grid max-w-[1200px] gap-12 px-6 py-16" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr))">
        <div class="flex flex-col gap-4">
          <h2 class="kz-h2" style="font-size: clamp(24px, 2.6vw, 32px)">{es ? 'Para qué negocios' : 'For which businesses'}</h2>
          <ul class="flex list-none flex-wrap gap-2">
            {paraQuien.map((i) => (
              <li>
                <a href={es ? `/industrias/${i!.slug}/` : `/en/industries/${i!.slugEn}/`} class="kz-chip inline-block transition-colors hover:border-[var(--green)] hover:text-[var(--green2)]">
                  {es ? i!.nombre : i!.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class="flex flex-col gap-3 rounded-2xl border p-6" style="background: var(--bg); border-color: var(--line)">
          <strong class="text-lg font-bold">{es ? '¿Tu negocio necesita algo distinto?' : 'Does your business need something different?'}</strong>
          <p class="text-sm leading-relaxed" style="color: var(--ink2)">
            {es
              ? `Construimos a la medida sobre la misma base de ${p.nombre}: mismo equipo, precio fijo por escrito y código a tu nombre.`
              : `We build custom on the same base as ${p.nombre}: same team, fixed price in writing and code under your name.`}
          </p>
          <a href={es ? '/servicios/sistemas-a-la-medida/' : '/en/services/custom-software/'} class="text-sm font-semibold" style="color: var(--green2)">
            {es ? 'Ver sistemas a la medida' : 'See custom software'} →
          </a>
        </div>
      </div>
    </section>

    <section style="background: var(--navy); color: var(--bg)">
      <div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-6 px-6 py-14">
        <div class="flex max-w-[600px] flex-col gap-2">
          <h2 class="font-bold" style="font-size: clamp(24px, 2.8vw, 34px); line-height: 1.15; letter-spacing: -0.02em; text-wrap: balance">
            {es ? `¿Querés ver ${p.nombre} con tu negocio?` : `Want to see ${p.nombre} with your business?`}
          </h2>
          <p class="text-base" style="color: color-mix(in srgb, var(--bg) 70%, transparent)">
            {es ? 'Te lo mostramos funcionando, sin compromiso.' : 'We show it to you working, no strings attached.'}
          </p>
        </div>
        <a href={waDemo} target="_blank" rel="noopener noreferrer" class="rounded-xl px-6 py-3.5 text-[15px] font-semibold text-white transition-colors" style="background: #16a36c" onmouseover="this.style.background='#3ed39a'; this.style.color='#0b1a33'" onmouseout="this.style.background='#16a36c'; this.style.color='#fff'">
          {es ? 'Pedir una demo' : 'Ask for a demo'}
        </a>
      </div>
    </section>
  </main>
  <Footer />
  <FloatingWhatsApp />

  <script is:inline define:vars={{ otra }}>
    document.getElementById('lang-toggle')?.addEventListener(
      'click',
      (e) => {
        e.stopImmediatePropagation();
        localStorage.setItem('kz-lang', otra.startsWith('/en/') ? 'en' : 'es');
        location.href = otra;
      },
      { capture: true },
    );
  </script>
</Layout>
