---
import { Icon } from 'astro-icon/components';
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import FloatingWhatsApp from '@/components/FloatingWhatsApp.astro';
import { industrias } from '@/lib/industrias';
import type { Producto } from '@/lib/productos';

/**
 * Página de cada producto propio (/productos/x y /en/products/x): qué es,
 * qué hace, para qué negocios sirve, y el botón para abrirlo de verdad.
 */
interface Props {
  producto: Producto;
  lang: 'es' | 'en';
}
const { producto: p, lang } = Astro.props;
const es = lang === 'es';

const urlEs = `/productos/${p.slug}/`;
const urlEn = `/en/products/${p.slugEn}/`;
const propia = es ? urlEs : urlEn;
const otra = es ? urlEn : urlEs;

const paraQuien = p.industrias
  .map((slug) => industrias.find((i) => i.slug === slug))
  .filter((i) => i !== undefined);

// Título de búsqueda (≤ 60): nombre + qué es. El lema largo de cada producto
// pasaba de 80 caracteres y Google lo cortaba a la mitad.
const titulos: Record<string, [string, string]> = {
  kizerpos: ['KizerPOS: punto de venta e inventario en Honduras', 'KizerPOS: point of sale and inventory software'],
  kizerresto: ['KizerResto: sistema para restaurantes en Honduras', 'KizerResto: restaurant POS software for Honduras'],
  'kizer-cobros': ['Kizer Cobros: software para prestamistas en Honduras', 'Kizer Cobros: loan management software'],
  'kizer-check': ['Kizer Check: control de asistencia y planilla', 'Kizer Check: attendance and payroll software'],
  clinicosalud: ['ClínicoSalud: software para clínicas en Honduras', 'ClínicoSalud: clinic management software'],
  'portal-inmobiliario': ['Portal inmobiliario para Honduras | Kizercode', 'Real estate portal software for Honduras'],
};
const titulo = titulos[p.slug]?.[es ? 0 : 1] ?? `${p.nombre} | Kizercode`;

const textoDemo =es ? `Hola! Quiero una demo de ${p.nombre}.` : `Hi! I would like a demo of ${p.nombre}.`;
const waDemo = 'https://wa.me/50488091744?text=' + encodeURIComponent(textoDemo);

// Foto del producto funcionando en un negocio real (/productos/<slug>.jpg, 3:2).
const fotoAlt = p.fotoAltEs ? (es ? p.fotoAltEs : p.fotoAltEn) : undefined;

// Solo el producto estrella (el portal inmobiliario): el flujo lead → casa y
// los renders. Los demás productos no cambian.
const pasosLead = [
  {
    tEs: 'El comprador encuentra la casa',
    tEn: 'The buyer finds the house',
    dEs: 'Busca en el mapa con pins y precio, filtra por tipo, habitaciones y varas², y guarda sus favoritas.',
    dEn: 'They search the map with pins and prices, filter by type, bedrooms and square varas, and save favorites.',
  },
  {
    tEs: 'Agenda la visita desde la ficha',
    tEn: 'They book the visit from the listing',
    dEs: 'Elige día y hora en la ficha de esa propiedad. La solicitud nace amarrada a esa casa, no a un "info" suelto.',
    dEn: 'They pick a day and time on that property’s page. The request is born tied to that house, not a loose "info?".',
  },
  {
    tEs: 'Te llega por WhatsApp, con la casa',
    tEn: 'It reaches you on WhatsApp, with the house',
    dEs: 'La consulta entra al WhatsApp de la inmobiliaria con la propiedad, el día y la hora. Tu asesor sabe qué casa quiere cada lead sin preguntar.',
    dEn: 'The inquiry lands on the agency’s WhatsApp with the property, day and time. Your agent knows which house each lead wants without asking.',
  },
  {
    tEs: 'Confirmás y cerrás',
    tEn: 'You confirm and close',
    dEs: 'Confirmás la visita por WhatsApp y seguís con ese comprador hasta el cierre — también si compra desde Estados Unidos, con tour en video y firma a distancia.',
    dEn: 'You confirm the visit on WhatsApp and follow that buyer to closing — even if they buy from the United States, with a video tour and remote signing.',
  },
];
const renderAlts: [string, string][] = [
  ['Render 3D de fachada: casa moderna de una planta con cochera y jardín tropical al atardecer', '3D exterior render: modern single-story house with carport and tropical garden at sunset'],
  ['Render 3D de interior: sala y cocina abiertas con isla y puerta corrediza a la terraza', '3D interior render: open living room and kitchen with island and sliding door to the terrace'],
  ['Render 3D aéreo de una lotificación nueva en el valle de Sula, con casas y lotes disponibles', '3D aerial render of a new subdivision in the Sula valley, with houses and available lots'],
];
const renders = renderAlts.map(([aEs, aEn], i) => ({
  src: `/bienes/render-${i + 1}.jpg`,
  srcset: `/bienes/render-${i + 1}-768.jpg 768w, /bienes/render-${i + 1}.jpg 1200w`,
  alt: es ? aEs : aEn,
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: p.nombre,
      url: p.url,
      description: es ? p.descEs : p.descEn,
      ...(fotoAlt ? { image: new URL(`/productos/${p.slug}.jpg`, Astro.site).href } : {}),
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      author: { '@id': 'https://www.kizercode.com/#business' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Kizercode', item: 'https://www.kizercode.com/' },
        { '@type': 'ListItem', position: 2, name: es ? 'Productos' : 'Products', item: new URL(es ? '/productos/' : '/en/products/', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: p.nombre, item: new URL(propia, Astro.site).href },
      ],
    },
  ],
};
---

<Layout
  title={titulo}
  description={es ? p.descEs : p.descEn}
  locale={es ? 'es_HN' : 'en_US'}
  forzarLang={lang}
  urlEs={urlEs}
  urlEn={urlEn}
  image={fotoAlt ? `/productos/${p.slug}-og.jpg` : undefined}
  imageAlt={fotoAlt}
  servicio={p.nombre} waEs={textoDemo} waEn={textoDemo}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <Nav />
  <main id="contenido">
    <section class="relative overflow-hidden" style="background: linear-gradient(180deg, var(--bg2) 0%, var(--bg) 100%)">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0" style="background-image: linear-gradient(color-mix(in srgb, var(--ink) 6%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--ink) 6%, transparent) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, #000 30%, transparent 100%); -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, #000 30%, transparent 100%)"></div>
      <div class="relative mx-auto grid max-w-[1200px] items-start gap-12 px-6 pb-14 pt-14" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr))">
        <div class="flex max-w-[640px] flex-col gap-6">
          <nav aria-label="breadcrumb" class="text-[13px] font-medium" style="color: var(--mute)">
            <a href="/" class="transition-colors hover:text-[var(--green2)]" style="color: var(--mute)">Kizercode</a>
            <span aria-hidden="true"> / </span>
            <a href={es ? '/productos/' : '/en/products/'} class="transition-colors hover:text-[var(--green2)]" style="color: var(--mute)">{es ? 'Productos' : 'Products'}</a>
            <span aria-hidden="true"> / </span>
            <span style="color: var(--ink2)">{p.nombre}</span>
          </nav>
          <div class="flex flex-wrap items-center gap-2">
            {p.estrella && (
              <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[12px] font-bold" style="background: var(--green); color: #fff">
                <span aria-hidden="true">★</span>{es ? 'Producto estrella' : 'Flagship product'}
              </span>
            )}
            <span class="kz-badge">{es ? p.tagEs : p.tagEn}</span>
          </div>
          <h1 class="font-bold" style="font-size: clamp(34px, 4.2vw, 52px); line-height: 1.1; letter-spacing: -0.02em; text-wrap: balance">
            {es ? p.taglineEs : p.taglineEn}
          </h1>
          {(es ? p.introEs : p.introEn).map((t) => (
            <p class="text-[17px] leading-relaxed" style="color: var(--ink2); text-wrap: pretty">{t}</p>
          ))}
          <div class="flex flex-wrap gap-3">
            <a href={waDemo} target="_blank" rel="noopener noreferrer" class="kz-btn kz-btn-primario" style="padding: 15px 26px; font-size: 16px">
              <img src="/whatsapp.svg" alt="" width="18" height="18" class="block brightness-0 invert" />
              {es ? 'Pedir una demo' : 'Ask for a demo'}
            </a>
            <a href={p.demo ?? p.url} target="_blank" rel="noopener noreferrer" data-servicio={p.nombre} class="kz-btn kz-btn-secundario" style="padding: 15px 26px; font-size: 16px">
              {p.demo
                ? (es ? 'Ver la demo' : 'See the demo')
                : p.estrella
                  ? (es ? 'Verlo funcionando' : 'See it working')
                  : (es ? `Abrir ${p.nombre}` : `Open ${p.nombre}`)} ↗
            </a>
          </div>
          {p.estrella && p.casoEs && (
            <span class="text-[13px]" style="color: var(--mute)">
              {es
                ? `${p.casoEs}, El Progreso: el enlace abre su portal. Las propiedades y los números que ves ahí son de A&A; el software es nuestro.`
                : `${p.casoEn}, El Progreso: the link opens their portal. The listings and numbers you see there belong to A&A; the software is ours.`}
            </span>
          )}
          {!p.demo && !p.estrella && (
            <span class="text-[13px]" style="color: var(--mute)">
              {es
                ? `El enlace abre ${p.nombre} en su propio sitio, donde se pide cuenta. Si solo querés verlo funcionando, escribinos y te lo mostramos.`
                : `The link opens ${p.nombre} on its own site, where an account is required. If you just want to see it working, message us and we will show you.`}
            </span>
          )}
        </div>

        <div class="flex flex-col gap-3.5 lg:pt-10">
          {fotoAlt && (
            <img
              src={`/productos/${p.slug}.jpg`}
              srcset={`/productos/${p.slug}-768.jpg 768w, /productos/${p.slug}.jpg 1200w`}
              sizes="(min-width: 1024px) 560px, 100vw"
              alt={fotoAlt}
              width="1200"
              height="800"
              fetchpriority="high"
              decoding="async"
              class="block h-auto w-full rounded-3xl border object-cover"
              style="border-color: var(--line); box-shadow: 0 24px 50px rgba(11,26,51,.14); aspect-ratio: 3 / 2"
            />
          )}
          <div class={`flex items-center rounded-2xl ${fotoAlt ? 'flex-row gap-4 p-5 text-left' : 'flex-col gap-4 p-8 text-center'}`} style="background: var(--navy); color: var(--bg); box-shadow: 0 12px 30px rgba(11,26,51,.18)">
            <span class={`flex shrink-0 items-center justify-center rounded-2xl ${fotoAlt ? 'h-12 w-12' : 'h-20 w-20'}`} style="background: color-mix(in srgb, var(--green-bright) 16%, transparent); color: var(--green-bright)">
              <Icon name={p.icon} size={fotoAlt ? 24 : 40} aria-hidden="true" />
            </span>
            <span class={`flex flex-col ${fotoAlt ? 'gap-1' : 'items-center gap-4'}`}>
              <strong class={`font-bold ${fotoAlt ? 'text-xl' : 'text-3xl'}`} style="letter-spacing: -0.02em">{p.nombre}</strong>
              <span class="inline-flex items-center gap-2 text-[13px] font-semibold" style="color: var(--green-bright)">
                <span class="kz-latido" style="background: var(--green-bright)"></span>
                {p.casoEs ? (es ? p.casoEs : p.casoEn) : (es ? 'Disponible hoy' : 'Available today')}
              </span>
            </span>
          </div>
          <div class={fotoAlt ? 'grid grid-cols-1 gap-3 lg:grid-cols-3' : 'flex flex-col gap-3.5'}>
            {[
              { es: 'Hecho en Honduras', en: 'Made in Honduras' },
              { es: 'Soporte del mismo equipo que lo construyó', en: 'Support from the team that built it' },
              p.sinInternet ? { es: 'Sigue funcionando sin internet', en: 'Keeps working offline' } : { es: 'Se usa desde cualquier navegador', en: 'Runs in any browser' },
            ].map((st) => (
              <div class={`flex items-center rounded-2xl border ${fotoAlt ? 'gap-3 p-3.5' : 'gap-4 p-4'}`} style="background: var(--bg); border-color: var(--line)">
                <span class={`flex shrink-0 items-center justify-center rounded-xl font-bold ${fotoAlt ? 'h-8 w-8 text-sm' : 'h-10 w-10'}`} style="background: var(--green-soft); color: var(--green2)">✓</span>
                <span class={`font-medium ${fotoAlt ? 'text-[13px] leading-snug' : 'text-[15px]'}`} style="color: var(--ink2)">{es ? st.es : st.en}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Qué hace -->
    <section class="mx-auto max-w-[1200px] px-6 py-16">
      <h2 class="kz-h2 mb-8" style="font-size: clamp(24px, 2.6vw, 32px)">{es ? 'Qué hace' : 'What it does'}</h2>
      <ul class="grid list-none gap-4" style="grid-template-columns: repeat(auto-fit, minmax(240px, 1fr))">
        {p.features.map((f) => (
          <li class="kz-card flex items-center gap-3 p-5">
            <span class="shrink-0 text-lg font-bold" style="color: var(--green)">✓</span>
            <span class="text-[15px] font-semibold">{es ? f.es : f.en}</span>
          </li>
        ))}
      </ul>
    </section>

    {p.estrella && (
      <section class="mx-auto max-w-[1200px] px-6 pb-16">
        <div class="mb-8 flex max-w-[720px] flex-col gap-3">
          <h2 class="kz-h2" style="font-size: clamp(24px, 2.6vw, 32px)">
            {es ? 'Cada lead llega amarrado a su casa' : 'Every lead arrives tied to its house'}
          </h2>
          <p class="text-[15.5px] leading-relaxed" style="color: var(--ink2); text-wrap: pretty">
            {es
              ? 'Te armamos el flujo que conecta tus leads con tus casas de manera más sencilla. Se acabó el "¿cuál casa era?": cada consulta y cada visita entra por WhatsApp con la propiedad que la originó.'
              : 'We build you the flow that connects your leads with your houses, the simple way. No more "which house was it?": every inquiry and every visit comes in on WhatsApp with the property that started it.'}
          </p>
        </div>
        <ol class="grid list-none gap-4" style="grid-template-columns: repeat(auto-fit, minmax(230px, 1fr))">
          {pasosLead.map((paso, i) => (
            <li class="kz-card flex flex-col gap-2 p-6">
              <span class="flex h-9 w-9 items-center justify-center rounded-full text-sm font-bold text-white" style="background: var(--green)">{i + 1}</span>
              <strong class="mt-1 text-[15px] font-semibold">{es ? paso.tEs : paso.tEn}</strong>
              <span class="text-sm leading-relaxed" style="color: var(--ink2)">{es ? paso.dEs : paso.dEn}</span>
            </li>
          ))}
        </ol>
      </section>
    )}

    {p.estrella && (
      <section class="border-t" style="border-color: var(--line)">
        <div class="mx-auto max-w-[1200px] px-6 py-16">
          <div class="mb-8 flex max-w-[720px] flex-col gap-3">
            <p class="kz-eyebrow">{es ? 'Incluido en el paquete' : 'Included in the package'}</p>
            <h2 class="kz-h2" style="font-size: clamp(24px, 2.6vw, 32px)">
              {es ? 'Renders 3D para vender antes de construir' : '3D renders to sell before you build'}
            </h2>
            <p class="text-[15.5px] leading-relaxed" style="color: var(--ink2); text-wrap: pretty">
              {es
                ? '¿Vendés casas en planos, una lotificación o una propiedad que pide remodelación? Te hacemos los renders 3D para que el comprador vea la casa terminada antes de que exista — o cómo queda después de remodelarla. Van directo a la ficha de la propiedad y a tus redes.'
                : 'Selling homes off-plan, a subdivision or a property that needs remodeling? We make the 3D renders so the buyer sees the finished house before it exists — or how it looks after the remodel. They go straight onto the property page and your social media.'}
            </p>
          </div>
          <ul class="grid list-none gap-4" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr))">
            {renders.map((r) => (
              <li>
                <img
                  src={r.src}
                  srcset={r.srcset}
                  sizes="(min-width: 1024px) 380px, 100vw"
                  alt={r.alt}
                  width="1200"
                  height="800"
                  loading="lazy"
                  decoding="async"
                  class="block h-auto w-full rounded-2xl border object-cover"
                  style="border-color: var(--line); aspect-ratio: 3 / 2"
                />
              </li>
            ))}
          </ul>
          <p class="mt-4 text-[13px]" style="color: var(--mute)">
            {es ? 'Renders de ejemplo. Los tuyos salen de los planos o las fotos de tu propiedad.' : 'Sample renders. Yours are made from your property’s plans or photos.'}
          </p>
        </div>
      </section>
    )}

    <!-- Para quién + a la medida -->
    <section class="border-y" style="background: var(--bg2); border-color: var(--line)">
      <div class="mx-auto grid max-w-[1200px] gap-12 px-6 py-16" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr))">
        <div class="flex flex-col gap-4">
          <h2 class="kz-h2" style="font-size: clamp(24px, 2.6vw, 32px)">{es ? 'Para qué negocios' : 'For which businesses'}</h2>
          <ul class="flex list-none flex-wrap gap-2">
            {paraQuien.map((i) => (
              <li>
                <a href={es ? `/industrias/${i!.slug}/` : `/en/industries/${i!.slugEn}/`} class="kz-chip inline-block transition-colors hover:border-[var(--green)] hover:text-[var(--green2)]">
                  {es ? i!.nombre : i!.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class="flex flex-col gap-3 rounded-2xl border p-6" style="background: var(--bg); border-color: var(--line)">
          <strong class="text-lg font-bold">{es ? '¿Tu negocio necesita algo distinto?' : 'Does your business need something different?'}</strong>
          <p class="text-sm leading-relaxed" style="color: var(--ink2)">
            {es
              ? `Construimos a la medida sobre la misma base de ${p.nombre}: mismo equipo, precio fijo por escrito y código a tu nombre.`
              : `We build custom on the same base as ${p.nombre}: same team, fixed price in writing and code under your name.`}
          </p>
          <a href={es ? '/servicios/sistemas-a-la-medida/' : '/en/services/custom-software/'} class="text-sm font-semibold" style="color: var(--green2)">
            {es ? 'Ver sistemas a la medida' : 'See custom software'} →
          </a>
        </div>
      </div>
    </section>

    <section style="background: var(--navy); color: var(--bg)">
      <div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-6 px-6 py-14">
        <div class="flex max-w-[600px] flex-col gap-2">
          <h2 class="font-bold" style="font-size: clamp(24px, 2.8vw, 34px); line-height: 1.15; letter-spacing: -0.02em; text-wrap: balance">
            {p.estrella
              ? (es ? '¿Querés tu portal con tus propiedades?' : 'Want the portal with your properties?')
              : (es ? `¿Querés ver ${p.nombre} con tu negocio?` : `Want to see ${p.nombre} with your business?`)}
          </h2>
          <p class="text-base" style="color: color-mix(in srgb, var(--bg) 70%, transparent)">
            {es ? 'Te lo mostramos funcionando, sin compromiso.' : 'We show it to you working, no strings attached.'}
          </p>
        </div>
        <a href={waDemo} target="_blank" rel="noopener noreferrer" class="rounded-xl px-6 py-3.5 text-[15px] font-semibold text-white transition-colors" style="background: #0d8050" onmouseover="this.style.background='#3ed39a'; this.style.color='#0b1a33'" onmouseout="this.style.background='#0d8050'; this.style.color='#fff'">
          {es ? 'Pedir una demo' : 'Ask for a demo'}
        </a>
      </div>
    </section>
  </main>
  <Footer />
  <FloatingWhatsApp />

  <script is:inline define:vars={{ otra }}>
    document.getElementById('lang-toggle')?.addEventListener(
      'click',
      (e) => {
        e.stopImmediatePropagation();
        localStorage.setItem('kz-lang', otra.startsWith('/en/') ? 'en' : 'es');
        location.href = otra;
      },
      { capture: true },
    );
  </script>
</Layout>
