const equipo = [
  {
    tEs: 'Grabador DVR o NVR',
    tEn: 'DVR or NVR recorder',
    dEs: 'El centro del sistema: almacena, administra los accesos y publica el video hacia tu celular. DVR para cableado coaxial, NVR para cámaras IP sobre red.',
    dEn: 'The core of the system: it stores, manages access and publishes video to your phone. DVR for coaxial wiring, NVR for IP cameras over the network.',
  },
  {
    tEs: 'Disco de vigilancia',
    tEn: 'Surveillance drive',
    dEs: 'Diseñado para escribir las 24 horas, a diferencia del disco de una computadora. Su capacidad define cuántos días podés revisar hacia atrás.',
    dEn: 'Built to write 24 hours a day, unlike a regular computer drive. Its capacity defines how many days you can review.',
  },
  {
    tEs: 'Switch PoE',
    tEn: 'PoE switch',
    dEs: 'Entrega datos y alimentación por el mismo cable de red: una cámara en el poste del portón no necesita tomacorriente propio.',
