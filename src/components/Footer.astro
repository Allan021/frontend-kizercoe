---
/** Footer del rediseño: logo por tema, tres columnas de enlaces, línea legal. */
// La columna de servicios enlaza a las páginas dedicadas: SEO interno.
const servicios = [
  { href: '/servicios/paginas-web/', en: 'Websites', es: 'Páginas web' },
  { href: '/servicios/tiendas-en-linea/', en: 'Online stores', es: 'Tiendas en línea' },
  { href: '/servicios/sistemas-a-la-medida/', en: 'Custom software', es: 'Sistemas a la medida' },
  { href: '/servicios/automatizacion-ia/', en: 'AI automation', es: 'Automatización con IA' },
  { href: '/servicios/crm-a-la-medida/', en: 'Custom CRM', es: 'CRM a la medida' },
  { href: '/servicios/reparacion-computadoras/', en: 'Computer repair', es: 'Reparación de computadoras' },
  { href: '/servicios/reparacion-telefonos/', en: 'Phone repair', es: 'Reparación de celulares' },
  { href: '/servicios/instalacion-camaras/', en: 'Security cameras', es: 'Cámaras de seguridad' },
];
const empresa = [
  { href: '/nosotros/', en: 'About us', es: 'Nosotros' },
  { href: '/servicios/', en: 'All services', es: 'Todos los servicios' },
  { href: '/industrias/', en: 'Industries', es: 'Industrias' },
  { href: '/productos/', en: 'Products', es: 'Productos' },
  { href: '/proyectos/', en: 'Projects', es: 'Proyectos' },
  { href: '/precios/', en: 'Pricing', es: 'Precios' },
  { href: '/trabaja-con-nosotros/', en: 'Careers', es: 'Trabajá con nosotros' },
];
---

<footer class="border-t" style="border-color: var(--line); background: var(--bg)">
  <div class="mx-auto grid max-w-[1200px] gap-8 px-6 pb-8 pt-12" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr))">
    <div class="flex flex-col gap-3.5">
      <span class="inline-flex self-start">
        <img data-logo-light="1" src="/kizercode-logo.png" alt="Kizercode" width="102" height="34" class="block h-[34px] w-[102px] object-contain" />
        <img data-logo-dark="1" src="/kizercode-logo-dark.png" alt="Kizercode" width="102" height="34" class="h-[34px] w-[102px] object-contain" />
      </span>
      <p class="max-w-[300px] text-sm leading-relaxed" style="color: var(--ink2)">
        <span class="en">Custom software, AI, security cameras and device repair. Made in Honduras.</span>
        <span class="es">Software a la medida, IA, cámaras de seguridad y reparación de equipos. Hecho en Honduras.</span>
      </p>
      <span class="text-[13px]" style="color: var(--mute)">
        <span class="en">Fixed price · 30-day warranty · Code under your name</span>
        <span class="es">Precio fijo · 30 días de garantía · Código a tu nombre</span>
      </span>
    </div>

    <nav class="flex flex-col gap-2.5 text-sm" aria-label="Servicios">
      <strong class="text-[13px] font-semibold uppercase tracking-[0.06em]" style="color: var(--mute)">
        <span class="en">Services</span><span class="es">Servicios</span>
      </strong>
      {servicios.map((l) => (
        <a href={l.href} class="kz-flink"><span class="en">{l.en}</span><span class="es">{l.es}</span></a>
      ))}
    </nav>

    <nav class="flex flex-col gap-2.5 text-sm" aria-label="Empresa">
      <strong class="text-[13px] font-semibold uppercase tracking-[0.06em]" style="color: var(--mute)">
        <span class="en">Company</span><span class="es">Empresa</span>
      </strong>
      {empresa.map((l) => (
        <a href={l.href} class="kz-flink"><span class="en">{l.en}</span><span class="es">{l.es}</span></a>
      ))}
    </nav>

    <div class="flex flex-col gap-2.5 text-sm">
      <strong class="text-[13px] font-semibold uppercase tracking-[0.06em]" style="color: var(--mute)">
        <span class="en">Contact</span><span class="es">Contacto</span>
      </strong>
      <a href="tel:+50488091744" class="kz-flink">+504 8809-1744</a>
      <a href="mailto:hello@kizercode.com" class="kz-flink">hello@kizercode.com</a>
      <a href="https://wa.me/50488091744" target="_blank" rel="noopener noreferrer" class="kz-flink">WhatsApp</a>
      <a href="https://www.linkedin.com/company/kizercode" target="_blank" rel="noopener noreferrer" class="kz-flink">LinkedIn</a>
      <a href="https://github.com/kizercode" target="_blank" rel="noopener noreferrer" class="kz-flink">GitHub</a>
      <span style="color: var(--ink2)">El Progreso, Yoro, Honduras</span>
    </div>
  </div>

  <div class="border-t" style="border-color: var(--line)">
    <div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-4 px-6 py-4 text-[13px]" style="color: var(--mute)">
      <span>
        <span class="en">© 2026 Kizercode. All rights reserved. Made in Honduras.</span>
        <span class="es">© 2026 Kizercode. Todos los derechos reservados. Hecho en Honduras.</span>
      </span>
      <a href="/panel/" class="kz-flink" style="color: var(--mute)">Panel</a>
    </div>
  </div>
</footer>

<style>
  .kz-flink { color: var(--ink2); transition: color 0.2s ease; }
  .kz-flink:hover { color: var(--green2); }
</style>
