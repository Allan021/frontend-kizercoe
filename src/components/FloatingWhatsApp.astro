---
/**
 * FAB de WhatsApp del rediseño: pastilla verde con texto siempre visible.
 * El mensaje precargado cambia con el idioma (el script de abajo lo ajusta).
 */
const WA_NUMBER = '50488091744';
const msgs = {
  en: 'Hi! I found Kizercode and would like to know more about your services.',
  es: 'Hola! Encontré Kizercode y quiero saber más.',
};
---

<a
  id="wa-fab"
  href={`https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(msgs.es)}`}
  data-wa-number={WA_NUMBER}
  data-wa-en={msgs.en}
  data-wa-es={msgs.es}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="WhatsApp"
  class="fixed bottom-[22px] right-[22px] z-30 inline-flex items-center gap-2.5 rounded-full px-5 py-3.5 text-[15px] font-semibold text-white transition-colors"
  style="background: var(--green); box-shadow: 0 10px 30px rgba(11,26,51,.25); border: 2px solid var(--bg)"
  onmouseover="this.style.background='var(--green2)'"
  onmouseout="this.style.background='var(--green)'"
>
  <img src="/whatsapp.svg" alt="" width="22" height="22" class="block brightness-0 invert" />
  <span class="en">Chat with us</span><span class="es">Escribinos</span>
</a>

<script>
  // El texto precargado del wa.me acompaña al idioma elegido.
  const fab = document.getElementById('wa-fab') as HTMLAnchorElement | null;
  if (fab) {
    const num = fab.dataset.waNumber;
    const msgs: Record<string, string> = { en: fab.dataset.waEn ?? '', es: fab.dataset.waEs ?? '' };
    const actualizar = () => {
      const lang = document.documentElement.getAttribute('lang') || 'es';
      fab.href = `https://wa.me/${num}?text=${encodeURIComponent(msgs[lang] ?? msgs.es)}`;
    };
    actualizar();
    new MutationObserver(actualizar).observe(document.documentElement, { attributes: true, attributeFilter: ['lang'] });
  }
  // La medición del clic la hace el listener global de Layout (wa.me).
</script>
