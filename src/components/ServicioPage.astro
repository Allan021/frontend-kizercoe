---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import FloatingWhatsApp from '@/components/FloatingWhatsApp.astro';
import type { Servicio } from '@/lib/servicios';
import { intros, statsServicio } from '@/lib/serviciosIntro';
import { extras } from '@/lib/serviciosExtra';
import { fotos } from '@/lib/serviciosFotos';

/**
 * Plantilla de las páginas de servicio (/servicios/x y /en/services/x).
 *
 * Una sola plantilla para los dos idiomas: `lang` decide qué textos se ven
 * (el CSS de idioma de siempre) y qué metadatos se emiten. Cada página lleva
 * su propio JSON-LD de Service + FAQPage + migas: eso es lo que Google lee.
 */
interface Props {
  servicio: Servicio;
  lang: 'es' | 'en';
}
const { servicio: s, lang } = Astro.props;
const es = lang === 'es';
const intro = intros[s.slug];
const stats: { n: string; nEn?: string; es: string; en: string }[] = s.stats ?? statsServicio;
const x = extras[s.slug];
const foto = fotos[s.slug];
const faqs = [...s.faq, ...(x?.faq ?? [])];
// Reparaciones: se atienden en el local. El software se hace para todo el país.
const local = s.slug.startsWith('reparacion');
const desdeLps = s.lps ? Number(s.lps.replace(/[^\d]/g, '')) : NaN;
const desdeUsd = s.usd ? Number(s.usd.replace(/[^\d]/g, '')) : NaN;
// Un precio "desde": el schema lo dice con minPrice, no como precio cerrado.
const oferta = (precio: number, moneda: string) => ({
  '@type': 'Offer',
  priceCurrency: moneda,
  price: precio,
  priceSpecification: { '@type': 'PriceSpecification', minPrice: precio, priceCurrency: moneda },
});

const urlEs = `/servicios/${s.slug}/`;
const urlEn = `/en/services/${s.slugEn}/`;
const propia = es ? urlEs : urlEn;
const otra = es ? urlEn : urlEs;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: es ? s.nombre : s.name,
      description: es ? s.descEs : s.descEn,
      url: new URL(propia, Astro.site).href,
      serviceType: es ? s.nombre : s.name,
      ...(foto ? { image: new URL(`/servicios/${s.slug}.jpg`, Astro.site).href } : {}),
      areaServed: local
        ? { '@type': 'City', name: 'El Progreso', containedInPlace: { '@type': 'AdministrativeArea', name: 'Yoro, Honduras' } }
        : { '@type': 'Country', name: 'Honduras' },
      provider: { '@id': 'https://www.kizercode.com/#business' },
      // Lempiras primero: es el precio que dice la página en español. Antes
      // decía solo USD 150 contra "L 4,000" del texto, y una IA citaba cualquiera.
      ...(desdeLps > 0
        ? { offers: [oferta(desdeLps, 'HNL'), ...(desdeUsd > 0 ? [oferta(desdeUsd, 'USD')] : [])] }
        : {}),
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: es ? f.qEs : f.qEn,
        acceptedAnswer: { '@type': 'Answer', text: es ? f.aEs : f.aEn },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Kizercode', item: 'https://www.kizercode.com/' },
        { '@type': 'ListItem', position: 2, name: es ? 'Servicios' : 'Services', item: new URL(es ? '/servicios/' : '/en/services/', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: es ? s.nombre : s.name, item: new URL(propia, Astro.site).href },
      ],
    },
  ],
};
---

<Layout
  title={es ? s.titleEs : s.titleEn}
  description={es ? s.descEs : s.descEn}
  locale={es ? 'es_HN' : 'en_US'}
  forzarLang={lang}
  urlEs={urlEs}
  urlEn={urlEn}
  image={foto ? `/servicios/${s.slug}-og.jpg` : undefined}
  imageAlt={foto ? (es ? foto.altEs : foto.altEn) : undefined}
  servicio={s.nombre} waEs={`Hola! Estoy interesado en el servicio de ${s.nombre.replace(/^[A-ZÁÉÍÓÚ](?=[a-záéíóúñ])/, (c) => c.toLowerCase())}.`} waEn={`Hi! I'm interested in your ${s.name.replace(/^[A-Z](?=[a-z])/, (c) => c.toLowerCase())} service.`}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <Nav />
  <main id="contenido">
    <!-- Hero a dos columnas: la historia a la izquierda, los números a la
         derecha. El visitante que scrollea lee; el que compara mira stats. -->
    <section class="relative overflow-hidden" style="background: linear-gradient(180deg, var(--bg2) 0%, var(--bg) 100%)">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0" style="background-image: linear-gradient(color-mix(in srgb, var(--ink) 6%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--ink) 6%, transparent) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, #000 30%, transparent 100%); -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, #000 30%, transparent 100%)"></div>
      <div class="relative mx-auto grid max-w-[1200px] items-start gap-12 px-6 pb-14 pt-14" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr))">
        <div class="flex max-w-[640px] flex-col gap-6">
          <nav aria-label="breadcrumb" class="text-[13px] font-medium" style="color: var(--mute)">
            <a href="/" class="transition-colors hover:text-[var(--green2)]" style="color: var(--mute)">Kizercode</a>
            <span aria-hidden="true"> / </span>
            <a href={es ? '/servicios/' : '/en/services/'} class="transition-colors hover:text-[var(--green2)]" style="color: var(--mute)">{es ? 'Servicios' : 'Services'}</a>
            <span aria-hidden="true"> / </span>
            <span style="color: var(--ink2)">{es ? s.nombre : s.name}</span>
          </nav>
          <h1 class="font-bold" style="font-size: clamp(34px, 4.2vw, 52px); line-height: 1.1; letter-spacing: -0.02em; text-wrap: balance">
            {x && <span class="kz-h1-kw">{es ? x.kwEs : x.kwEn}</span>}
            {es ? s.h1Es : s.h1En}
          </h1>
          {(es ? intro?.es : intro?.en)?.map((p) => (
            <p class="text-[17px] leading-relaxed" style="color: var(--ink2); text-wrap: pretty">{p}</p>
          )) ?? <p class="text-lg leading-relaxed" style="color: var(--ink2)">{es ? s.subEs : s.subEn}</p>}
          {s.lps && (
            <p class="flex items-baseline gap-2">
              <span class="text-[13px]" style="color: var(--mute)">{es ? 'desde' : 'from'}</span>
              <span class="text-4xl font-bold" style="letter-spacing: -0.02em; color: var(--green)">
                <span class="lps">{s.lps}</span><span class="usd">{s.usd}</span>
              </span>
              <span class="text-[13px]" style="color: var(--mute)">{es ? 'pago único' : 'one-time'}</span>
            </p>
          )}
          <div class="flex flex-wrap gap-3">
            <a href={`/contacto/?servicio=${encodeURIComponent(s.formServicio)}`} class="kz-btn kz-btn-primario" style="padding: 15px 26px; font-size: 16px">
              {es ? 'Cotización gratis' : 'Free quote'}
            </a>
            <a href="https://wa.me/50488091744" target="_blank" rel="noopener noreferrer" class="kz-btn kz-btn-secundario" style="padding: 15px 26px; font-size: 16px">
              <img src="/whatsapp.svg" alt="" width="18" height="18" class="block" />
              WhatsApp
            </a>
          </div>
        </div>

        <div class="flex flex-col gap-3.5 lg:pt-10">
          {foto && (
            <img
              src={`/servicios/${s.slug}.jpg`}
              srcset={`/servicios/${s.slug}-768.jpg 768w, /servicios/${s.slug}.jpg 1200w`}
              sizes="(min-width: 1024px) 560px, 100vw"
              alt={es ? foto.altEs : foto.altEn}
              width="1200"
              height="800"
              fetchpriority="high"
              decoding="async"
              class="block h-auto w-full rounded-3xl border object-cover"
              style="border-color: var(--line); box-shadow: 0 24px 50px rgba(11,26,51,.14); aspect-ratio: 3 / 2"
            />
          )}
          <div class={foto ? 'grid grid-cols-2 gap-3' : 'flex flex-col gap-3.5'}>
            {stats.map((st) => (
              <div class={`flex items-center rounded-2xl border ${foto ? 'gap-3 p-3.5' : 'gap-4 p-5'}`} style="background: var(--bg); border-color: var(--line); box-shadow: 0 12px 30px rgba(11,26,51,.06)">
                <span class={`flex shrink-0 items-center justify-center rounded-xl font-bold ${foto ? 'h-9 w-9 text-base' : 'h-12 w-12 text-lg'}`} style="background: var(--green-soft); color: var(--green2)">✓</span>
                <span class="flex min-w-0 flex-col">
                  <strong class={`font-bold ${foto ? 'text-lg' : 'text-2xl'}`} style="letter-spacing: -0.02em; color: var(--green)">{es ? st.n : (st.nEn ?? st.n)}</strong>
                  <span class={`font-medium ${foto ? 'text-[12.5px] leading-snug' : 'text-[14px]'}`} style="color: var(--ink2)">{es ? st.es : st.en}</span>
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Beneficios -->
    <section class="mx-auto max-w-[1200px] px-6 py-16">
      <ul class="grid list-none gap-4" style="grid-template-columns: repeat(auto-fit, minmax(240px, 1fr))">
        {s.beneficios.map((b) => (
          <li class="kz-card flex flex-col gap-2 p-6">
            <strong class="text-[15px] font-semibold">{es ? b.tEs : b.tEn}</strong>
            <span class="text-sm leading-relaxed" style="color: var(--ink2)">{es ? b.dEs : b.dEn}</span>
          </li>
        ))}
      </ul>
    </section>

    {x && (
      <section class="mx-auto max-w-[1200px] px-6 pb-16">
        <h2 class="kz-h2 mb-6" style="font-size: clamp(24px, 2.6vw, 32px)">{es ? 'Cómo trabajamos' : 'How we work'}</h2>
        <ol class="grid list-none gap-4" style="grid-template-columns: repeat(auto-fit, minmax(230px, 1fr))">
          {x.pasos.map((p, i) => (
            <li class="kz-card flex flex-col gap-2 p-6">
              <span class="flex h-9 w-9 items-center justify-center rounded-full text-sm font-bold text-white" style="background: var(--green)">{i + 1}</span>
              <strong class="mt-1 text-[15px] font-semibold">{es ? p.tEs : p.tEn}</strong>
              <span class="text-sm leading-relaxed" style="color: var(--ink2)">{es ? p.dEs : p.dEn}</span>
            </li>
          ))}
        </ol>
      </section>
    )}

    {x && (
      <section class="mx-auto max-w-[1200px] px-6 pb-16">
        <div class="grid items-start gap-10 rounded-3xl border p-8 md:p-10" style="border-color: var(--line); grid-template-columns: repeat(auto-fit, minmax(280px, 1fr))">
          <div class="flex flex-col gap-4">
            <h2 class="kz-h2" style="font-size: clamp(24px, 2.6vw, 32px)">{es ? x.costoTituloEs : x.costoTituloEn}</h2>
            {(es ? x.costoEs : x.costoEn).map((p) => (
              <p class="text-[15.5px] leading-relaxed" style="color: var(--ink2); text-wrap: pretty">{p}</p>
            ))}
          </div>
          {s.lps && (
            <div class="flex flex-col gap-3 rounded-2xl p-7" style="background: var(--green-soft)">
              <span class="text-[13px] font-medium" style="color: var(--ink2)">{es ? `${s.nombre}, desde` : `${s.name}, from`}</span>
              <span class="text-5xl font-bold" style="letter-spacing: -0.02em; color: var(--green2)">{es ? s.lps : s.usd}</span>
              <span class="text-[13px]" style="color: var(--ink2)">
                {es ? `${s.usd} · pago único · precio fijo por escrito` : `${s.lps} · one-time · fixed price in writing`}
              </span>
              <a href={`/contacto/?servicio=${encodeURIComponent(s.formServicio)}`} class="kz-btn kz-btn-primario mt-2 justify-center">
                {es ? 'Pedir mi cotización' : 'Get my quote'}
              </a>
            </div>
          )}
        </div>
      </section>
    )}

    <!-- Qué incluye + FAQ -->
    <section class="border-y" style="background: var(--bg2); border-color: var(--line)">
      <div class="mx-auto grid max-w-[1200px] gap-12 px-6 py-16" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr))">
        <div class="flex flex-col gap-4">
          <h2 class="kz-h2" style="font-size: clamp(24px, 2.6vw, 32px)">{es ? 'Qué incluye' : "What's included"}</h2>
          <ul class="flex list-none flex-col gap-2.5">
            {s.incluye.map((i) => (
              <li class="flex items-start gap-2.5 text-[15px] leading-normal" style="color: var(--ink2)">
                <span class="shrink-0 font-bold" style="color: var(--green)">✓</span>
                {es ? i.es : i.en}
              </li>
            ))}
          </ul>
          <p class="mt-2 rounded-[14px] border p-4 text-sm leading-relaxed" style="background: var(--green-soft); border-color: color-mix(in srgb, var(--green) 30%, transparent); color: var(--ink2)">
            {es
              ? (s.notaEs ?? 'Precio fijo por escrito antes de empezar y 30 días de garantía por fallas de lo entregado.')
              : (s.notaEn ?? 'Fixed price in writing before starting and a 30-day warranty on defects of what we deliver.')}
          </p>
        </div>
        <div class="flex flex-col gap-2">
          <h2 class="kz-h2 mb-2" style="font-size: clamp(24px, 2.6vw, 32px)">{es ? 'Preguntas frecuentes' : 'FAQ'}</h2>
          {faqs.map((f) => (
            <details class="kz-sfaq border-b" style="border-color: var(--line)">
              <summary class="flex cursor-pointer items-center justify-between gap-4 py-3.5 text-[15px] font-semibold">
                <span>{es ? f.qEs : f.qEn}</span>
                <span class="kz-sfaq-signo shrink-0" aria-hidden="true">+</span>
              </summary>
              <p class="pb-4 text-sm leading-relaxed" style="color: var(--ink2); text-wrap: pretty">{es ? f.aEs : f.aEn}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA final -->
    <section style="background: var(--navy); color: var(--bg)">
      <div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-6 px-6 py-14">
        <div class="flex max-w-[600px] flex-col gap-2">
          <h2 class="font-bold" style="font-size: clamp(24px, 2.8vw, 34px); line-height: 1.15; letter-spacing: -0.02em; text-wrap: balance">
            {es ? '¿Hablamos de tu proyecto?' : 'Shall we talk about your project?'}
          </h2>
          <p class="text-base" style="color: color-mix(in srgb, var(--bg) 70%, transparent)">
            {es ? 'Diagnóstico gratis y precio fijo por escrito en menos de 24 horas.' : 'Free diagnosis and a fixed written price in under 24 hours.'}
          </p>
        </div>
        <a href={`/contacto/?servicio=${encodeURIComponent(s.formServicio)}`} class="rounded-xl px-6 py-3.5 text-[15px] font-semibold text-white transition-colors" style="background: #0d8050" onmouseover="this.style.background='#3ed39a'; this.style.color='#0b1a33'" onmouseout="this.style.background='#0d8050'; this.style.color='#fff'">
          {es ? 'Cotizar este servicio' : 'Get a quote for this'}
        </a>
      </div>
    </section>
  </main>
  <Footer />
  <FloatingWhatsApp />

  <script is:inline define:vars={{ otra }}>
    // En páginas con URL por idioma, el toggle ES/EN navega a la contraparte
    // en vez de solo cambiar el CSS: así Google indexa las dos versiones.
    document.getElementById('lang-toggle')?.addEventListener(
      'click',
      (e) => {
        e.stopImmediatePropagation();
        const destino = otra;
        localStorage.setItem('kz-lang', destino.startsWith('/en/') ? 'en' : 'es');
        location.href = destino;
      },
      { capture: true },
    );
  </script>
</Layout>

<style>
  .kz-sfaq summary { list-style: none; }
  .kz-sfaq summary::-webkit-details-marker { display: none; }
  .kz-sfaq-signo { font-size: 18px; line-height: 1; color: var(--green); transition: transform 0.2s ease; }
  .kz-sfaq[open] .kz-sfaq-signo { transform: rotate(45deg); }
</style>
