---
import Layout from '@/layouts/Layout.astro';
import Panel from '@/components/Panel.tsx';
---

<!-- noindex: el panel no tiene por qué salir en Google. -->
<Layout title="Panel — Kizercode" description="Administración de Kizercode" noindex>
  <main class="mx-auto w-full max-w-5xl px-6 pb-24 pt-8">
    <!-- client:only porque todo depende del token del navegador: no hay nada
         que renderizar en el servidor. -->
    <Panel client:only="react" />
  </main>
</Layout>
