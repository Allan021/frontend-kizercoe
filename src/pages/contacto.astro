---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import FloatingWhatsApp from '@/components/FloatingWhatsApp.astro';
import CTA from '@/sections/CTA.astro';

/**
 * Página dedicada de contacto (estilo codebrand /contact): encabezado con la
 * promesa, la sección de contacto completa (canales + formulario, que lee
 * ?servicio= para llegar preseleccionado) y la ubicación con horario.
 */
---
<Layout
  title="Contacto — Cotizá tu proyecto | Kizercode"
  description="Contactá a Kizercode: WhatsApp, llamada o formulario. Diagnóstico gratis y respuesta en menos de 24 horas con precio fijo por escrito."
>
  <Nav />
  <main id="contenido">
    <section class="relative overflow-hidden" style="background: linear-gradient(180deg, var(--bg2) 0%, var(--bg) 100%)">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0" style="background-image: linear-gradient(color-mix(in srgb, var(--ink) 6%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--ink) 6%, transparent) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, #000 30%, transparent 100%); -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, #000 30%, transparent 100%)"></div>
      <div class="relative mx-auto flex max-w-[760px] flex-col items-center gap-4 px-6 pb-4 pt-16 text-center">
        <p class="kz-eyebrow"><span class="en">Contact</span><span class="es">Contacto</span></p>
        <h1 class="font-bold" style="font-size: clamp(34px, 4.6vw, 54px); line-height: 1.1; letter-spacing: -0.02em; text-wrap: balance">
          <span class="en">Tell us what you need. We reply in under 24 h.</span>
          <span class="es">Contanos qué necesitás. Respondemos en menos de 24 h.</span>
        </h1>
        <p class="max-w-[560px] text-lg leading-relaxed" style="color: var(--ink2); text-wrap: pretty">
          <span class="en">Free consultation, no strings. By WhatsApp, phone or the form: whichever suits you.</span>
          <span class="es">Consulta gratis y sin compromiso. Por WhatsApp, llamada o el formulario: como te quede mejor.</span>
        </p>
      </div>
    </section>

    <!-- La sección de contacto completa: canales + formulario -->
    <CTA />

    <!-- Ubicación y horario -->
    <section class="border-t" style="background: var(--bg2); border-color: var(--line)">
      <div class="mx-auto grid max-w-[1200px] gap-5 px-6 py-12" style="grid-template-columns: repeat(auto-fit, minmax(240px, 1fr))">
        <div class="flex flex-col gap-1">
          <strong class="text-[15px] font-semibold"><span class="en">Location</span><span class="es">Ubicación</span></strong>
          <span class="text-sm" style="color: var(--ink2)">El Progreso, Yoro, Honduras</span>
        </div>
        <div class="flex flex-col gap-1">
          <strong class="text-[15px] font-semibold"><span class="en">Hours</span><span class="es">Horario</span></strong>
          <span class="text-sm" style="color: var(--ink2)">
            <span class="en">Mon–Sat · WhatsApp answered every day</span>
            <span class="es">Lun–Sáb · WhatsApp se contesta todos los días</span>
          </span>
        </div>
        <div class="flex flex-col gap-1">
          <strong class="text-[15px] font-semibold"><span class="en">Also serving</span><span class="es">También atendemos</span></strong>
          <span class="text-sm" style="color: var(--ink2)">
            <span class="en">All of Honduras remotely, and clients abroad in English.</span>
            <span class="es">Todo Honduras a distancia, y clientes de afuera en inglés.</span>
          </span>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <FloatingWhatsApp />
</Layout>
