---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import FloatingWhatsApp from '@/components/FloatingWhatsApp.astro';
import IdiomaPorUrl from '@/components/IdiomaPorUrl.astro';
import IconoWhatsApp from '@/components/IconoWhatsApp.astro';
import ContactForm from '@/components/ContactForm';
import { Icon } from 'astro-icon/components';

/**
 * Página de contacto: la promesa arriba, el formulario en tres pasos (lee
 * ?servicio= y llega con el servicio elegido) junto a los canales directos y
 * la dirección, qué pasa después de escribir, y las dudas de siempre.
 */

// /en/contact/ renderiza esta misma página (src/pages/en/contact.astro).
const en = Astro.url.pathname.startsWith('/en/');
const SITIO = 'https://www.kizercode.com';
const MAPA = 'https://www.google.com/maps/search/?api=1&query=15.3874749,-87.7996886';
const waTexto = encodeURIComponent(en ? 'Hi! I would like a quote from Kizercode.' : 'Hola! Quiero cotizar con Kizercode.');

const confianza = [
  { es: 'Diagnóstico gratis', en: 'Free diagnosis', icono: 'lucide:search-check' },
  { es: 'Precio fijo por escrito', en: 'Fixed price in writing', icono: 'lucide:file-check' },
  { es: '30 días de garantía en software', en: '30-day warranty on software', icono: 'lucide:shield-check' },
];

const despues = [
  { es: 'Te respondemos', en: 'We reply', des: 'En menos de 24 h, por el canal que elegiste: WhatsApp, llamada o correo.', den: 'In under 24 h, through the channel you chose: WhatsApp, phone or email.', icono: 'lucide:message-circle' },
  { es: 'Diagnóstico gratis', en: 'Free diagnosis', des: 'Mapeamos cómo trabajás hoy y qué querés resolver. Sin costo y sin compromiso.', den: 'We map how you work today and what you want to solve. Free, no strings.', icono: 'lucide:search-check' },
  { es: 'Propuesta por escrito', en: 'Written proposal', des: 'Alcance, precio fijo y cronograma real. Sin letra chica.', den: 'Scope, fixed price and a real timeline. No fine print.', icono: 'lucide:file-check' },
  { es: 'Vos decidís', en: 'You decide', des: 'Si te sirve, arrancamos y aprobás cada etapa. Si no, no debés nada.', den: 'If it works for you, we start and you approve each stage. If not, you owe nothing.', icono: 'lucide:handshake' },
];

const faq = [
  {
    qEs: '¿La consulta tiene costo?', qEn: 'Does the consultation cost anything?',
    aEs: 'No. El diagnóstico es gratis y sin compromiso: te decimos qué necesitás y cuánto cuesta, con precio fijo por escrito.',
    aEn: 'No. The diagnosis is free and with no strings: we tell you what you need and what it costs, with a fixed price in writing.',
  },
  {
    qEs: '¿En cuánto tiempo responden?', qEn: 'How fast do you reply?',
    aEs: 'En menos de 24 horas, por el canal que prefieras. Si es urgente, escribinos directo al WhatsApp +504 8809-1744.',
    aEn: 'In under 24 hours, through the channel you prefer. If it is urgent, message us directly on WhatsApp at +504 8809-1744.',
  },
  {
    qEs: '¿Atienden fuera de El Progreso?', qEn: 'Do you work outside El Progreso?',
    aEs: 'Depende del servicio. El software lo hacemos para todo Honduras y para clientes de afuera, a distancia. Las cámaras de seguridad las instalamos en El Progreso y el valle de Sula. Las reparaciones se hacen en el taller.',
    aEn: 'It depends on the service. Software we build for all of Honduras and for clients abroad, remotely. Security cameras we install in El Progreso and the Sula valley. Repairs are done at our workshop.',
  },
  {
    qEs: '¿Puedo ir al local?', qEn: 'Can I visit in person?',
    aEs: 'Sí. Estamos en Plaza Bendeck, El Progreso, Yoro, de lunes a sábado de 7:00 a.m. a 6:00 p.m.',
    aEn: 'Yes. We are at Plaza Bendeck, El Progreso, Yoro, Monday to Saturday from 7:00 a.m. to 6:00 p.m.',
  },
  {
    qEs: '¿Qué necesito tener listo?', qEn: 'What do I need to have ready?',
    aEs: 'Solo una idea de lo que querés. Lo demás lo vemos juntos en el diagnóstico.',
    aEn: 'Just an idea of what you want. We work out the rest together in the diagnosis.',
  },
];

const url = `${SITIO}${en ? '/en/contact/' : '/contacto/'}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ContactPage',
      '@id': `${url}#pagina`,
      url,
      name: en ? 'Contact Kizercode' : 'Contacto — Kizercode',
      inLanguage: en ? 'en' : 'es',
      about: { '@id': `${SITIO}/#business` },
      mainEntity: { '@id': `${SITIO}/#business` },
    },
    {
      '@type': 'FAQPage',
      '@id': `${url}#faq`,
      inLanguage: en ? 'en' : 'es',
      mainEntity: faq.map((p) => ({
        '@type': 'Question',
        name: en ? p.qEn : p.qEs,
        acceptedAnswer: { '@type': 'Answer', text: en ? p.aEn : p.aEs },
      })),
    },
  ],
};
---
<Layout
  title={en ? 'Contact — Get a Quote for Your Project | Kizercode' : 'Contacto — Cotizá tu proyecto | Kizercode'}
  description={en
    ? 'Contact Kizercode by WhatsApp, phone or form. Free diagnosis and a reply in under 24 hours with a fixed price in writing.'
    : 'Contactá a Kizercode: WhatsApp, llamada o formulario. Diagnóstico gratis y respuesta en menos de 24 horas con precio fijo por escrito.'}
  locale={en ? 'en_US' : undefined}
  forzarLang={en ? 'en' : 'es'}
  urlEs="/contacto/"
  urlEn="/en/contact/"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <Nav />
  <IdiomaPorUrl otra={en ? '/contacto/' : '/en/contact/'} />
  <main id="contenido">
    <!-- Encabezado: la promesa y tres hechos que ya sostiene el sitio -->
    <section class="relative overflow-hidden" style="background: linear-gradient(180deg, var(--bg2) 0%, var(--bg) 100%)">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0" style="background-image: linear-gradient(color-mix(in srgb, var(--ink) 6%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--ink) 6%, transparent) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, #000 30%, transparent 100%); -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, #000 30%, transparent 100%)"></div>
      <div class="relative mx-auto flex max-w-[800px] flex-col items-center gap-4 px-4 pb-8 pt-12 text-center sm:px-6 sm:pt-16">
        <p class="kz-eyebrow"><span class="en">Contact</span><span class="es">Contacto</span></p>
        <h1 class="font-bold" style="font-size: clamp(30px, 4.6vw, 54px); line-height: 1.1; letter-spacing: -0.02em; text-wrap: balance">
          <span class="en">Tell us what you need. We reply in under 24 h.</span>
          <span class="es">Contanos qué necesitás. Respondemos en menos de 24 h.</span>
        </h1>
        <p class="max-w-[600px] text-base leading-relaxed sm:text-lg" style="color: var(--ink2); text-wrap: pretty">
          <span class="en">Three short steps and a person on our team reviews your request. Prefer to talk? WhatsApp, call or visit us: whichever suits you.</span>
          <span class="es">Tres pasos cortos y una persona del equipo revisa tu solicitud. ¿Preferís hablar? WhatsApp, llamada o visitanos: como te quede mejor.</span>
        </p>
        <ul class="mt-1 flex list-none flex-wrap justify-center gap-2">
          {confianza.map((c) => (
            <li class="kz-badge" style="font-size: 13px; padding: 7px 12px">
              <Icon name={c.icono} class="h-4 w-4 shrink-0" aria-hidden="true" />
              <span class="en">{c.en}</span><span class="es">{c.es}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Formulario + canales directos -->
    <section id="contacto" class="mx-auto w-full max-w-[1200px] px-4 pb-16 sm:px-6" style="scroll-margin-top: 80px" aria-labelledby="form-titulo">
      <div class="kz-contacto-grid grid items-start gap-6 lg:gap-8">
        <div class="min-w-0 rounded-[20px] border p-4 sm:p-7" style="background: var(--bg2); border-color: var(--line)">
          <h2 id="form-titulo" class="sr-only"><span class="en">Request form</span><span class="es">Formulario de solicitud</span></h2>
          <ContactForm client:load />
        </div>

        <aside class="flex min-w-0 flex-col gap-3 lg:sticky lg:top-24" aria-labelledby="canales-titulo">
          <h2 id="canales-titulo" class="text-[15px] font-semibold">
            <span class="en">Prefer to talk directly?</span><span class="es">¿Preferís hablar directo?</span>
          </h2>

          <div class="kz-canal-card">
            <div class="flex items-start gap-3">
              <span class="kz-canal-icono" style="background: #25d366"><IconoWhatsApp size={20} class="block" /></span>
              <div class="flex min-w-0 flex-col">
                <strong class="text-[15px] font-semibold">WhatsApp</strong>
                <span class="text-[13px] leading-relaxed" style="color: var(--ink2)">
                  <span class="en">Fastest for quick questions and photos of your device.</span>
                  <span class="es">Lo más rápido para preguntas cortas y fotos de tu equipo.</span>
                </span>
              </div>
            </div>
            <a href={`https://wa.me/50488091744?text=${waTexto}`} target="_blank" rel="noopener noreferrer" class="kz-btn kz-btn-primario w-full" style="min-height: 46px; padding: 11px 16px">
              <span class="en">Message +504 8809-1744</span><span class="es">Escribir al +504 8809-1744</span>
            </a>
          </div>

          <a href="tel:+50488091744" class="kz-canal-card kz-canal-link">
            <div class="flex items-start gap-3">
              <span class="kz-canal-icono" style="background: var(--navy)"><Icon name="lucide:phone" class="h-5 w-5" style="color: var(--bg)" aria-hidden="true" /></span>
              <div class="flex min-w-0 flex-col">
                <strong class="text-[15px] font-semibold"><span class="en">Call</span><span class="es">Llamada</span> · +504 8809-1744</strong>
                <span class="text-[13px] leading-relaxed" style="color: var(--ink2)">
                  <span class="en">To book an appointment or explain something calmly.</span>
                  <span class="es">Para agendar una cita o explicar algo con calma.</span>
                </span>
              </div>
            </div>
          </a>

          <a href="mailto:hello@kizercode.com" class="kz-canal-card kz-canal-link">
            <div class="flex items-start gap-3">
              <span class="kz-canal-icono" style="background: var(--green-soft)"><Icon name="lucide:mail" class="h-5 w-5" style="color: var(--green2)" aria-hidden="true" /></span>
              <div class="flex min-w-0 flex-col">
                <strong class="break-all text-[15px] font-semibold">hello@kizercode.com</strong>
                <span class="text-[13px] leading-relaxed" style="color: var(--ink2)">
                  <span class="en">To send documents, plans or a long requirement.</span>
                  <span class="es">Para mandar documentos, planos o un requerimiento largo.</span>
                </span>
              </div>
            </div>
          </a>

          <div class="kz-canal-card">
            <div class="flex items-start gap-3">
              <span class="kz-canal-icono" style="background: var(--green-soft)"><Icon name="lucide:map-pin" class="h-5 w-5" style="color: var(--green2)" aria-hidden="true" /></span>
              <div class="flex min-w-0 flex-col gap-1">
                <strong class="text-[15px] font-semibold"><span class="en">Visit us</span><span class="es">Visitanos</span></strong>
                <span class="text-[13px] leading-relaxed" style="color: var(--ink2)">Plaza Bendeck, El Progreso, Yoro, Honduras</span>
                <span class="inline-flex items-center gap-1.5 text-[13px]" style="color: var(--ink2)">
                  <Icon name="lucide:clock" class="h-3.5 w-3.5 shrink-0" aria-hidden="true" />
                  <span class="en">Mon–Sat · 7:00 a.m.–6:00 p.m.</span><span class="es">Lun–Sáb · 7:00 a.m.–6:00 p.m.</span>
                </span>
              </div>
            </div>
            <a href={MAPA} target="_blank" rel="noopener noreferrer" class="kz-btn kz-btn-secundario w-full" style="min-height: 46px; padding: 11px 16px">
              <Icon name="lucide:navigation" class="h-4 w-4" aria-hidden="true" />
              <span class="en">Get directions</span><span class="es">Cómo llegar</span>
            </a>
          </div>
        </aside>
      </div>
    </section>

    <!-- Qué pasa después -->
    <section class="border-t" style="background: var(--bg2); border-color: var(--line)" aria-labelledby="despues-titulo">
      <div class="mx-auto flex max-w-[1200px] flex-col gap-8 px-4 py-14 sm:px-6 sm:py-16">
        <div class="flex max-w-[640px] flex-col gap-3">
          <p class="kz-eyebrow"><span class="en">After you write</span><span class="es">Después de escribirnos</span></p>
          <h2 id="despues-titulo" class="kz-h2">
            <span class="en">What happens after you contact us.</span>
            <span class="es">Qué pasa después de escribirnos.</span>
          </h2>
        </div>
        <ol class="grid list-none gap-3" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr))">
          {despues.map((p, i) => (
            <li class="flex flex-col gap-3 rounded-[18px] border p-5" style="background: var(--bg); border-color: var(--line)">
              <div class="flex items-center justify-between">
                <span class="flex h-8 w-8 items-center justify-center rounded-full text-[13px] font-bold text-white" style="background: var(--green-btn)">{i + 1}</span>
                <Icon name={p.icono} class="h-5 w-5" style="color: var(--green2)" aria-hidden="true" />
              </div>
              <strong class="text-base font-semibold"><span class="en">{p.en}</span><span class="es">{p.es}</span></strong>
              <span class="text-sm leading-relaxed" style="color: var(--ink2); text-wrap: pretty"><span class="en">{p.den}</span><span class="es">{p.des}</span></span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Preguntas -->
    <section aria-labelledby="faq-contacto">
      <div class="mx-auto grid max-w-[1200px] gap-8 px-4 py-14 sm:px-6 sm:py-16 lg:gap-12" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr))">
        <div class="flex flex-col gap-2.5">
          <p class="kz-eyebrow"><span class="en">FAQ</span><span class="es">Preguntas frecuentes</span></p>
          <h2 id="faq-contacto" class="kz-h2">
            <span class="en">Before you write.</span>
            <span class="es">Antes de escribirnos.</span>
          </h2>
        </div>
        <div class="flex flex-col">
          {faq.map((p) => (
            <details class="kz-faq border-b" style="border-color: var(--line)">
              <summary class="flex min-h-[48px] cursor-pointer items-center justify-between gap-4 py-4 text-base font-semibold">
                <span><span class="en">{p.qEn}</span><span class="es">{p.qEs}</span></span>
                <span class="kz-faq-signo shrink-0" aria-hidden="true">+</span>
              </summary>
              <p class="pb-5 text-[15px] leading-relaxed" style="color: var(--ink2); text-wrap: pretty">
                <span class="en">{p.aEn}</span><span class="es">{p.aEs}</span>
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <FloatingWhatsApp />
</Layout>

<style>
  .kz-contacto-grid { grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 1024px) {
    .kz-contacto-grid { grid-template-columns: minmax(0, 1fr) 340px; }
  }
  .kz-canal-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 16px;
    color: var(--ink);
    transition: border-color 0.2s ease;
  }
  .kz-canal-link:hover { border-color: var(--green); color: var(--ink); }
  .kz-canal-icono {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    color: #fff;
  }
  .kz-faq summary { list-style: none; }
  .kz-faq summary::-webkit-details-marker { display: none; }
  .kz-faq-signo { font-size: 20px; line-height: 1; color: var(--green); transition: transform 0.2s ease; }
  .kz-faq[open] .kz-faq-signo { transform: rotate(45deg); }
</style>
