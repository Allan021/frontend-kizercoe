---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import FloatingWhatsApp from '@/components/FloatingWhatsApp.astro';
import Footer from '@/components/Footer.astro';
import Hero from '@/sections/Hero.astro';
import Reviews from '@/sections/Reviews.astro';
import Projects from '@/sections/Projects.astro';
import WhyUs from '@/sections/WhyUs.astro';
import Services from '@/sections/Services.astro';
import Productos from '@/sections/Productos.astro';
import Process from '@/sections/Process.astro';
import Taller from '@/sections/Taller.astro';
import Pricing from '@/sections/Pricing.astro';
import FAQ from '@/sections/FAQ.astro';
import CTA from '@/sections/CTA.astro';
import Integraciones from '@/sections/Integraciones.astro';
import Comparativa from '@/sections/Comparativa.astro';
import Garantias from '@/sections/Garantias.astro';
import Recursos from '@/sections/Recursos.astro';
import IdiomaPorUrl from '@/components/IdiomaPorUrl.astro';

// /en/ renderiza esta misma página (src/pages/en/index.astro): el contenido
// ya es bilingüe, solo cambian el idioma fijo y los metadatos.
const en = Astro.url.pathname.startsWith('/en/');
---
<Layout
  title={en ? 'Kizercode — Software, Branding and Growth | Honduras' : undefined}
  description={en ? 'Custom software, web and mobile apps, AI agents, digital marketing, and computer and phone repair in El Progreso, Yoro, Honduras.' : undefined}
  locale={en ? 'en_US' : undefined}
  forzarLang={en ? 'en' : 'es'}
  urlEs="/"
  urlEn="/en/"
  conProductos
>
  <Nav />
  <IdiomaPorUrl otra={en ? '/' : '/en/'} />
  <!-- Orden del DESIGN-SYSTEM.md. "Equipo" y logos de clientes quedan fuera
       hasta tener fotos y nombres reales: placeholders no se publican. -->
  <main id="contenido">
    <Hero />
    <Reviews />
    <Projects />
    <WhyUs />
    <Services />
    <Productos />
    <Process />
    <Taller />
    <Pricing />
    <FAQ />
    <CTA />
    <Integraciones />
    <Comparativa />
    <Garantias />
    <Recursos />
  </main>
  <Footer />
  <FloatingWhatsApp />
</Layout>
