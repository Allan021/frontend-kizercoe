---
import { Icon } from 'astro-icon/components';
import Layout from '@/layouts/Layout.astro';
import IconoWhatsApp from '@/components/IconoWhatsApp.astro';
import { servicios } from '@/lib/servicios';

/**
 * /tarjeta/ — tarjeta digital de Kizercode para dueños de negocio.
 *
 * Se entrega con QR en persona o por WhatsApp. Con ?de=<nombre> es la
 * tarjeta de un socio (contador): muestra "Te lo recomienda X", el WhatsApp
 * sale con "Me recomendó X" y el lead entra al CRM como "Referido por X".
 * Así se sabe a quién pagarle la comisión.
 * ponytail: el socio se identifica por el nombre que escribió; si dos se llaman
 * igual, pedir el apellido al activar (en /socios/).
 *
 * Diseño: la misma línea del sitio (fondo claro con cuadrícula y resplandor
 * verde del hero, piezas blancas con borde) y la tarjeta en navy arriba.
 * En pantallas anchas son dos columnas: la tarjeta queda fija a la izquierda.
 */
const precio = (slug: string) => servicios.find((s) => s.slug === slug)?.lps;
const lineas = [
  { href: '/productos/kizerpos/', icon: 'lucide:store', t: 'Punto de venta KizerPOS', p: 'Producto propio', d: 'Vende sin internet, inventario y fiado' },
  { href: '/productos/kizerresto/', icon: 'lucide:utensils', t: 'KizerResto para restaurantes', p: 'Producto propio', d: 'Comanda a cocina y factura con CAI' },
  { href: '/servicios/sistemas-a-la-medida/', icon: 'lucide:layout-dashboard', t: 'Sistema a la medida', p: `Desde ${precio('sistemas-a-la-medida')}`, d: 'Adiós Excel' },
  { href: '/servicios/tiendas-en-linea/', icon: 'lucide:shopping-cart', t: 'Tienda en línea', p: `Desde ${precio('tiendas-en-linea')}`, d: 'Cobro con tarjeta' },
  { href: '/servicios/paginas-web/', icon: 'lucide:globe', t: 'Página web', p: `Desde ${precio('paginas-web')}`, d: 'Lista en una semana' },
  { href: '/servicios/automatizacion-ia/', icon: 'lucide:bot', t: 'Chatbot de WhatsApp con IA', p: `Desde ${precio('automatizacion-ia')}`, d: 'Contesta 24/7' },
];
const WA_BASE = 'Hola! Vi la tarjeta digital de Kizercode y quiero información.';
const wa = `https://wa.me/50488091744?text=${encodeURIComponent(WA_BASE)}`;
const mapa = 'https://www.google.com/maps/search/?api=1&query=Plaza+Bendeck+El+Progreso+Yoro+Honduras';
---
<Layout
  title="Tarjeta digital | Kizercode"
  description="Kizercode: punto de venta, sistemas a la medida, tiendas en línea y chatbots con IA para tu negocio. WhatsApp 8809-1744, Plaza Bendeck, El Progreso."
  forzarLang="es"
  urlEs="/tarjeta/"
  soloEs
  servicio="Tarjeta digital"
  waEs={WA_BASE}
>
  <main id="contenido" class="kz-tj">
    <div aria-hidden="true" class="kz-tj-rejilla"></div>
    <div aria-hidden="true" class="kz-tj-brillo"></div>

    <div class="kz-tj-caja">
      <div class="kz-tj-col kz-tj-fija">
        <section class="kz-tj-card kz-in" style="background: var(--navy); --i: 0" aria-labelledby="tj-titulo">
          <div aria-hidden="true" class="kz-tj-card-rejilla"></div>
          <div aria-hidden="true" class="kz-tj-card-luz"></div>
          <div aria-hidden="true" class="kz-tj-card-aro"></div>

          <header class="kz-tj-top">
            <img src="/logo-oscuro.webp" alt="Kizercode" width="132" height="44" class="h-10 w-auto" />
            <span class="kz-tj-chip"><span class="kz-latido" style="background: var(--green-bright)"></span> Hecho en Honduras</span>
          </header>

          <p id="ref" class="kz-tj-ref" hidden>
            <Icon name="lucide:handshake" class="h-5 w-5 shrink-0" aria-hidden="true" />
            <span>Te lo recomienda <strong id="ref-nombre"></strong></span>
          </p>

          <h1 id="tj-titulo" class="kz-tj-h1">Tu negocio, <span>en sistema.</span></h1>
          <p class="kz-tj-sub">Software para negocios de Honduras: punto de venta, sistemas, tiendas en línea e IA. Precio fijo por escrito antes de empezar.</p>

          <div class="kz-tj-datos">
            <span>+504 8809-1744</span>
            <span>kizercode.com</span>
          </div>
        </section>

        <div class="kz-tj-acciones kz-in" style="--i: 1">
          <a href={wa} target="_blank" rel="noopener noreferrer" class="kz-btn kz-btn-primario kz-tj-wa">
            <IconoWhatsApp size={22} /> Escribir por WhatsApp
          </a>
          <div class="kz-tj-tiles">
            <a href="tel:+50488091744"><span><Icon name="lucide:phone" class="h-5 w-5" aria-hidden="true" /></span> Llamar</a>
            <a href="/kizercode.vcf" download="Kizercode.vcf"><span><Icon name="lucide:user-plus" class="h-5 w-5" aria-hidden="true" /></span> Guardar</a>
            <a href={mapa} target="_blank" rel="noopener"><span><Icon name="lucide:map-pin" class="h-5 w-5" aria-hidden="true" /></span> Cómo llegar</a>
          </div>
        </div>

        <section class="kz-tj-qr kz-in" style="background: var(--navy); --i: 5" aria-labelledby="qr-titulo">
          <div id="qr" class="kz-tj-qrimg" role="img" aria-label="Código QR de esta tarjeta"></div>
          <div class="kz-tj-qrtxt">
            <h2 id="qr-titulo">Compartí esta tarjeta</h2>
            <p>Escaneá el código o mandala a otro dueño de negocio.</p>
            <div class="kz-tj-qrbtn">
              <button type="button" id="compartir"><Icon name="lucide:share-2" class="h-4 w-4" aria-hidden="true" /> Compartir</button>
              <button type="button" id="copiar"><Icon name="lucide:link" class="h-4 w-4" aria-hidden="true" /> <span>Copiar enlace</span></button>
            </div>
          </div>
        </section>
      </div>

      <div class="kz-tj-col">
        <a href="/casos/" class="kz-tj-prueba kz-in" style="--i: 2" aria-label="Ver casos de éxito">
          <span><b>+US$450K</b><small>vendidos en línea</small></span>
          <span><b>+200</b><small>supermercados</small></span>
          <span><b>EE. UU.</b><small>restaurantes con KizerResto</small></span>
          <em>Ver los casos de éxito <Icon name="lucide:arrow-right" class="h-4 w-4" aria-hidden="true" /></em>
        </a>

        <section class="kz-in" style="--i: 3" aria-labelledby="tj-hacemos">
          <h2 id="tj-hacemos" class="kz-eyebrow mb-3">Lo que hacemos</h2>
          <nav aria-label="Lo que hacemos" class="kz-tj-lista">
            {lineas.map((l) => (
              <a href={l.href}>
                <span class="kz-tj-ic"><Icon name={l.icon} class="h-5 w-5" aria-hidden="true" /></span>
                <span class="min-w-0 flex-1"><b>{l.t}</b><small><i>{l.p}</i> · {l.d}</small></span>
                <Icon name="lucide:chevron-right" class="kz-tj-flecha h-4 w-4 shrink-0" aria-hidden="true" />
              </a>
            ))}
          </nav>
        </section>

        <ul class="kz-tj-garantias kz-in" style="--i: 4">
          <li><Icon name="lucide:check" class="h-4 w-4" aria-hidden="true" /> Diagnóstico gratis</li>
          <li><Icon name="lucide:check" class="h-4 w-4" aria-hidden="true" /> 30 días de garantía</li>
          <li><Icon name="lucide:check" class="h-4 w-4" aria-hidden="true" /> Código a tu nombre</li>
        </ul>
      </div>

      <footer class="kz-tj-pie kz-in" style="--i: 6">
        <a href={mapa} target="_blank" rel="noopener">
          <Icon name="lucide:map-pin" class="h-4 w-4" aria-hidden="true" /> Plaza Bendeck, El Progreso, Yoro
        </a>
        <span>Lunes a sábado, 7:00 a.m. a 6:00 p.m.</span>
        <a href="/">www.kizercode.com</a>
      </footer>
    </div>
  </main>
</Layout>

<script is:inline src="/vendor/qrcode-1.4.4.js"></script>
<script>
  // Socio: ?de=Nombre. Solo texto (textContent), recortado: viene de la URL.
  const de = (new URLSearchParams(location.search).get('de') ?? '').replace(/\s+/g, ' ').trim().slice(0, 60);
  if (de) {
    document.getElementById('ref')!.hidden = false;
    document.getElementById('ref-nombre')!.textContent = de;
    // LeadWhatsApp lee esto al hacer clic: el CRM anota quién lo refirió.
    document.body.dataset.servicio = `Referido por ${de}`;
    document.body.dataset.waEs = `Hola! Me recomendó ${de} y quiero información sobre Kizercode.`;
  }

  const url = new URL('/tarjeta/', location.origin);
  if (de) url.searchParams.set('de', de);
  const enlace = url.toString();

  const q = (window as any).qrcode?.(0, 'M');
  if (q) {
    q.addData(enlace);
    q.make();
    document.getElementById('qr')!.innerHTML = q.createSvgTag({ cellSize: 6, margin: 2, scalable: true });
  }

  const copiar = document.getElementById('copiar')!;
  copiar.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(enlace);
      copiar.querySelector('span')!.textContent = '¡Copiado!';
    } catch {
      prompt('Copiá este enlace:', enlace);
    }
  });
  document.getElementById('compartir')!.addEventListener('click', () => {
    const texto = 'Kizercode: punto de venta, sistemas, tiendas en línea e IA para tu negocio.';
    if (navigator.share) navigator.share({ title: 'Kizercode', text: texto, url: enlace }).catch(() => {});
    else window.open(`https://wa.me/?text=${encodeURIComponent(`${texto} ${enlace}`)}`, '_blank', 'noopener');
  });
</script>

<style>
  /* Fondo: el del hero del sitio (degradado, cuadrícula y resplandor verde). */
  .kz-tj { position: relative; overflow: hidden; min-height: 100svh; padding: 20px 16px 44px;
    background: linear-gradient(180deg, var(--bg2) 0%, var(--bg) 60%); }
  .kz-tj-rejilla { position: absolute; inset: 0; pointer-events: none;
    background-image: linear-gradient(color-mix(in srgb, var(--ink) 6%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--ink) 6%, transparent) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(ellipse 90% 55% at 50% 0%, #000 30%, transparent 100%); mask-image: radial-gradient(ellipse 90% 55% at 50% 0%, #000 30%, transparent 100%); }
  .kz-tj-brillo { position: absolute; left: 50%; top: -200px; width: 820px; height: 520px; transform: translateX(-50%); pointer-events: none;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--green) 22%, transparent), transparent); }

  .kz-tj-caja { position: relative; width: 100%; max-width: 460px; margin: 0 auto; display: flex; flex-direction: column; gap: 18px; }
  /* En el teléfono las columnas no existen: todo es una sola fila y el QR baja al final. */
  .kz-tj-col { display: contents; }
  .kz-tj-qr { order: 5; }
  .kz-tj-pie { order: 6; }

  /* ── La tarjeta ── */
  .kz-tj-card { position: relative; overflow: hidden; isolation: isolate; display: flex; flex-direction: column; gap: 16px;
    padding: 24px 24px 22px; border-radius: 28px; color: #fff;
    border: 1px solid rgba(255,255,255,.1);
    box-shadow: 0 30px 60px -20px rgba(11,26,51,.45), 0 0 0 1px rgba(11,26,51,.04); }
  .kz-tj-card-rejilla { position: absolute; inset: 0; z-index: -1;
    background-image: linear-gradient(rgba(255,255,255,.06) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.06) 1px, transparent 1px);
    background-size: 32px 32px;
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 100% 0%, #000 20%, transparent 100%); mask-image: radial-gradient(ellipse 80% 70% at 100% 0%, #000 20%, transparent 100%); }
  .kz-tj-card-luz { position: absolute; z-index: -1; right: -140px; top: -160px; width: 420px; height: 420px;
    background: radial-gradient(closest-side, rgba(62,211,154,.38), transparent); }
  .kz-tj-card-aro { position: absolute; z-index: -1; right: -90px; bottom: -110px; width: 260px; height: 260px; border-radius: 999px;
    border: 1px dashed rgba(62,211,154,.35); }
  /* Un solo destello al cargar, como una tarjeta que agarra la luz. */
  .kz-tj-card::after { content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(110deg, transparent 35%, rgba(255,255,255,.14) 50%, transparent 65%);
    transform: translateX(-120%); }

  .kz-tj-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .kz-tj-chip { display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; font-size: 11.5px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase;
    padding: 6px 12px; border-radius: 999px; border: 1px solid rgba(255,255,255,.2); background: rgba(255,255,255,.06); color: #dbe4f5; }
  .kz-tj-ref { display: flex; align-items: center; gap: 10px; padding: 11px 14px; border-radius: 14px;
    background: rgba(62,211,154,.14); border: 1px solid rgba(62,211,154,.45); color: var(--green-bright); font-size: 14.5px; font-weight: 500; }
  .kz-tj-ref[hidden] { display: none; }
  .kz-tj-ref strong { color: #fff; font-weight: 700; }
  .kz-tj-h1 { margin-top: 10px; font-size: clamp(40px, 12vw, 50px); line-height: 1.04; font-weight: 700; letter-spacing: -.03em; text-wrap: balance; }
  .kz-tj-h1 span { color: var(--green-bright); }
  .kz-tj-sub { font-size: 15.5px; line-height: 1.55; color: #c9d4ea; text-wrap: pretty; }
  .kz-tj-datos { display: flex; justify-content: space-between; gap: 12px; margin-top: 6px; padding-top: 16px;
    border-top: 1px solid rgba(255,255,255,.12);
    font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 13px; letter-spacing: .02em; color: #dbe4f5; }

  /* ── Acciones ── */
  .kz-tj-acciones { display: flex; flex-direction: column; gap: 10px; }
  .kz-tj-wa { min-height: 60px; border-radius: 16px; font-size: 17px; box-shadow: 0 14px 30px -10px color-mix(in srgb, var(--green-btn) 70%, transparent); }
  .kz-tj-wa:active, .kz-tj-tiles a:active { transform: scale(.98); }
  .kz-tj-tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .kz-tj-tiles a { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 14px 6px 12px; border-radius: 16px;
    background: var(--bg); border: 1px solid var(--line); font-size: 13px; font-weight: 600; color: var(--ink); text-align: center;
    transition: border-color .2s ease, color .2s ease, transform .15s ease; }
  .kz-tj-tiles a span { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: var(--green-soft); color: var(--green2); }
  .kz-tj-tiles a:hover { border-color: var(--green); color: var(--green2); }

  /* ── Prueba: números ── */
  .kz-tj-prueba { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px 8px; padding: 18px 14px 14px; border-radius: 18px;
    background: var(--bg); border: 1px solid var(--line); text-align: center; transition: border-color .2s ease; }
  .kz-tj-prueba:hover { border-color: var(--green); }
  .kz-tj-prueba b { display: block; font-size: 22px; font-weight: 700; color: var(--green); letter-spacing: -.02em; white-space: nowrap; }
  .kz-tj-prueba small { display: block; margin-top: 2px; font-size: 12px; line-height: 1.3; font-weight: 500; color: var(--ink2); }
  .kz-tj-prueba em { grid-column: 1 / -1; display: flex; align-items: center; justify-content: center; gap: 6px; padding-top: 12px;
    border-top: 1px solid var(--line); font-style: normal; font-size: 13.5px; font-weight: 600; color: var(--green2); }

  /* ── Servicios ── */
  .kz-tj-lista { display: flex; flex-direction: column; border-radius: 18px; overflow: hidden; background: var(--bg); border: 1px solid var(--line); }
  .kz-tj-lista a { display: flex; align-items: center; gap: 14px; padding: 14px 16px; color: var(--ink); transition: background-color .2s ease; }
  .kz-tj-lista a + a { border-top: 1px solid var(--line); }
  .kz-tj-lista a:hover { background: var(--green-soft); }
  .kz-tj-lista b { display: block; font-size: 15px; font-weight: 600; }
  .kz-tj-lista small { display: block; font-size: 13px; color: var(--ink2); }
  .kz-tj-lista i { font-style: normal; font-weight: 600; color: var(--green2); }
  .kz-tj-ic { display: grid; place-items: center; width: 42px; height: 42px; flex: none; border-radius: 12px; background: var(--green-soft); color: var(--green2); }
  .kz-tj-lista :global(.kz-tj-flecha) { color: var(--mute); transition: transform .2s ease, color .2s ease; }
  .kz-tj-lista a:hover :global(.kz-tj-flecha) { transform: translateX(3px); color: var(--green2); }

  .kz-tj-garantias { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; list-style: none; }
  .kz-tj-garantias li { display: flex; align-items: center; gap: 6px; padding: 7px 12px; border-radius: 999px;
    background: var(--green-soft); color: var(--green2); font-size: 12.5px; font-weight: 600; }

  /* ── QR ── */
  .kz-tj-qr { display: flex; align-items: center; gap: 16px; padding: 16px; border-radius: 22px; color: #fff; border: 1px solid rgba(255,255,255,.1); }
  .kz-tj-qrimg { width: 124px; flex: none; padding: 8px; border-radius: 14px; background: #fff; }
  .kz-tj-qrimg :global(svg) { display: block; width: 100%; height: auto; }
  .kz-tj-qrtxt { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 6px; }
  .kz-tj-qr h2 { font-size: 16.5px; font-weight: 700; letter-spacing: -.01em; }
  .kz-tj-qr p { font-size: 13px; line-height: 1.45; color: #c9d4ea; }
  .kz-tj-qrbtn { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
  .kz-tj-qrbtn button { display: inline-flex; align-items: center; gap: 6px; min-height: 40px; padding: 0 12px; border-radius: 10px; cursor: pointer;
    background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.18); color: #fff; font-size: 13px; font-weight: 600;
    transition: border-color .2s ease, color .2s ease; }
  .kz-tj-qrbtn button:hover { border-color: var(--green-bright); color: var(--green-bright); }

  .kz-tj-pie { display: flex; flex-direction: column; align-items: center; gap: 6px; padding-top: 6px; font-size: 13.5px; color: var(--mute); text-align: center; }
  .kz-tj-pie a { display: inline-flex; align-items: center; gap: 6px; color: var(--ink2); font-weight: 500; }
  .kz-tj-pie a:hover { color: var(--green2); }

  /* ── Pantalla ancha: tarjeta fija a la izquierda, contenido a la derecha ── */
  @media (min-width: 940px) {
    .kz-tj { padding: 56px 32px 64px; }
    .kz-tj-caja { max-width: 1000px; display: grid; grid-template-columns: 440px 1fr; gap: 20px 48px; align-items: start; }
    .kz-tj-col { display: flex; flex-direction: column; gap: 18px; }
    .kz-tj-fija { position: sticky; top: 32px; }
    .kz-tj-pie { grid-column: 1 / -1; flex-direction: row; justify-content: center; gap: 22px; padding-top: 20px; }
    .kz-tj-card { padding: 30px 30px 26px; }
  }

  /* Entrada escalonada. Sin movimiento, todo se ve desde el inicio. */
  @media (prefers-reduced-motion: no-preference) {
    .kz-in { animation: kz-tj-entra .6s cubic-bezier(.2,.7,.2,1) both; animation-delay: calc(var(--i) * 70ms); }
    .kz-tj-card::after { animation: kz-tj-destello 1.1s ease-out .5s both; }
  }
  @keyframes kz-tj-entra { from { opacity: 0; transform: translateY(14px); } }
  @keyframes kz-tj-destello { to { transform: translateX(120%); } }
</style>
