  <Footer />
  <FloatingWhatsApp />
</Layout>

<script is:inline src="/vendor/qrcode-1.4.4.js"></script>
<script>
  import { submitContact } from '@/lib/api';

  // Activar la tarjeta: registra al socio en el CRM (servicio "Programa de
  // socios") y le arma su enlace /tarjeta/?de=<nombre> con QR. Queda guardado
  // en este navegador para que vuelva a verlo.
  const CLAVE = 'kz-socio';
  const form = document.getElementById('act-form') as HTMLFormElement;
  const lista = document.getElementById('act-lista')!;
  const error = document.getElementById('act-error')!;
  const mock = document.getElementById('mock-nombre')!;

  // Vista previa: la tarjeta de muestra lleva el nombre mientras lo escriben.
  (form.elements.namedItem('name') as HTMLInputElement).addEventListener('input', (e) => {
    mock.textContent = (e.target as HTMLInputElement).value.trim().slice(0, 60) || 'Tu nombre';
  });

  // Calculadora de comisión.
  const rango = document.getElementById('calc') as HTMLInputElement;
  const lps = (n: number) => `L ${Math.round(n).toLocaleString('en-US')}`;
  const calcular = () => {
    document.getElementById('calc-precio')!.textContent = lps(+rango.value);
    document.getElementById('calc-com')!.textContent = lps(+rango.value * Number(rango.dataset.comision));
  };
  rango.addEventListener('input', calcular);
  calcular();

  function mostrar(nombre: string) {
    const url = new URL('/tarjeta/', location.origin);
    url.searchParams.set('de', nombre);
    const enlace = url.toString();
    form.hidden = true;
    lista.hidden = false;
    mock.textContent = nombre;
    document.getElementById('act-nombre')!.textContent = nombre;
    (document.getElementById('act-enlace') as HTMLInputElement).value = enlace;
    (document.getElementById('act-ver') as HTMLAnchorElement).href = enlace;
    const texto = `Te comparto la tarjeta de Kizercode. Hacen sistemas, punto de venta, tiendas en línea y páginas web para negocios. Escribiles desde aquí y deciles que vas de mi parte: ${enlace}`;
    (document.getElementById('act-wa') as HTMLAnchorElement).href = `https://wa.me/?text=${encodeURIComponent(texto)}`;
    const q = (window as any).qrcode?.(0, 'M');
    if (q) {
      q.addData(enlace);
      q.make();
      document.getElementById('act-qr')!.innerHTML = q.createSvgTag({ cellSize: 6, margin: 2, scalable: true });
    }
  }

  try {
    const ya = JSON.parse(localStorage.getItem(CLAVE) ?? 'null');
    if (ya?.nombre) mostrar(ya.nombre);
  } catch {}

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      error.textContent = 'Revisá tu nombre, correo y WhatsApp.';
      error.hidden = false;
      return;
    }
    const d = new FormData(form);
    const nombre = String(d.get('name')).replace(/\s+/g, ' ').trim().slice(0, 60);
    const boton = form.querySelector('button')!;
    boton.disabled = true;
    boton.textContent = 'Activando...';
    try {
      await submitContact({
        name: nombre,
        email: String(d.get('email')).trim(),
        phone: String(d.get('phone')).trim(),
        service: 'Programa de socios',
        message: `Activó su tarjeta de socio.\nEnlace: ${location.origin}/tarjeta/?de=${encodeURIComponent(nombre)}`,
      });
      try { localStorage.setItem(CLAVE, JSON.stringify({ nombre })); } catch {}
      (window as any).gtag?.('event', 'generate_lead', { method: 'socio' });
      mostrar(nombre);
    } catch {
      error.textContent = 'No se pudo activar. Probá otra vez o escribinos al WhatsApp 8809-1744.';
      error.hidden = false;
      boton.disabled = false;
      boton.textContent = 'Activar mi tarjeta';
    }
  });

  const copiar = document.getElementById('act-copiar')!;
  copiar.addEventListener('click', async () => {
    const v = (document.getElementById('act-enlace') as HTMLInputElement).value;
    try {
      await navigator.clipboard.writeText(v);
      copiar.querySelector('span')!.textContent = '¡Copiado!';
    } catch {
      (document.getElementById('act-enlace') as HTMLInputElement).select();
    }
  });
</script>

