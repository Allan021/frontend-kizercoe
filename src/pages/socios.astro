  .kz-mock-pie { display: flex; align-items: center; justify-content: space-between; padding-top: 10px; border-top: 1px solid rgba(255,255,255,.12);
    font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 11.5px; color: #c9d4ea; }

  .kz-so-rango { width: 100%; height: 28px; accent-color: var(--green); cursor: pointer; }

