  .kz-mock-chip { font-size: 10px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; padding: 4px 9px; border-radius: 999px; border: 1px solid rgba(255,255,255,.22); color: #dbe4f5; }
  .kz-mock-ref { display: flex; align-items: center; gap: 8px; padding: 8px 11px; border-radius: 11px; background: rgba(62,211,154,.14); border: 1px solid rgba(62,211,154,.45); color: var(--green-bright); font-size: 12.5px; }
  .kz-mock-ref span { min-width: 0; overflow-wrap: anywhere; }
