---
import { Icon } from 'astro-icon/components';
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import FloatingWhatsApp from '@/components/FloatingWhatsApp.astro';
import IdiomaPorUrl from '@/components/IdiomaPorUrl.astro';
import { servicios } from '@/lib/servicios';

/**
 * Programa de socios: contadores y asesores que refieren clientes a cambio
 * del 10 % del primer proyecto. Solo en español: es para Honduras.
 *
 * El socio activa su tarjeta en #activar (queda en el CRM como "Programa de
 * socios") y recibe /tarjeta/?de=<nombre> con QR.
 * Si cambia la comisión, cambiar COMISION y revisar el FAQ.
 */
const COMISION = 0.1;
const url = '/socios/';
const SERVICIO = 'Programa de socios';

const waReferir = `https://wa.me/50488091744?text=${encodeURIComponent('Hola! Soy socio de Kizercode y quiero referir un cliente.\n\nNegocio:\nContacto:\nQué necesita:')}`;

const lps = (n: number) => `L ${n.toLocaleString('en-US')}`;
const ejemplos = ['paginas-web', 'tiendas-en-linea', 'sistemas-a-la-medida']
  .map((slug) => servicios.find((s) => s.slug === slug)!)
  .map((s) => {
    const precio = Number(s.lps!.replace(/[^\d]/g, ''));
    return { nombre: s.nombre, precio: lps(precio), comision: lps(Math.round(precio * COMISION)) };
  });

const cifras = [
  { n: '10 %', l: 'del primer proyecto' },
  { n: 'L 0', l: 'costo para vos' },
  { n: '1 min', l: 'para activar tu tarjeta' },
];

const pasos = [
  { t: 'Activás tu tarjeta', d: 'Aquí abajo, en un minuto. Te llevás una tarjeta digital con tu nombre, con su enlace y su QR. Sin costo y sin exclusividad.' },
  { t: 'Se la pasás al cliente', d: 'Por WhatsApp o mostrándole el QR. Cuando nos escribe desde tu tarjeta, queda registrado como referido tuyo. Te confirmamos cada uno.' },
  { t: 'Nosotros vendemos', d: 'Hacemos el diagnóstico gratis y la cotización por escrito. Vos no tenés que vender ni saber de tecnología.' },
  { t: 'Cobrás el 10 %', d: 'Del valor del primer proyecto que el cliente contrate, a medida que el cliente paga. Si paga en cuotas, te pagamos el 10 % de cada una.' },
];

const senales = [
  { i: 'lucide:file-spreadsheet', t: 'El inventario vive en Excel', d: 'Y nunca cuadra con lo que hay en bodega.' },
  { i: 'lucide:calculator', t: 'El cierre del día es a mano', d: 'Alguien suma ventas, gastos y efectivo con calculadora.' },
  { i: 'lucide:notebook-pen', t: 'Préstamos o fiado en cuaderno', d: 'Cuotas, mora y saldos que solo entiende una persona.' },
  { i: 'lucide:fingerprint', t: 'Asistencia y planilla manual', d: 'Marcaje en papel y horas extra calculadas a ojo.' },
  { i: 'lucide:utensils', t: 'Restaurante con comandas en papel', d: 'Pedidos que se pierden entre la mesa y la cocina.' },
  { i: 'lucide:store', t: 'Vende solo en el local', d: 'Sin página ni tienda en línea, y contestando precios por WhatsApp todo el día.' },
];

const garantias = [
  'Precio fijo por escrito antes de empezar.',
  '30 días de garantía sobre lo entregado.',
  'Código, datos y dominio a nombre del cliente.',
  'Migración de sus datos desde Excel incluida.',
  'Sistemas con reportes y cierre del día: el cliente te llega con los números ordenados.',
];

const faq = [
  { q: '¿Cuánto gano por cada cliente?', a: 'El 10 % del valor del primer proyecto que el cliente contrate con Kizercode. Por ejemplo, L 2,500 por un sistema a la medida de L 25,000.' },
  { q: '¿Cuándo y cómo me pagan?', a: 'Cuando el cliente paga, por transferencia bancaria. Si el cliente paga en cuotas, te pagamos el 10 % de cada cuota a medida que entra.' },
  { q: '¿Tengo que vender o explicar la tecnología?', a: 'No. Solo nos presentás. El diagnóstico, la cotización y la venta los hacemos nosotros.' },
  { q: '¿Qué pasa si el cliente no compra?', a: 'No pasa nada y no te cuesta nada. Solo se paga comisión por proyectos contratados y pagados.' },
  { q: '¿Y si dos personas refieren al mismo cliente?', a: 'La comisión es de quien lo refirió primero. Por eso te confirmamos cada referido por WhatsApp apenas nos llega.' },
  { q: '¿Cuántos clientes puedo referir?', a: 'Los que quieras. No hay límite ni mínimo.' },
  { q: '¿Mi cliente paga más por venir referido?', a: 'No. El cliente paga exactamente el mismo precio; la comisión sale de nuestro margen.' },
  { q: '¿Quién puede ser socio?', a: 'Pensamos el programa para contadores, pero también aplica a asesores, consultores y cualquier persona que trate con dueños de negocio.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: 'Programa de socios de Kizercode',
      url: new URL(url, Astro.site).href,
      inLanguage: 'es-HN',
      about: { '@id': 'https://www.kizercode.com/#business' },
    },
    { '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Kizercode', item: 'https://www.kizercode.com/' },
        { '@type': 'ListItem', position: 2, name: 'Programa de socios', item: new URL(url, Astro.site).href },
      ],
    },
  ],
};

// Fondo del hero del inicio: cuadrícula que se desvanece.
const rejilla = 'background-image: linear-gradient(color-mix(in srgb, var(--ink) 6%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--ink) 6%, transparent) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, #000 30%, transparent 100%); -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, #000 30%, transparent 100%)';
---
<Layout
  title="Programa de socios para contadores: 10 % por referido | Kizercode"
  description="Contadores y asesores: referí clientes a Kizercode y ganá el 10 % de cada proyecto. Sin costo, sin vender y sin que tu cliente pague más."
  forzarLang="es"
  urlEs={url}
  soloEs
  servicio={SERVICIO}
  waEs="Hola! Quiero ser socio de Kizercode y referir clientes."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <Nav />
  <IdiomaPorUrl otra="/en/" />
  <main id="contenido">
    <header class="relative overflow-hidden" style="background: linear-gradient(180deg, var(--bg2) 0%, var(--bg) 100%)">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0" style={rejilla}></div>
      <div aria-hidden="true" class="pointer-events-none absolute left-1/2 -translate-x-1/2" style="top: -180px; width: 820px; height: 520px; background: radial-gradient(closest-side, color-mix(in srgb, var(--green) 22%, transparent), transparent)"></div>
      <div aria-hidden="true" class="pointer-events-none absolute rounded-full border" style="top: 120px; right: -120px; width: 360px; height: 360px; border-color: color-mix(in srgb, var(--green) 25%, transparent)"></div>
      <div aria-hidden="true" class="pointer-events-none absolute rounded-full border border-dashed" style="top: 160px; right: -80px; width: 280px; height: 280px; border-color: color-mix(in srgb, var(--green) 35%, transparent)"></div>
      <div aria-hidden="true" class="pointer-events-none absolute" style="top: 240px; left: -140px; width: 320px; height: 320px; border-radius: 32px; transform: rotate(18deg); border: 1px solid color-mix(in srgb, var(--ink) 10%, transparent); background: color-mix(in srgb, var(--green) 4%, transparent)"></div>

      <div aria-hidden="true" class="kz-so-flotante" style="top: 110px; left: 4%"><span class="kz-latido"></span> Tu cliente paga lo mismo</div>
      <div aria-hidden="true" class="kz-so-flotante kz-flotante-navy" style="top: 150px; right: 4%"><span class="kz-latido" style="background: var(--green-bright)"></span> Pago por transferencia</div>
      <div aria-hidden="true" class="kz-so-flotante" style="top: 400px; left: 3%"><Icon name="lucide:qr-code" class="h-4 w-4" style="color: var(--green2)" /> Tarjeta con tu QR</div>
      <div aria-hidden="true" class="kz-so-flotante" style="top: 420px; right: 3%"><Icon name="lucide:handshake" class="h-4 w-4" style="color: var(--green2)" /> Vos presentás, nosotros vendemos</div>

      <div class="relative mx-auto flex max-w-[900px] flex-col items-center gap-6 px-6 pb-14 pt-16 text-center sm:pt-[84px]">
        <p class="kz-badge border" style="border-color: color-mix(in srgb, var(--green) 30%, transparent); padding: 7px 14px; font-size: 13px">
          <span class="kz-latido"></span> Programa de socios para contadores
        </p>
        <h1 class="font-bold" style="font-size: clamp(36px, 5.2vw, 62px); line-height: 1.08; letter-spacing: -0.02em; text-wrap: balance">
          Referí clientes y ganá <span style="color: var(--green)">el 10 % de cada proyecto.</span>
        </h1>
        <p class="max-w-[640px] text-[18px] leading-relaxed" style="color: var(--ink2); text-wrap: pretty">
          Para contadores y asesores que ven todos los días negocios atrapados en Excel y cuadernos. Vos nos presentás, nosotros hacemos el resto, y tu cliente no paga un lempira más.
        </p>

        <ul class="grid w-full max-w-[620px] list-none grid-cols-3 gap-3 pt-1">
          {cifras.map((s) => (
            <li class="flex flex-col gap-1 rounded-[14px] border px-2 py-4" style="background: var(--bg); border-color: var(--line)">
              <span class="font-bold" style="font-size: clamp(22px, 4vw, 30px); letter-spacing: -0.02em; color: var(--green)">{s.n}</span>
              <span class="text-[12.5px] font-medium leading-snug" style="color: var(--ink2)">{s.l}</span>
            </li>
          ))}
        </ul>

        <div class="flex flex-wrap justify-center gap-3">
          <a href="#activar" class="kz-btn kz-btn-primario" style="padding: 16px 28px; font-size: 16px">
            <Icon name="lucide:badge-check" class="h-5 w-5" aria-hidden="true" /> Activar mi tarjeta de socio
          </a>
          <a href={waReferir} target="_blank" rel="noopener noreferrer" data-servicio={SERVICIO} class="kz-btn kz-btn-secundario" style="padding: 16px 28px; font-size: 16px; background: var(--bg)">Ya soy socio: referir un cliente</a>
        </div>
        <p class="text-[13.5px]" style="color: var(--mute)">Sin costo · Sin exclusividad · Sin mínimo de referidos</p>
      </div>
    </header>

    <div class="mx-auto flex max-w-[1100px] flex-col gap-24 px-6 pb-24 pt-6">
      <section aria-labelledby="como">
        <p class="kz-eyebrow mb-3 text-center">Cuatro pasos</p>
        <h2 id="como" class="kz-h2 mb-10 text-center">Cómo funciona</h2>
        <ol class="kz-so-pasos grid list-none gap-4" style="grid-template-columns: repeat(auto-fit, minmax(230px, 1fr))">
          {pasos.map((p, i) => (
            <li class="kz-card relative flex flex-col gap-2 overflow-hidden p-6">
              <span aria-hidden="true" class="kz-so-num">0{i + 1}</span>
              <span class="flex h-10 w-10 items-center justify-center rounded-xl text-[15px] font-bold" style="background: var(--green-soft); color: var(--green2)">{i + 1}</span>
              <p class="mt-2 text-[17px] font-bold">{p.t}</p>
              <p class="text-[15px] leading-relaxed" style="color: var(--ink2)">{p.d}</p>
            </li>
          ))}
        </ol>
      </section>

      <section id="activar" aria-labelledby="activar-titulo" class="mx-auto w-full max-w-[980px] scroll-mt-24">
        <div class="relative isolate grid gap-10 overflow-hidden rounded-[28px] p-6 sm:p-10 md:grid-cols-2 md:p-12" style="background: var(--navy); color: #fff">
          <div aria-hidden="true" class="kz-act-rejilla"></div>
          <div aria-hidden="true" class="kz-act-luz"></div>

          <div class="flex min-w-0 flex-col gap-4">
            <p class="kz-eyebrow" style="color: var(--green-bright)">Tarjeta de socio</p>
            <h2 id="activar-titulo" class="font-bold leading-tight" style="font-size: clamp(28px, 3.4vw, 36px); letter-spacing: -0.02em; text-wrap: balance">Activá tu tarjeta digital en un minuto.</h2>
            <p class="text-[15.5px] leading-relaxed" style="color: #c9d4ea">
              Es la tarjeta de Kizercode con tu nombre. Mandala por WhatsApp o mostrá el QR. Cada cliente que nos escriba desde ahí queda registrado como tuyo.
            </p>

            <!-- Vista previa: el nombre se actualiza mientras lo escriben. -->
            <div class="kz-mock" aria-hidden="true">
              <div class="flex items-center justify-between gap-3">
                <img src="/logo-oscuro.webp" alt="" width="96" height="32" class="h-7 w-auto" loading="lazy" />
                <span class="kz-mock-chip">Tarjeta de socio</span>
              </div>
              <p class="kz-mock-ref"><Icon name="lucide:handshake" class="h-4 w-4 shrink-0" /> <span>Te lo recomienda <strong id="mock-nombre">Tu nombre</strong></span></p>
              <p class="kz-mock-h">Tu negocio, <span>en sistema.</span></p>
              <div class="kz-mock-pie"><span>kizercode.com/tarjeta</span><Icon name="lucide:qr-code" class="h-7 w-7" /></div>
            </div>
            <a href="/tarjeta/" target="_blank" class="text-[14px] font-semibold underline underline-offset-4" style="color: var(--green-bright)">Ver la tarjeta completa →</a>
          </div>

          <form id="act-form" class="kz-act-panel flex flex-col gap-4 self-start" novalidate>
            <label class="kz-act-campo"><span>Tu nombre completo</span><input name="name" required minlength="3" maxlength="60" autocomplete="name" placeholder="Ej. Lic. Ana Martínez" /></label>
            <label class="kz-act-campo"><span>Tu correo</span><input name="email" type="email" required maxlength="254" autocomplete="email" inputmode="email" placeholder="tu@correo.com" /></label>
            <label class="kz-act-campo"><span>Tu WhatsApp</span><input name="phone" type="tel" required minlength="8" maxlength="20" autocomplete="tel" inputmode="tel" placeholder="9999-9999" /></label>
            <p id="act-error" class="text-[14px]" style="color: #ff8a8a" hidden></p>
            <button type="submit" class="kz-btn kz-btn-primario mt-1" style="min-height: 54px; font-size: 16px">Activar mi tarjeta</button>
            <ul class="flex list-none flex-wrap gap-x-4 gap-y-1 text-[12.5px]" style="color: #c9d4ea">
              {['Gratis', 'Sin exclusividad', 'Lista al instante'].map((x) => (
                <li class="flex items-center gap-1.5"><Icon name="lucide:check" class="h-3.5 w-3.5" style="color: var(--green-bright)" aria-hidden="true" /> {x}</li>
              ))}
            </ul>
            <p class="text-[12.5px]" style="color: #8fa0bf">Al activarla aceptás los <a href="/terminos/" class="underline">términos</a> y el <a href="/privacidad/" class="underline">aviso de privacidad</a>.</p>
          </form>

          <div id="act-lista" class="kz-act-panel flex min-w-0 flex-col gap-5 self-start" hidden>
            <p class="flex items-center gap-2 text-[18px] font-bold leading-snug" style="color: var(--green-bright)"><Icon name="lucide:badge-check" class="h-6 w-6 shrink-0" aria-hidden="true" /> <span>Tu tarjeta está activa, <span id="act-nombre"></span>.</span></p>
            <div id="act-qr" class="mx-auto w-[190px] rounded-2xl bg-white p-2.5" role="img" aria-label="QR de tu tarjeta de socio"></div>
            <div class="flex w-full min-w-0 flex-col gap-3">
              <input id="act-enlace" readonly aria-label="Enlace de tu tarjeta" class="w-full rounded-xl px-4 py-3 text-[14px]" style="background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.2); color: #fff" />
              <a id="act-wa" target="_blank" rel="noopener noreferrer" class="kz-btn kz-btn-primario" style="min-height: 52px"><Icon name="lucide:send" class="h-5 w-5" aria-hidden="true" /> Mandarla por WhatsApp</a>
              <div class="grid grid-cols-2 gap-3">
                <button type="button" id="act-copiar" class="kz-btn kz-act-sec"><Icon name="lucide:copy" class="h-5 w-5" aria-hidden="true" /> <span>Copiar</span></button>
                <a id="act-ver" target="_blank" class="kz-btn kz-act-sec"><Icon name="lucide:external-link" class="h-5 w-5" aria-hidden="true" /> Abrir</a>
              </div>
              <p class="text-[13px]" style="color: #8fa0bf">Guardá este enlace: es tu tarjeta. Si lo perdés, volvé a esta página desde el mismo teléfono.</p>
            </div>
          </div>
        </div>
      </section>

      <section aria-labelledby="cuanto">
        <p class="kz-eyebrow mb-3 text-center">Comisión</p>
        <h2 id="cuanto" class="kz-h2 mb-3 text-center">Cuánto ganás</h2>
        <p class="mx-auto mb-10 max-w-[600px] text-center text-[16px] leading-relaxed" style="color: var(--ink2)">
          El 10 % de lo que el cliente paga por su primer proyecto. Mové la barra y mirá tu comisión.
        </p>
        <div class="grid gap-4 md:grid-cols-[1.15fr_1fr]">
          <div class="kz-card flex flex-col justify-center gap-5 p-7 sm:p-9" style="background: var(--bg2)">
            <label for="calc" class="flex flex-wrap items-baseline justify-between gap-2 text-[15px] font-semibold" style="color: var(--ink2)">
              Si el proyecto de tu cliente vale <output id="calc-precio" for="calc" class="text-[22px] font-bold" style="color: var(--ink)">L 25,000</output>
            </label>
            <input id="calc" type="range" min="3000" max="200000" step="1000" value="25000" data-comision={COMISION} class="kz-so-rango" />
            <div class="flex flex-wrap items-end justify-between gap-3 border-t pt-5" style="border-color: var(--line)">
              <span class="text-[15px] font-semibold" style="color: var(--ink2)">Vos ganás</span>
              <output id="calc-com" for="calc" class="font-bold leading-none" style="font-size: clamp(44px, 8vw, 64px); letter-spacing: -0.03em; color: var(--green)">L 2,500</output>
            </div>
          </div>
          <ul class="flex list-none flex-col gap-4">
            {ejemplos.map((e) => (
              <li class="kz-card flex flex-1 items-center justify-between gap-4 p-5">
                <span>
                  <span class="block text-[16px] font-bold">{e.nombre}</span>
                  <span class="text-[14px]" style="color: var(--mute)">desde {e.precio}</span>
                </span>
                <span class="text-right">
                  <span class="block whitespace-nowrap font-bold leading-none" style="font-size: 28px; letter-spacing: -0.02em; color: var(--green2)">{e.comision}</span>
                  <span class="text-[13px]" style="color: var(--mute)">para vos</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
        <p class="mt-5 text-center text-[14px]" style="color: var(--mute)">Los proyectos grandes valen más: la comisión crece con el proyecto.</p>
      </section>

      <section aria-labelledby="quien">
        <p class="kz-eyebrow mb-3 text-center">A quién presentarnos</p>
        <h2 id="quien" class="kz-h2 mb-3 text-center">Qué clientes referir</h2>
        <p class="mx-auto mb-10 max-w-[600px] text-center text-[16px] leading-relaxed" style="color: var(--ink2)">
          Si un cliente tuyo tiene alguna de estas señales, ya está perdiendo plata sin sistema:
        </p>
        <ul class="grid list-none gap-4" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr))">
          {senales.map((s) => (
            <li class="kz-card flex gap-4 p-5">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl" style="background: var(--green-soft); color: var(--green2)"><Icon name={s.i} class="h-5 w-5" aria-hidden="true" /></span>
              <span>
                <span class="block text-[16px] font-bold">{s.t}</span>
                <span class="text-[14.5px] leading-relaxed" style="color: var(--ink2)">{s.d}</span>
              </span>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="quedas" class="grid gap-8 rounded-[28px] border p-7 sm:p-10 md:grid-cols-2 md:items-center" style="background: var(--bg2); border-color: var(--line)">
        <div>
          <p class="kz-eyebrow mb-3">Tu recomendación, cuidada</p>
          <h2 id="quedas" class="kz-h2 mb-4">Quedás bien con tu cliente</h2>
          <p class="text-[16px] leading-relaxed" style="color: var(--ink2)">
            Tu nombre va de por medio cuando recomendás a alguien. Por eso trabajamos igual con cada referido:
          </p>
        </div>
        <ul class="flex list-none flex-col gap-3">
          {garantias.map((x) => (
            <li class="flex items-start gap-3 rounded-[14px] border p-4 text-[15.5px]" style="background: var(--bg); border-color: var(--line)">
              <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full" style="background: var(--green-soft); color: var(--green2)"><Icon name="lucide:check" class="h-3.5 w-3.5" aria-hidden="true" /></span>
              {x}
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="preguntas" class="mx-auto w-full max-w-[860px]">
        <p class="kz-eyebrow mb-3 text-center">Dudas</p>
        <h2 id="preguntas" class="kz-h2 mb-8 text-center">Preguntas frecuentes</h2>
        <div class="flex flex-col gap-3">
          {faq.map((f) => (
            <details class="kz-card kz-so-faq">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
        <p class="mt-6 text-center text-[14px]" style="color: var(--mute)">
          La comisión aplica al primer proyecto contratado y pagado por cada cliente referido. Aplican nuestros <a href="/terminos/" style="text-decoration: underline">términos y condiciones</a>.
        </p>
      </section>

      <section class="relative isolate flex flex-col items-center gap-5 overflow-hidden rounded-[28px] px-6 py-14 text-center" style="background: var(--navy); color: #fff">
        <div aria-hidden="true" class="kz-act-rejilla"></div>
        <div aria-hidden="true" class="kz-act-luz kz-act-luz-centro"></div>
        <p class="font-bold leading-tight" style="font-size: clamp(28px, 3.6vw, 40px); letter-spacing: -0.02em; text-wrap: balance">¿Tenés clientes que necesitan <span style="color: var(--green-bright)">dejar Excel?</span></p>
        <p class="max-w-[540px] text-[16px]" style="color: #c9d4ea">Activá tu tarjeta y empezá a referir hoy.</p>
        <a href="#activar" class="kz-btn kz-btn-primario" style="padding: 16px 28px; font-size: 16px"><Icon name="lucide:badge-check" class="h-5 w-5" aria-hidden="true" /> Activar mi tarjeta de socio</a>
      </section>
