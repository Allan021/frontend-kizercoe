---
import IndustriaPage from '@/components/IndustriaPage.astro';
import { industrias } from '@/lib/industrias';

export function getStaticPaths() {
  return industrias.map((i) => ({ params: { slug: i.slugEn }, props: { industria: i } }));
}
const { industria } = Astro.props;
---
<IndustriaPage industria={industria} lang="en" />
