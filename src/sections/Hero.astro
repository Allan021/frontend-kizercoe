---
import { Icon } from 'astro-icon/components';
import Logo from '@/components/Logo.astro';

/** Lo que la tarjeta de la derecha resume. Sin cifras que nadie pueda sostener. */
const practicas = [
  { icon: 'lucide:box', en: 'Custom software', es: 'Software a la medida' },
  { icon: 'lucide:bot', en: 'AI automation', es: 'Automatización con IA' },
  { icon: 'lucide:megaphone', en: 'Digital marketing', es: 'Marketing digital' },
  { icon: 'lucide:wrench', en: 'Device repair', es: 'Reparación de equipos' },
];

/**
 * El mapa de "¿qué buscás?": cada chip lleva a la pestaña exacta de servicios
 * (el hash lo resuelve un script en Services.astro) o a productos. Es la ruta
 * corta para quien llegó buscando UNA cosa y no quiere leer toda la página.
 */
const rutas = [
  { icon: 'lucide:globe', en: 'A website', es: 'Una página web', href: '#software' },
  { icon: 'lucide:smartphone', en: 'A mobile app', es: 'Una app móvil', href: '#software' },
  { icon: 'lucide:boxes', en: 'A system for my business', es: 'Un sistema para mi negocio', href: '#software' },
  { icon: 'lucide:bot', en: 'Automate with AI', es: 'Automatizar con IA', href: '#ia' },
  { icon: 'lucide:megaphone', en: 'Ads and marketing', es: 'Publicidad y marketing', href: '#marketing' },
  { icon: 'lucide:wrench', en: 'Fix my computer or phone', es: 'Reparar mi compu o teléfono', href: '#taller' },
  { icon: 'lucide:rocket', en: 'Ready-to-use software', es: 'Software listo para usar', href: '#productos' },
];

const garantias = [
  { en: '24/7 support, we stay with you', es: 'Acompañamiento 24/7' },
  { en: 'Delivered in weeks, not months', es: 'Entregas en semanas, no meses' },
  { en: 'Built for your business, no templates', es: 'Hecho para tu negocio, sin plantillas' },
  { en: 'Fixed price', es: 'Precio fijo' },
  { en: 'Code under your name', es: 'Código a tu nombre' },
];
---

<section
  class="relative overflow-hidden pb-16 pt-24 sm:pb-20 sm:pt-28"
  aria-labelledby="hero-title"
>
  <!-- Resplandor azul detrás del titular. Es lo que separa el fondo plano de
       algo con profundidad: una elipse difuminada, no una sombra.
       `closest-side` hace que el degradado muera justo en el borde del div, así
       no se ve el corte. aria-hidden porque es decoración pura. -->
  <div
    aria-hidden="true"
    class="kz-resplandor pointer-events-none absolute left-1/2 h-[700px] w-[1100px] -translate-x-1/2"
    style="top:-380px;background:radial-gradient(closest-side, color-mix(in srgb, var(--color-accent-strong) 28%, transparent), transparent)"
  >
  </div>

  <!-- Rejilla, encima del resplandor. -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-[0.35]"
    style="background-image:linear-gradient(var(--color-border) 1px,transparent 1px),linear-gradient(90deg,var(--color-border) 1px,transparent 1px);background-size:64px 64px;mask-image:radial-gradient(ellipse 80% 55% at 50% 0%,#000 40%,transparent 100%)"
  >
  </div>

  <div class="relative mx-auto grid max-w-6xl gap-14 px-6 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
    <!-- ── Columna de texto ── -->
    <div>
      <!-- Pastilla con el punto que late: dice "estamos abiertos" sin escribirlo. -->
      <p class="kz-rise kz-pastilla">
        <span class="kz-latido" aria-hidden="true"></span>
        <span class="en">Software · AI · Marketing · Repairs</span>
        <span class="es">Software · IA · Marketing · Reparaciones</span>
      </p>

      <h1
        id="hero-title"
        class="kz-rise kz-rise-1 mt-5 text-balance text-4xl font-bold leading-[1.1] tracking-tight sm:text-5xl"
      >
        <!-- Sin <br/> forzado: text-balance reparte las líneas parejo en los
             dos idiomas; un quiebre a mano deja una palabra huérfana en uno. -->
        <span class="en">Your business, online <span class="kz-degradado">without spending a fortune.</span></span>
        <span class="es">Tu negocio, en línea <span class="kz-degradado">sin gastar una millonada.</span></span>
      </h1>

      <p
        class="kz-rise kz-rise-2 mt-6 max-w-xl text-base leading-relaxed sm:text-lg"
        style="color: var(--color-muted)"
      >
        <span class="en">
          Websites of every kind, mobile apps, custom systems, AI automation, digital marketing,
          and computer and phone repair. One team, one person accountable.
        </span>
        <span class="es">
          Páginas web de todo tipo, apps móviles, sistemas a la medida, automatización con IA,
          marketing digital y reparación de computadoras y teléfonos. Un solo equipo, un solo
          responsable.
        </span>
      </p>

      <div class="kz-rise kz-rise-3 mt-9 flex flex-wrap gap-3">
        <a href="#contact" class="kz-btn kz-btn-primario">
          <span class="en">Quote my project</span><span class="es">Cotizar mi proyecto</span>
          <Icon name="lucide:arrow-right" size={17} aria-hidden="true" />
        </a>
        <!-- La puerta que todo el mundo sabe usar: en Honduras se escribe por
             WhatsApp, no se llenan formularios. -->
        <a
          href="https://wa.me/50498622160?text=Hola!%20Quiero%20hacer%20una%20cita%20con%20Kizercode."
          target="_blank"
          rel="noopener noreferrer"
          class="kz-btn kz-btn-secundario"
        >
          <Icon name="lucide:message-circle" size={17} aria-hidden="true" style="color: #25d366" />
          <span class="en">WhatsApp us</span><span class="es">Escribinos al WhatsApp</span>
        </a>
      </div>

      <!-- La ruta corta: quien llegó buscando UNA cosa, la toca y cae donde es. -->
      <nav class="kz-rise kz-rise-4 mt-9" aria-label="Qué buscás">
        <p class="kz-eyebrow">// <span class="en">what do you need?</span><span class="es">¿qué buscás?</span></p>
        <ul class="mt-3 flex list-none flex-wrap gap-2">
          {
            rutas.map((r) => (
              <li>
                <a href={r.href} class="kz-ruta">
                  <Icon name={r.icon} size={14} aria-hidden="true" />
                  <span class="en">{r.en}</span><span class="es">{r.es}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Lista de verdad, no divs: son tres cosas enumerables. -->
      <ul
        class="kz-rise kz-rise-4 mt-8 flex list-none flex-wrap gap-x-6 gap-y-2 font-mono text-[12.5px]"
        style="color: var(--color-muted-2)"
      >
        {
          garantias.map((g) => (
            <li class="flex items-center gap-2">
              <Icon name="lucide:check" size={14} style="color: var(--color-accent)" aria-hidden="true" />
              <span class="en">{g.en}</span><span class="es">{g.es}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- ── Tarjeta de agencia ── -->
    <div class="kz-rise kz-rise-3">
      <div class="kz-card overflow-hidden">
        <div
          class="flex items-center justify-between border-b px-5 py-3.5"
          style="border-color: var(--color-border)"
        >
          <p class="font-mono text-[11.5px] uppercase tracking-[0.08em]" style="color: var(--color-muted-2)">
            kizercode / <span class="en">agency</span><span class="es">agencia</span>
          </p>
          <div class="flex gap-1.5" aria-hidden="true">
            <span class="h-2 w-2 rounded-full" style="background: var(--color-accent)"></span>
            <span class="h-2 w-2 rounded-full" style="background: var(--color-accent-soft); opacity:.6"></span>
            <span class="h-2 w-2 rounded-full" style="background: var(--color-muted-2); opacity:.4"></span>
          </div>
        </div>

        <div class="px-5 py-8">
          <div class="flex flex-col items-center gap-5">
            <Logo size={64} markOnly />
            <p class="font-mono text-[12px] tracking-[0.14em]" style="color: var(--color-muted-2)">
              <span class="en">DESIGN · BUILD · DEPLOY</span>
              <span class="es">DISEÑO · DESARROLLO · IMPLEMENTACIÓN</span>
            </p>
          </div>

          <ul class="mt-8 grid list-none grid-cols-2 gap-3">
            {
              practicas.map((p) => (
                <li
                  class="rounded-xl border p-3.5 text-center"
                  style="border-color: var(--color-border); background: var(--color-bg-2)"
                >
                  <Icon
                    name={p.icon}
                    size={20}
                    class="mx-auto"
                    style="color: var(--color-accent)"
                    aria-hidden="true"
                  />
                  <p class="mt-2.5 font-mono text-[10.5px] leading-snug" style="color: var(--color-muted)">
                    <span class="en">{p.en}</span><span class="es">{p.es}</span>
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .kz-ruta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 13px;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-card);
    font-size: 13px;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }
  .kz-ruta:hover {
    color: var(--color-text);
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }
  .kz-ruta svg { color: var(--color-accent); flex-shrink: 0; }

  .kz-degradado {
    background: linear-gradient(120deg, var(--color-accent-soft), var(--color-accent-strong));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* Entrada escalonada en CSS puro: sin GSAP, sin JavaScript, y no bloquea el
     primer pintado. Los elementos ya están en su sitio, solo se revelan. */
  @media (prefers-reduced-motion: no-preference) {
    .kz-rise {
      animation: kz-rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    }
    .kz-rise-1 { animation-delay: 0.06s; }
    .kz-rise-2 { animation-delay: 0.12s; }
    .kz-rise-3 { animation-delay: 0.18s; }
    .kz-rise-4 { animation-delay: 0.24s; }
  }

  @keyframes kz-rise {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: none; }
  }
</style>
