---
/**
 * Hero del rediseño: centrado, con cuadrícula y resplandor verde de fondo,
 * tarjetitas flotantes (ocultas < 1100px), stats, CTAs y chips de ruta.
 */
const stats = [
  { n: '5', l_en: 'Own products in production', l_es: 'Productos propios en producción' },
  { n_lps: 'L 4,000', n_usd: '$150', l_en: 'Websites from', l_es: 'Página web desde' },
  { n: '< 24 h', l_en: 'Response time', l_es: 'Tiempo de respuesta' },
  { n: '30 días', n_en: '30 days', l_en: 'Warranty included', l_es: 'Garantía incluida' },
];

const chips = [
  { en: 'A website', es: 'Una página web', href: '#precios' },
  { en: 'A system for my business', es: 'Un sistema para mi negocio', href: '#servicios' },
  { en: 'A mobile app', es: 'Una app móvil', href: '#precios' },
  { en: 'Automate with AI', es: 'Automatizar con IA', href: '#servicios' },
  { en: 'Ads and marketing', es: 'Publicidad y marketing', href: '#servicios' },
  { en: 'Fix my computer or phone', es: 'Reparar mi compu o teléfono', href: '#taller' },
  { en: 'Install security cameras', es: 'Instalar cámaras de seguridad', href: '/servicios/instalacion-camaras/' },
];

const techs = ['React', 'Next.js', 'Astro', 'TypeScript', 'Node.js', 'Rust', 'PostgreSQL', 'Flutter', 'Docker'];
---

<section id="top" class="relative overflow-hidden" style="background: linear-gradient(180deg, var(--bg2) 0%, var(--bg) 100%)">
  <!-- Cuadrícula y resplandor. Decoración: aria-hidden. -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0" style="background-image: linear-gradient(color-mix(in srgb, var(--ink) 6%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--ink) 6%, transparent) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, #000 30%, transparent 100%); -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, #000 30%, transparent 100%)"></div>
  <div aria-hidden="true" class="pointer-events-none absolute left-1/2 -translate-x-1/2" style="top: -180px; width: 820px; height: 520px; background: radial-gradient(closest-side, color-mix(in srgb, var(--green) 22%, transparent), transparent)"></div>
  <div aria-hidden="true" class="pointer-events-none absolute rounded-full border" style="top: 120px; right: -120px; width: 360px; height: 360px; border-color: color-mix(in srgb, var(--green) 25%, transparent)"></div>
  <div aria-hidden="true" class="pointer-events-none absolute rounded-full border border-dashed" style="top: 160px; right: -80px; width: 280px; height: 280px; border-color: color-mix(in srgb, var(--green) 35%, transparent)"></div>
  <div aria-hidden="true" class="pointer-events-none absolute" style="top: 240px; left: -140px; width: 320px; height: 320px; border-radius: 32px; transform: rotate(18deg); border: 1px solid color-mix(in srgb, var(--ink) 10%, transparent); background: color-mix(in srgb, var(--green) 4%, transparent)"></div>

  <!-- Tarjetitas flotantes (solo pantallas anchas) -->
  <div aria-hidden="true" class="kz-flotante" style="top: 96px; left: 3%">
    <span class="kz-latido"></span>
    <span class="en">Fixed price in writing</span><span class="es">Precio fijo por escrito</span>
  </div>
  <div aria-hidden="true" class="kz-flotante" style="top: 380px; left: 2%">
    <span style="font-family: ui-monospace, Menlo, monospace; color: var(--green2)">{'{K}'}</span>
    <span class="en">Code under your name</span><span class="es">Código a tu nombre</span>
  </div>
  <div aria-hidden="true" class="kz-flotante kz-flotante-navy" style="top: 140px; right: 3%">
    <span class="kz-latido" style="background: var(--green-bright)"></span>
    <span class="en">Delivered in weeks</span><span class="es">Entregas en semanas</span>
  </div>
  <div aria-hidden="true" class="kz-flotante" style="top: 400px; right: 2%">
    <img src="/whatsapp.svg" alt="" width="16" height="16" class="block" />
    <span class="en">Direct WhatsApp</span><span class="es">WhatsApp directo</span>
  </div>

  <div class="relative mx-auto flex max-w-[1200px] flex-col items-center gap-7 px-6 pb-14 pt-16 text-center sm:pt-[88px]">
    <span class="kz-badge border" style="border-color: color-mix(in srgb, var(--green) 30%, transparent); padding: 7px 14px; font-size: 13px; white-space: nowrap">
      <span class="kz-latido"></span>
      <span class="en">Made in Honduras</span><span class="es">Hecho en Honduras</span>
    </span>

    <h1 class="max-w-[900px] font-bold" style="font-size: clamp(38px, 5.2vw, 64px); line-height: 1.08; letter-spacing: -0.02em; text-wrap: balance">
      <span class="en">Your software and web agency, <span style="color: var(--green)">right here in Honduras.</span></span>
      <span class="es">Tu agencia de software y web, <span style="color: var(--green)">aquí en Honduras.</span></span>
    </h1>

    <p class="max-w-[680px] text-lg leading-relaxed" style="color: var(--ink2); text-wrap: pretty">
      <span class="en">Websites, custom systems, apps and AI automation for businesses in Honduras and the world. Fixed price in writing, delivered in weeks, one person accountable.</span>
      <span class="es">Páginas web, sistemas a la medida, apps y automatización con IA para negocios hondureños y del mundo. Precio fijo por escrito, entregas en semanas y un solo responsable.</span>
    </p>

    <ul class="grid w-full max-w-[760px] list-none gap-3 pt-2" style="grid-template-columns: repeat(auto-fit, minmax(140px, 1fr))">
      {stats.map((s) => (
        <li class="flex flex-col gap-1 rounded-[14px] border p-4" style="background: var(--bg); border-color: var(--line)">
          <span class="text-3xl font-bold" style="letter-spacing: -0.02em; color: var(--green)">
            {s.n_lps ? (
              <><span class="lps">{s.n_lps}</span><span class="usd">{s.n_usd}</span></>
            ) : s.n_en ? (
              <><span class="en">{s.n_en}</span><span class="es">{s.n}</span></>
            ) : (
              s.n
            )}
          </span>
          <span class="text-[13px] font-medium" style="color: var(--ink2)">
            <span class="en">{s.l_en}</span><span class="es">{s.l_es}</span>
          </span>
        </li>
      ))}
    </ul>

    <div class="flex flex-wrap justify-center gap-3">
      <a href="#contacto" class="kz-btn kz-btn-primario" style="padding: 16px 28px; font-size: 16px">
        <span class="en">Free quote</span><span class="es">Cotización gratis</span>
      </a>
      <a href="#casos" class="kz-btn kz-btn-secundario" style="padding: 16px 28px; font-size: 16px">
        <span class="en">See our work</span><span class="es">Ver nuestro trabajo</span>
      </a>
    </div>

    <nav aria-label="Qué buscás" class="flex flex-wrap justify-center gap-2 pt-2">
      {chips.map((c) => (
        <a href={c.href} class="kz-chip transition-colors hover:border-[var(--green)] hover:text-[var(--green2)]">
          <span class="en">{c.en}</span><span class="es">{c.es}</span>
        </a>
      ))}
    </nav>
  </div>

  <div class="mx-auto flex max-w-[1200px] flex-col items-center gap-3.5 px-6 pb-10">
    <p class="text-xs font-semibold uppercase tracking-[0.08em]" style="color: var(--mute)">
      <span class="en">Technologies we use</span><span class="es">Tecnologías que usamos</span>
    </p>
    <div class="flex flex-wrap justify-center gap-x-7 gap-y-2.5">
      {techs.map((t) => <span class="text-[15px] font-bold" style="color: var(--mute)">{t}</span>)}
    </div>
  </div>
</section>

<style>
  .kz-flotante {
    position: absolute;
    pointer-events: none;
    display: none;
    align-items: center;
    gap: 10px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 10px 14px;
    box-shadow: 0 12px 30px rgba(11, 26, 51, 0.1);
    font-size: 12px;
    font-weight: 600;
    color: var(--ink2);
  }
  .kz-flotante-navy {
    background: var(--navy);
    color: var(--bg);
    border: 0;
    box-shadow: 0 12px 30px rgba(11, 26, 51, 0.18);
  }
  @media (min-width: 1100px) {
    .kz-flotante { display: flex; }
  }
</style>
