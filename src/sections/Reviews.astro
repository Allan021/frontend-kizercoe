---
import ReviewsList from '@/components/Reviews.tsx';
---

<section id="resenas" class="mx-auto w-full max-w-[1200px] px-6 py-20">
  <div class="mx-auto mb-9 flex max-w-[560px] flex-col items-center gap-2.5 text-center">
    <p class="kz-eyebrow"><span class="en">Success stories</span><span class="es">Historias de éxito</span></p>
    <h2 class="kz-h2">
      <span class="en">What our clients say</span>
      <span class="es">Lo que dicen nuestros clientes</span>
    </h2>
    <p class="text-base" style="color: var(--mute); text-wrap: pretty">
      <span class="en">Businesses in Honduras that already have their system, website or devices running.</span>
      <span class="es">Negocios en Honduras que ya tienen su sistema, su página o su equipo funcionando.</span>
    </p>
  </div>

  <!-- Los testimonios se cargan de la API y se administran desde /panel.
       Si no hay ninguno publicado, esta sección no muestra nada. -->
  <ReviewsList client:visible />
</section>
