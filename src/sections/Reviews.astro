---
import ReviewsList from '@/components/Reviews.tsx';
---

<section id="reviews" class="py-28 bg-bg overflow-hidden">
  <div class="px-6 md:px-[60px] max-w-[1200px] mx-auto mb-14">
    <div class="text-center" data-gsap="fade-up">
      <span class="section-tag center mb-5">
        <span class="en">Client Reviews</span><span class="es">Reseñas de Clientes</span>
      </span>
      <h2 class="text-4xl md:text-5xl font-black tracking-tight mt-4 mb-5">
        <span class="en">What our clients<br /><span class="gradient-text">actually say.</span></span>
        <span class="es">Lo que dicen<br /><span class="gradient-text">nuestros clientes.</span></span>
      </h2>
      <p class="text-muted text-lg max-w-[500px] mx-auto leading-relaxed">
        <span class="en">Don't take our word for it — here's what they say after going live.</span>
        <span class="es">No lo decimos nosotros — esto es lo que dicen tras el lanzamiento.</span>
      </p>
    </div>
  </div>

  <!-- Los testimonios se cargan de la API y se administran desde /panel.
       Si no hay ninguno publicado, esta sección no muestra nada. -->
  <ReviewsList client:visible />
</section>
