---
import ServicesList from '@/components/Services.tsx';
---

<!-- aria-labelledby ata la sección con su título: así un lector de pantalla
     anuncia "Qué construimos" al entrar, en vez de "sección". -->
<section id="services" class="py-24 sm:py-32" aria-labelledby="services-title">
  <div class="mx-auto max-w-6xl px-6">
    <header class="mb-12 max-w-2xl">
      <p class="kz-eyebrow">// qué construimos</p>
      <h2 id="services-title" class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
        <span class="en">Everything custom.<br />One person accountable.</span>
        <span class="es">Todo a la medida.<br />Un solo responsable.</span>
      </h2>
      <p class="mt-4 leading-relaxed" style="color: var(--color-muted)">
        <span class="en">Three practices, one team end to end. Switch tabs to see what each delivers.</span>
        <span class="es">Tres prácticas, un mismo equipo de principio a fin. Cambiá de pestaña para ver qué entrega cada una.</span>
      </p>
    </header>

    <!-- Se administran desde /panel. Sin servicios publicados, no se muestra nada. -->
    <ServicesList client:visible />
  </div>
</section>
