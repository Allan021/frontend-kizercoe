---
/**
 * Servicios del rediseño: 8 tarjetas numeradas + industrias. Reemplaza a las
 * pestañas con radios de la versión anterior: el diseño nuevo muestra todo de
 * un vistazo, sin pasos intermedios.
 */
const servicios = [
  { num: '01', t_en: 'Websites', t_es: 'Páginas web', d_en: 'Own design, not a template. Fast on mobile data, with WhatsApp and map.', d_es: 'Diseño propio, no plantilla. Rápida en celular con datos móviles, con WhatsApp y mapa.', href: '/servicios/paginas-web/', c_en: 'Learn more', c_es: 'Ver más' },
  { num: '02', t_en: 'Online stores', t_es: 'Tiendas en línea', d_en: 'Catalog, cart and payments, with a panel to upload your products yourself.', d_es: 'Catálogo, carrito y pagos, con panel para subir tus productos vos mismo.', href: '/servicios/tiendas-en-linea/', c_en: 'Learn more', c_es: 'Ver más' },
  { num: '03', t_en: 'Custom systems', t_es: 'Sistemas a la medida', d_en: 'Inventory, billing, orders and approvals as one system, with roles and live reports.', d_es: 'Inventario, facturación, pedidos y aprobaciones como un solo sistema, con roles y reportes en vivo.', href: '/servicios/sistemas-a-la-medida/', c_en: 'Learn more', c_es: 'Ver más' },
  { num: '04', t_en: 'Mobile apps', t_es: 'Apps móviles', d_en: 'iOS and Android from one codebase, connected to your system or store.', d_es: 'iOS y Android con una sola base de código, conectada a tu sistema o tienda.', href: '/servicios/apps-moviles/', c_en: 'Learn more', c_es: 'Ver más' },
  { num: '05', t_en: 'AI automation', t_es: 'Automatización con IA', d_en: 'Agents that answer, quote and log everything in your system. Clear rules, fully audited.', d_es: 'Agentes que atienden, cotizan y registran todo en tu sistema. Con reglas claras y todo auditado.', href: '/servicios/automatizacion-ia/', c_en: 'Learn more', c_es: 'Ver más' },
  { num: '06', t_en: 'Ads and SEO', t_es: 'Anuncios y SEO', d_en: 'Google and Meta campaigns with real tracking, and structure to show up when they search for you.', d_es: 'Campañas en Google y Meta con seguimiento real, y estructura para aparecer cuando te buscan.', href: '/servicios/anuncios/', c_en: 'Learn more', c_es: 'Ver más' },
  { num: '07', t_en: 'Custom CRM', t_es: 'CRM a la medida', d_en: 'Customers, follow-ups and quotes in one place, connected to WhatsApp and with no per-user licenses.', d_es: 'Clientes, seguimientos y cotizaciones en un solo lugar, conectado a WhatsApp y sin licencias por usuario.', href: '/servicios/crm-a-la-medida/', c_en: 'Learn more', c_es: 'Ver más' },
  { num: '08', t_en: 'Cameras and repair shop', t_es: 'Cámaras y taller', d_en: 'Security cameras installed, and computer and phone repair with a free diagnosis.', d_es: 'Instalación de cámaras de seguridad, y reparación de computadoras y celulares con diagnóstico gratis.', href: '/servicios/instalacion-camaras/', c_en: 'Learn more', c_es: 'Ver más' },
];

// Cada industria tiene página propia: el chip lleva ahí.
const industrias = [
  { en: 'Pharmacies', es: 'Farmacias', href: '/industrias/farmacias/' },
  { en: 'Hardware stores', es: 'Ferreterías', href: '/industrias/ferreterias/' },
  { en: 'Boutiques', es: 'Boutiques', href: '/industrias/boutiques/' },
  { en: 'Restaurants', es: 'Restaurantes', href: '/industrias/restaurantes/' },
  { en: 'Lenders', es: 'Prestamistas', href: '/industrias/prestamistas/' },
  { en: 'Clinics', es: 'Clínicas', href: '/industrias/clinicas/' },
  { en: 'Law firms', es: 'Abogados', href: '/industrias/abogados/' },
  { en: 'Real estate', es: 'Bienes raíces', href: '/industrias/bienes-raices/' },
  { en: 'Distributors', es: 'Distribuidoras', href: '/industrias/distribuidoras/' },
  { en: 'Workshops', es: 'Talleres', href: '/industrias/talleres/' },
];
---

<section id="servicios" class="border-y" style="background: var(--bg2); border-color: var(--line)">
  <div class="mx-auto flex max-w-[1200px] flex-col gap-9 px-6 py-20">
    <div class="mx-auto flex max-w-[560px] flex-col items-center gap-2.5 text-center">
      <p class="kz-eyebrow"><span class="en">Full-service agency</span><span class="es">Agencia de servicio completo</span></p>
      <h2 id="services-title" class="kz-h2">
        <span class="en">Everything custom. One person accountable.</span>
        <span class="es">Todo a la medida. Un solo responsable.</span>
      </h2>
      <p class="text-base" style="color: var(--mute); text-wrap: pretty">
        <span class="en">From the website to the full system with its hardware installed: one team end to end.</span>
        <span class="es">Desde la página web hasta el sistema completo con su equipo instalado: un mismo equipo de principio a fin.</span>
      </p>
    </div>

    <ul class="grid list-none gap-4" style="grid-template-columns: repeat(auto-fit, minmax(260px, 1fr))">
      {servicios.map((s) => (
        <li>
          <article class="kz-card flex h-full flex-col gap-3 p-6">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl text-[13px] font-bold" style="background: var(--green-soft); color: var(--green2); font-family: ui-monospace, Menlo, monospace">{s.num}</span>
            <h3 class="text-lg font-bold leading-snug"><span class="en">{s.t_en}</span><span class="es">{s.t_es}</span></h3>
            <p class="text-sm leading-relaxed" style="color: var(--ink2); text-wrap: pretty"><span class="en">{s.d_en}</span><span class="es">{s.d_es}</span></p>
            <a href={s.href} class="mt-auto text-[13px] font-semibold transition-colors" style="color: var(--green2)">
              <span class="en">{s.c_en}</span><span class="es">{s.c_es}</span> →
            </a>
          </article>
        </li>
      ))}
    </ul>

    <div class="flex flex-col items-center gap-3 pt-2">
      <p class="text-[13px] font-medium" style="color: var(--mute)">
        <span class="en">Industries we work with</span><span class="es">Industrias con las que trabajamos</span>
      </p>
      <ul class="flex list-none flex-wrap justify-center gap-2">
        {industrias.map((i) => (
          <li>
            <a href={i.href} class="kz-chip inline-block transition-colors hover:border-[var(--green)] hover:text-[var(--green2)]" style="padding: 7px 13px">
              <span class="en">{i.en}</span><span class="es">{i.es}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
