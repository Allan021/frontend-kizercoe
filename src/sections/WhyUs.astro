---
/**
 * "Honduras → el mundo": la razón de elegir un equipo local, con el
 * comparativo de precio contra una agencia de afuera en tarjeta navy.
 */
const porque = [
  { t_en: 'Local team', t_es: 'Equipo local', d_en: 'Same time zone, same language. Meetings on WhatsApp or in person.', d_es: 'Mismo horario, mismo idioma. Reuniones por WhatsApp o en persona.' },
  { t_en: 'Pay in lempiras', t_es: 'Pago en lempiras', d_en: 'Transfer to Honduran banks, card or cash. No international fees.', d_es: 'Transferencia a bancos hondureños, tarjeta o efectivo. Sin comisiones internacionales.' },
  { t_en: 'Export-grade quality', t_es: 'Calidad de exportación', d_en: 'The same technologies and standards foreign agencies use.', d_es: 'Las mismas tecnologías y estándares que usan las agencias de afuera.' },
  { t_en: 'One person accountable', t_es: 'Un solo responsable', d_en: 'You talk to who designs and codes, not a middleman.', d_es: 'Hablás con quien diseña y programa, no con un intermediario.' },
];
---

<section id="porque" class="mx-auto grid w-full max-w-[1200px] items-center gap-12 px-6 py-20" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr))">
  <div class="flex flex-col gap-5">
    <p class="kz-eyebrow"><span class="en">Honduras → the world</span><span class="es">Honduras → el mundo</span></p>
    <h2 class="kz-h2">
      <span class="en">World-class software, made in Honduras.</span>
      <span class="es">Software de clase mundial, hecho en Honduras.</span>
    </h2>
    <p class="text-[17px] leading-relaxed" style="color: var(--ink2); text-wrap: pretty">
      <span class="en">The same technologies and standards foreign agencies use, with the advantage of being your local team: same schedule, same language, pay in lempiras.</span>
      <span class="es">Las mismas tecnologías y estándares que usan las agencias de afuera, con la ventaja de ser tu equipo local: mismo horario, mismo idioma, pago en lempiras.</span>
    </p>
    <div class="grid gap-3" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr))">
      {porque.map((p) => (
        <div class="flex flex-col gap-1.5 rounded-[14px] border p-4" style="background: var(--bg2); border-color: var(--line)">
          <strong class="text-[15px] font-semibold"><span class="en">{p.t_en}</span><span class="es">{p.t_es}</span></strong>
          <span class="text-[13px] leading-relaxed" style="color: var(--ink2)"><span class="en">{p.d_en}</span><span class="es">{p.d_es}</span></span>
        </div>
      ))}
    </div>
  </div>

  <div class="flex flex-col gap-5 rounded-[20px] p-7" style="background: var(--navy); color: var(--bg)">
    <div class="flex flex-col gap-1">
      <span class="text-xs font-semibold uppercase tracking-[0.08em]" style="color: var(--green-bright)">
        <span class="en">Price comparison</span><span class="es">Comparación de precio</span>
      </span>
      <strong class="text-lg font-semibold"><span class="en">A system for your business</span><span class="es">Un sistema para tu negocio</span></strong>
    </div>
    <div class="grid items-center gap-3.5" style="grid-template-columns: 1fr auto 1fr">
      <div class="flex flex-col gap-1 rounded-[14px] p-4" style="background: color-mix(in srgb, var(--bg) 8%, transparent)">
        <span class="text-xs" style="color: color-mix(in srgb, var(--bg) 65%, transparent)"><span class="en">US agency</span><span class="es">Agencia en EE. UU.</span></span>
        <strong class="text-2xl font-bold" style="letter-spacing: -0.02em">$10,000+</strong>
        <span class="text-xs" style="color: color-mix(in srgb, var(--bg) 65%, transparent)"><span class="en">market average</span><span class="es">precio promedio del mercado</span></span>
      </div>
      <span class="text-xs font-bold" style="color: color-mix(in srgb, var(--bg) 50%, transparent)">VS</span>
      <div class="flex flex-col gap-1 rounded-[14px] p-4 text-white" style="background: #16a36c">
        <span class="text-xs" style="color: rgba(255,255,255,.8)">Kizercode Honduras</span>
        <strong class="text-2xl font-bold" style="letter-spacing: -0.02em"><span class="lps">L 25,000</span><span class="usd">$950</span></strong>
        <span class="text-xs" style="color: rgba(255,255,255,.8)"><span class="en">same quality, local team</span><span class="es">misma calidad, equipo local</span></span>
      </div>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-3 border-t pt-4" style="border-color: color-mix(in srgb, var(--bg) 15%, transparent)">
      <span class="text-sm" style="color: color-mix(in srgb, var(--bg) 75%, transparent)">
        <span class="en">You save over <strong style="color: var(--green-bright)">90%</strong> and the code stays under your name.</span>
        <span class="es">Ahorrás más del <strong style="color: var(--green-bright)">90 %</strong> y el código queda a tu nombre.</span>
      </span>
      <a href="#contacto" class="rounded-[10px] px-4 py-2.5 text-sm font-semibold transition-colors" style="background: var(--bg); color: var(--navy)" onmouseover="this.style.background='#3ed39a'; this.style.color='#0b1a33'" onmouseout="this.style.background='var(--bg)'; this.style.color='var(--navy)'">
        <span class="en">Free quote</span><span class="es">Cotización gratis</span>
      </a>
    </div>
  </div>
</section>
