---
import { Icon } from 'astro-icon/components';

const razones = [
  {
    icon: 'lucide:server',
    en_t: 'We run our own products in production',
    es_t: 'Operamos nuestros propios productos en producción',
    en_d: "We don't only build for others. Kizer Check and Kizer POS run every day with real clients, and that's where our standard for uptime, support and updates comes from.",
    es_d: 'No solo construimos para terceros. Kizer Check y Kizer POS funcionan todos los días con clientes reales, y de ahí sale nuestro estándar de disponibilidad, soporte y actualizaciones.',
    destacada: true,
  },
  {
    icon: 'lucide:file-check',
    en_t: 'Fixed price, written scope',
    es_t: 'Precio fijo, alcance escrito',
    en_d: 'You know what you pay and what you get before we start. If the delay is ours, the price does not move.',
    es_d: 'Sabés qué pagás y qué recibís antes de empezar. Si el retraso es nuestro, el precio no se mueve.',
  },
  {
    icon: 'lucide:key-round',
    en_t: 'Everything under your name',
    es_t: 'Todo a tu nombre',
    en_d: 'Source code, domain, hosting and design files registered to your company. No strings attached.',
    es_d: 'Código fuente, dominio, hosting y archivos de diseño a nombre de tu empresa. Sin ataduras.',
  },
  {
    icon: 'lucide:message-square',
    en_t: 'One direct contact',
    es_t: 'Un contacto directo',
    en_d: 'You talk to whoever designs and codes your project, not to a middleman relaying messages.',
    es_d: 'Hablás con quien diseña y programa tu proyecto, no con un intermediario que traslada mensajes.',
  },
  {
    icon: 'lucide:truck',
    en_t: 'Hardware included',
    es_t: 'Equipo incluido',
    en_d: 'Few agencies hand over the machine installed and running. We do, and in the same proposal.',
    es_d: 'Pocas agencias entregan la máquina instalada y funcionando. Nosotros sí, y en la misma propuesta.',
  },
];
---

<section id="why" class="py-24 sm:py-32" aria-labelledby="why-title">
  <div class="mx-auto max-w-6xl px-6">
    <header class="mb-12 max-w-2xl">
      <p class="kz-eyebrow">// <span class="en">why kizercode</span><span class="es">por qué kizercode</span></p>
      <h2 id="why-title" class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
        <span class="en">Reasons that hold up<br />when you ask.</span>
        <span class="es">Razones que se sostienen<br />cuando preguntás.</span>
      </h2>
    </header>

    <ul class="grid list-none gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        razones.map((r) => (
          <li class={r.destacada ? 'md:col-span-2 lg:col-span-3' : ''}>
            <article class={`kz-card h-full p-7 ${r.destacada ? 'kz-card-principal' : ''}`}>
              <Icon name={r.icon} size={22} style="color: var(--color-accent)" aria-hidden="true" />
              <h3 class="mt-4 text-lg font-bold leading-snug">
                <span class="en">{r.en_t}</span><span class="es">{r.es_t}</span>
              </h3>
              <p class="mt-2.5 text-sm leading-relaxed" style="color: var(--color-muted)">
                <span class="en">{r.en_d}</span><span class="es">{r.es_d}</span>
              </p>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>
