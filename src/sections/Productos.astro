---
import { productos } from '@/lib/productos';

/** Productos propios en la portada: cada tarjeta lleva a su página. */
---

<section id="productos" class="mx-auto flex w-full max-w-[1200px] flex-col gap-9 px-6 py-20">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div class="flex max-w-[560px] flex-col gap-2.5">
      <p class="kz-eyebrow"><span class="en">Ready-to-use software</span><span class="es">Software listo para usar</span></p>
      <h2 id="productos-title" class="kz-h2" style="text-wrap: initial">
        <span class="en">Our own products, running today in real businesses.</span>
        <span class="es">Productos propios, corriendo hoy en negocios reales.</span>
      </h2>
    </div>
    <a href="/productos/" class="text-[15px] font-semibold" style="color: var(--green2)">
      <span class="en">See all products</span><span class="es">Ver todos los productos</span> →
    </a>
  </div>

  <ul class="grid list-none gap-4" style="grid-template-columns: repeat(auto-fit, minmax(210px, 1fr))">
    {productos.map((p) => (
      <li>
        <a href={`/productos/${p.slug}/`} class="kz-card flex h-full flex-col gap-3 rounded-2xl p-6" style="color: var(--ink)">
          <span class="text-[11px] uppercase tracking-[0.06em]" style="font-family: ui-monospace, Menlo, monospace; color: var(--green2)">
            <span class="en">{p.tagEn}</span><span class="es">{p.tagEs}</span>
          </span>
          <strong class="text-xl font-bold">{p.nombre}</strong>
          <span class="text-sm leading-relaxed" style="color: var(--ink2); text-wrap: pretty">
            <span class="en">{p.taglineEn}</span><span class="es">{p.taglineEs}</span>
          </span>
          <span class="mt-auto text-[13px] font-semibold" style="color: var(--green2)">
            <span class="en">View more</span><span class="es">Ver más</span> →
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>
