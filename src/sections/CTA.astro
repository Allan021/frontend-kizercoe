---
import ContactForm from '@/components/ContactForm';
/**
 * Contacto del rediseño: tres tarjetas de canal (WhatsApp, llamada, correo)
 * a la izquierda y el formulario real (API + Analytics) a la derecha.
 */
---

<section id="contacto" class="mx-auto grid w-full max-w-[1200px] gap-12 px-6 py-20" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr))" aria-labelledby="contact-title">
  <div class="flex flex-col gap-5">
    <p class="kz-eyebrow"><span class="en">We reply right away</span><span class="es">Respondemos de inmediato</span></p>
    <h2 id="contact-title" class="kz-h2" style="text-wrap: initial">
      <span class="en">Get your quote.</span>
      <span class="es">Cotizá tu proyecto.</span>
    </h2>
    <p class="text-[17px] leading-relaxed" style="color: var(--ink2); text-wrap: pretty">
      <span class="en">Free consultation, no strings attached. We reply within 24 hours with a plan made for you and honest prices.</span>
      <span class="es">Consulta gratis, sin compromiso. Te respondemos en 24 horas con un plan a tu medida y precios honestos.</span>
    </p>

    <div class="flex flex-col gap-3">
      <a href="https://wa.me/50488091744" target="_blank" rel="noopener noreferrer" class="kz-canal">
        <span class="h-2.5 w-2.5 shrink-0 rounded-full" style="background: var(--green)"></span>
        <span class="flex flex-col">
          <span class="text-xs font-medium" style="color: var(--mute)">WhatsApp</span>
          <span class="text-base font-semibold">+504 8809-1744</span>
        </span>
      </a>
      <a href="tel:+50488091744" class="kz-canal">
        <span class="h-2.5 w-2.5 shrink-0 rounded-full" style="background: var(--navy)"></span>
        <span class="flex flex-col">
          <span class="text-xs font-medium" style="color: var(--mute)">
            <span class="en">Call us · we answer and book your appointment</span>
            <span class="es">Llamanos · te contestamos y hacemos tu cita</span>
          </span>
          <span class="text-base font-semibold">+504 8809-1744</span>
        </span>
      </a>
      <a href="mailto:hello@kizercode.com" class="kz-canal">
        <span class="h-2.5 w-2.5 shrink-0 rounded-full" style="background: var(--mute)"></span>
        <span class="flex flex-col">
          <span class="text-xs font-medium" style="color: var(--mute)"><span class="en">Email</span><span class="es">Correo</span></span>
          <span class="text-base font-semibold">hello@kizercode.com</span>
        </span>
      </a>
    </div>
  </div>

  <div class="rounded-[20px] border p-7" style="background: var(--bg2); border-color: var(--line)">
    <ContactForm client:load />
  </div>

  <script>
    // El enlace #contacto?servicio=x no coincide con ningún id, así que el
    // navegador no hace scroll solo. Se hace a mano, al cargar y en cada
    // cambio de hash (venir de una tarjeta estando ya en la página).
    const irAlContacto = () => {
      if (location.hash.startsWith('#contacto?') || location.hash.startsWith('#contact?')) {
        document.getElementById('contacto')?.scrollIntoView();
      }
    };
    irAlContacto();
    window.addEventListener('hashchange', irAlContacto);
  </script>
</section>

<style>
  .kz-canal {
    display: flex;
    align-items: center;
    gap: 14px;
    background: var(--bg2);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 16px 18px;
    color: var(--ink);
    transition: border-color 0.2s ease;
  }
  .kz-canal:hover { border-color: var(--green); color: var(--ink); }
</style>
