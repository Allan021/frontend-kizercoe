---
/**
 * Marquesina de tecnologías.
 *
 * Animación en CSS puro, sin JavaScript ni librería: se duplica la lista y se
 * desplaza la mitad exacta, así el ciclo cierra sin salto. La copia va con
 * aria-hidden para que un lector de pantalla no lea doce nombres dos veces.
 */
const stack = [
  'React', 'Next.js', 'Astro', 'Node.js', 'TypeScript', 'Rust',
  'Tauri', 'PostgreSQL', 'Docker', 'Flutter', 'Python', 'Railway',
];
---

<section class="border-y py-8" style="border-color: var(--color-border)" aria-labelledby="stack-title">
  <h2 id="stack-title" class="sr-only">
    <span class="en">Technologies we work with</span>
    <span class="es">Tecnologías con las que trabajamos</span>
  </h2>

  <div class="kz-marquesina" style="--kz-mask: 96px">
    <ul class="kz-marquesina-pista list-none">
      {stack.map((t) => <li class="kz-marquesina-item">{t}</li>)}
    </ul>
    <ul class="kz-marquesina-pista list-none" aria-hidden="true">
      {stack.map((t) => <li class="kz-marquesina-item">{t}</li>)}
    </ul>
  </div>
</section>

<style>
  .kz-marquesina {
    display: flex;
    overflow: hidden;
    user-select: none;
    gap: 0;
    /* Desvanece los bordes en vez de cortar en seco. */
    mask-image: linear-gradient(90deg, transparent, #000 var(--kz-mask), #000 calc(100% - var(--kz-mask)), transparent);
  }

  .kz-marquesina-pista {
    display: flex;
    flex-shrink: 0;
    gap: 3rem;
    padding-right: 3rem;
    min-width: 100%;
    justify-content: space-around;
  }

  .kz-marquesina-item {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-muted-2);
    transition: color 0.2s ease;
  }
  .kz-marquesina-item:hover { color: var(--color-accent); }

  @media (prefers-reduced-motion: no-preference) {
    .kz-marquesina-pista {
      animation: kz-desplazar 38s linear infinite;
      /* La animación corre en el compositor: no repinta ni recalcula layout. */
      will-change: transform;
    }
    .kz-marquesina:hover .kz-marquesina-pista { animation-play-state: paused; }
  }

  @keyframes kz-desplazar {
    to { transform: translateX(-100%); }
  }
</style>
