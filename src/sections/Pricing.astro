---
/**
 * Precios por lo que el cliente quiere, con toggle Lempiras/Dólares.
 * Se renderizan las dos monedas y el CSS (html[data-moneda]) muestra una;
 * el toggle solo cambia ese atributo y lo guarda. Cero re-render.
 */
const cosas = [
  { t_en: 'A website for your business', t_es: 'Una página web para tu negocio', lps: 'L 4,000', usd: '$150', servicio: 'Web Applications',
    en: ['Designed for your brand, not a template', 'WhatsApp button and map included', 'Ready in about a week'],
    es: ['Diseñada para tu marca, no una plantilla', 'Con botón de WhatsApp y mapa', 'Lista en más o menos una semana'] },
  { t_en: 'Modernize my old website', t_es: 'Modernizar mi sitio viejo', lps: 'L 6,500', usd: '$250', servicio: 'Site Modernization',
    en: ["Today's design, without starting from zero", 'We add AI, WhatsApp and whatever is missing', 'Your content and domain stay yours'],
    es: ['Diseño de hoy, sin empezar de cero', 'Le metemos IA, WhatsApp y lo que le falte', 'Tu contenido y tu dominio se quedan'] },
  { t_en: 'An online store', t_es: 'Una tienda en línea', lps: 'L 14,500', usd: '$550', servicio: 'Online Store',
    en: ['Catalog, cart and payments', 'A panel to upload your products', 'Connected to your inventory if you have one'],
    es: ['Catálogo, carrito y pagos', 'Panel para subir tus productos vos mismo', 'Conectada a tu inventario si tenés uno'] },
  { t_en: 'A system for your business', t_es: 'Un sistema para tu negocio', lps: 'L 25,000', usd: '$950', servicio: 'Business System',
    en: ['Inventory, billing, orders: what you run', 'Roles for your team and live reports', 'Built on your real process'],
    es: ['Inventario, facturación, pedidos: lo tuyo', 'Roles para tu equipo y reportes en vivo', 'Construido sobre tu proceso real'] },
  { t_en: 'A mobile app', t_es: 'Una app móvil', lps: 'L 37,000', usd: '$1,400', servicio: 'Mobile Apps',
    en: ['iOS and Android, one codebase', 'Connected to your system or store', 'Published in the stores'],
    es: ['iOS y Android con una sola base', 'Conectada a tu sistema o tienda', 'Publicada en las tiendas'] },
  { t_en: 'AI that answers for you', t_es: 'Una IA que atienda por vos', lps: 'L 8,000', usd: '$300', servicio: 'AI Automation',
    en: ['Answers and quotes on WhatsApp 24/7', 'Uses your real prices and catalog', 'Everything it does gets logged'],
    es: ['Responde y cotiza en WhatsApp 24/7', 'Usa tus precios y catálogo reales', 'Todo lo que hace queda registrado'] },
  { t_en: 'Fix my computer or phone', t_es: 'Reparar mi compu o teléfono', gratis: true, servicio: 'Computer Repair',
    en: ['We tell you what it has and what it costs', 'You approve before we touch anything', 'We also buy and sell equipment'],
    es: ['Te decimos qué tiene y cuánto cuesta', 'Vos aprobás antes de que toquemos nada', 'También compramos y vendemos equipo'] },
  { t_en: 'Install security cameras', t_es: 'Instalar cámaras de seguridad', sinPrecio_en: 'Written quote', sinPrecio_es: 'Cotización por escrito', servicio: 'Security Cameras',
    en: ['HD cameras with night vision', 'Watch them live from your phone', 'Wiring, recorder and setup included'],
    es: ['Cámaras HD con visión nocturna', 'Las ves en vivo desde tu celular', 'Cableado, grabador y configuración'] },
];
---

<section id="precios" class="mx-auto flex w-full max-w-[1200px] flex-col gap-9 px-6 py-20">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div class="flex max-w-[560px] flex-col gap-2.5">
      <p class="kz-eyebrow"><span class="en">Clear, transparent pricing</span><span class="es">Precios claros y transparentes</span></p>
      <h2 id="pricing-title" class="kz-h2" style="text-wrap: initial">
        <span class="en">What you need, and what it costs.</span>
        <span class="es">Lo que necesitás, y lo que cuesta.</span>
      </h2>
      <p class="text-[17px] leading-relaxed" style="color: var(--ink2); text-wrap: pretty">
        <span class="en">The "from" prices are the floor. You pay once, and before starting you get the exact fixed price in writing. It doesn't move.</span>
        <span class="es">Los "desde" son el piso. Pagás una vez, y antes de empezar te damos el precio fijo exacto por escrito. No se mueve.</span>
      </p>
    </div>
    <div class="inline-flex rounded-xl border p-1" style="background: var(--bg2); border-color: var(--line)" role="group" aria-label="Moneda">
      <button id="btn-lps" class="kz-moneda-btn cursor-pointer rounded-[9px] border-0 px-4 py-2 text-[13px] font-semibold">Lempiras</button>
      <button id="btn-usd" class="kz-moneda-btn cursor-pointer rounded-[9px] border-0 px-4 py-2 text-[13px] font-semibold">
        <span class="en">Dollars</span><span class="es">Dólares</span>
      </button>
    </div>
  </div>

  <ul class="grid list-none items-stretch gap-4" style="grid-template-columns: repeat(auto-fit, minmax(250px, 1fr))">
    {cosas.map((c) => (
      <li>
        <article class="kz-card flex h-full flex-col gap-3.5 p-6">
          <h3 class="text-lg font-bold leading-snug" style="text-wrap: balance">
            <span class="en">{c.t_en}</span><span class="es">{c.t_es}</span>
          </h3>
          <p class="flex flex-wrap items-baseline gap-2">
            {c.gratis || c.sinPrecio_es ? (
              <span class="text-2xl font-bold" style="letter-spacing: -0.02em; color: var(--green)">
                <span class="en">{c.sinPrecio_en ?? 'Free diagnosis'}</span><span class="es">{c.sinPrecio_es ?? 'Diagnóstico gratis'}</span>
              </span>
            ) : (
              <>
                <span class="text-[13px]" style="color: var(--mute)"><span class="en">from</span><span class="es">desde</span></span>
                <span class="text-3xl font-bold" style="letter-spacing: -0.02em; color: var(--green)">
                  <span class="lps">{c.lps}</span><span class="usd">{c.usd}</span>
                </span>
                <span class="text-[13px]" style="color: var(--mute)"><span class="en">one-time</span><span class="es">pago único</span></span>
              </>
            )}
          </p>
          <ul class="flex list-none flex-col gap-2">
            {c.es.map((item, i) => (
              <li class="flex items-start gap-2.5 text-sm leading-normal" style="color: var(--ink2)">
                <span class="shrink-0 font-bold" style="color: var(--green)">✓</span>
                <span><span class="en">{c.en[i]}</span><span class="es">{item}</span></span>
              </li>
            ))}
          </ul>
          <a href={`/contacto/?servicio=${encodeURIComponent(c.servicio)}`} class="kz-btn kz-btn-navy mt-auto w-full text-sm" style="padding: 12px 16px; border-radius: 10px">
            <span class="en">Get my exact price</span><span class="es">Quiero mi precio exacto</span>
          </a>
        </article>
      </li>
    ))}
  </ul>

  <div class="grid gap-5 pt-2" style="grid-template-columns: repeat(auto-fit, minmax(240px, 1fr))">
    <div class="flex flex-col gap-1">
      <strong class="text-[15px] font-semibold"><span class="en">Exact price in writing</span><span class="es">Precio exacto por escrito</span></strong>
      <span class="text-sm leading-relaxed" style="color: var(--ink2)"><span class="en">Your quote states the fixed amount, in lempiras or dollars.</span><span class="es">Tu cotización trae el monto fijo, en lempiras o dólares.</span></span>
    </div>
    <div class="flex flex-col gap-1">
      <strong class="text-[15px] font-semibold"><span class="en">30-day warranty</span><span class="es">30 días de garantía</span></strong>
      <span class="text-sm leading-relaxed" style="color: var(--ink2)"><span class="en">If what we delivered fails, we fix it free.</span><span class="es">Si lo entregado falla, lo corregimos gratis.</span></span>
    </div>
    <div class="flex flex-col gap-1">
      <strong class="text-[15px] font-semibold"><span class="en">Ongoing support, monthly plan</span><span class="es">Soporte continuo, plan mensual</span></strong>
      <span class="text-sm leading-relaxed" style="color: var(--ink2)"><span class="en">New changes are quoted; continuous care comes as a monthly plan.</span><span class="es">Los cambios nuevos se cotizan; el cuidado continuo va en plan mensual.</span></span>
    </div>
  </div>
</section>

<style>
  .kz-moneda-btn { background: transparent; color: var(--ink2); transition: background-color 0.15s ease, color 0.15s ease; }
  html:not([data-moneda='usd']) #btn-lps,
  html[data-moneda='usd'] #btn-usd { background: var(--navy); color: var(--bg); }
</style>

<script>
  // El toggle cambia el atributo del documento; el CSS hace el resto en toda
  // la página (hero, comparativo y precios usan .lps/.usd).
  const poner = (m: string) => {
    document.documentElement.setAttribute('data-moneda', m);
    localStorage.setItem('kz-moneda', m);
  };
  document.getElementById('btn-lps')?.addEventListener('click', () => poner('lps'));
  document.getElementById('btn-usd')?.addEventListener('click', () => poner('usd'));
</script>
