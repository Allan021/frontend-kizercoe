---
import { Icon } from 'astro-icon/components';

/**
 * Precios por lo que el cliente quiere, no por horas de developer.
 *
 * Nadie llega pensando "quiero 20 h/semana de un programador": llega pensando
 * "quiero mi página" o "que la compu encienda". Cada tarjeta es una de esas
 * frases, con su "desde" y un botón que abre el formulario con el servicio ya
 * elegido (#contact?servicio=...).
 */
const cosas = [
  {
    icon: 'lucide:globe',
    t_en: 'A website for your business',
    t_es: 'Una página web para tu negocio',
    precio: '$150',
    unica: true,
    servicio: 'Web Applications',
    en: ['Designed for your brand, not a template', 'WhatsApp button and map included', 'Ready in about a week'],
    es: ['Diseñada para tu marca, no una plantilla', 'Con botón de WhatsApp y mapa', 'Lista en más o menos una semana'],
  },
  {
    icon: 'lucide:shopping-cart',
    t_en: 'An online store',
    t_es: 'Una tienda en línea',
    precio: '$400',
    unica: true,
    servicio: 'Online Store',
    en: ['Catalog, cart and payments', 'A panel to upload your products', 'Connected to your inventory if you have one'],
    es: ['Catálogo, carrito y pagos', 'Panel para subir tus productos vos mismo', 'Conectada a tu inventario si tenés uno'],
  },
  {
    icon: 'lucide:boxes',
    t_en: 'A system for your business',
    t_es: 'Un sistema para tu negocio',
    precio: '$600',
    unica: true,
    servicio: 'Business System',
    en: ['Inventory, billing, orders: what you run', 'Roles for your team and live reports', 'Built on your real process'],
    es: ['Inventario, facturación, pedidos: lo tuyo', 'Roles para tu equipo y reportes en vivo', 'Construido sobre tu proceso real'],
  },
  {
    icon: 'lucide:smartphone',
    t_en: 'A mobile app',
    t_es: 'Una app móvil',
    precio: '$900',
    unica: true,
    servicio: 'Mobile Apps',
    en: ['iOS and Android, one codebase', 'Connected to your system or store', 'Published in the stores'],
    es: ['iOS y Android con una sola base', 'Conectada a tu sistema o tienda', 'Publicada en las tiendas'],
  },
  {
    icon: 'lucide:bot',
    t_en: 'AI that answers for you',
    t_es: 'Una IA que atienda por vos',
    precio: '$200',
    unica: true,
    servicio: 'AI Automation',
    en: ['Answers and quotes on WhatsApp 24/7', 'Uses your real prices and catalog', 'Everything it does gets logged'],
    es: ['Responde y cotiza en WhatsApp 24/7', 'Usa tus precios y catálogo reales', 'Todo lo que hace queda registrado'],
  },
  {
    icon: 'lucide:wrench',
    t_en: 'Fix my computer or phone',
    t_es: 'Reparar mi compu o teléfono',
    precio: null,
    gratis_en: 'Free diagnosis',
    gratis_es: 'Diagnóstico gratis',
    servicio: 'Computer Repair',
    en: ['We tell you what it has and what it costs', 'You approve before we touch anything', 'We also buy and sell equipment'],
    es: ['Te decimos qué tiene y cuánto cuesta', 'Vos aprobás antes de que toquemos nada', 'También compramos y vendemos equipo'],
  },
];
---

<section id="pricing" class="py-16 sm:py-24" aria-labelledby="pricing-title">
  <div class="mx-auto max-w-6xl px-6">
    <header class="mb-12 max-w-2xl">
      <p class="kz-eyebrow">// <span class="en">pricing</span><span class="es">precios</span></p>
      <h2 id="pricing-title" class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
        <span class="en">What you need,<br />and what it costs.</span>
        <span class="es">Lo que necesitás,<br />y lo que cuesta.</span>
      </h2>
      <p class="mt-4 leading-relaxed" style="color: var(--color-muted)">
        <span class="en">
          Whether you run a small shop that's just starting or a big project, there's a starting
          point for you. One-time payment, and before starting you get the exact fixed price in
          writing — it doesn't move.
        </span>
        <span class="es">
          Da igual si tenés un local que viene empezando o un proyecto grande: hay un punto de
          partida para vos. Pagás una vez, y antes de empezar te damos el precio fijo exacto por
          escrito — no se mueve.
        </span>
      </p>
    </header>

    <ul class="grid list-none items-stretch gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        cosas.map((c) => (
          <li>
            <article class="kz-card flex h-full flex-col p-6 sm:p-7">
              <span class="kz-precio-icono">
                <Icon name={c.icon} size={20} aria-hidden="true" />
              </span>

              <h3 class="mt-4 text-lg font-bold leading-snug">
                <span class="en">{c.t_en}</span><span class="es">{c.t_es}</span>
              </h3>

              <p class="mt-3 flex items-baseline gap-1.5">
                {c.precio ? (
                  <>
                    <span class="font-mono text-[11.5px] uppercase tracking-wider" style="color: var(--color-muted-2)">
                      <span class="en">from</span><span class="es">desde</span>
                    </span>
                    <span class="text-3xl font-bold tracking-tight">{c.precio}</span>
                    {c.unica && (
                      <span class="font-mono text-xs" style="color: var(--color-muted-2)">
                        <span class="en">one-time</span><span class="es">pago único</span>
                      </span>
                    )}
                  </>
                ) : (
                  <span class="text-2xl font-bold tracking-tight" style="color: var(--color-accent)">
                    <span class="en">{c.gratis_en}</span><span class="es">{c.gratis_es}</span>
                  </span>
                )}
              </p>

              <ul class="mt-5 flex-1 list-none space-y-2 text-sm">
                {c.es.map((item, i) => (
                  <li class="flex gap-2.5">
                    <Icon
                      name="lucide:check"
                      size={15}
                      class="mt-0.5 shrink-0"
                      style="color: var(--color-accent)"
                      aria-hidden="true"
                    />
                    <span style="color: var(--color-muted)">
                      <span class="en">{c.en[i]}</span><span class="es">{item}</span>
                    </span>
                  </li>
                ))}
              </ul>

              <a
                href={`#contact?servicio=${encodeURIComponent(c.servicio)}`}
                class="kz-btn kz-btn-secundario mt-6 w-full justify-center"
              >
                <span class="en">Get my exact price</span><span class="es">Quiero mi precio exacto</span>
              </a>
            </article>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 font-mono text-[12.5px]" style="color: var(--color-muted-2)">
      <span class="en">
        "From" prices in USD before taxes; we also quote in lempiras. Need a dedicated team every
        month? We have monthly plans too, just ask.
      </span>
      <span class="es">
        Precios "desde" en USD antes de impuestos; también cotizamos en lempiras. ¿Necesitás un
        equipo dedicado todos los meses? También hay planes mensuales, preguntanos.
      </span>
    </p>
  </div>
</section>

<style>
  .kz-precio-icono {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 11px;
    border: 1px solid var(--color-border);
    background: var(--color-bg-2);
    color: var(--color-accent);
  }
</style>
