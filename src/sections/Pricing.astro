---
import { Icon } from 'astro-icon/components';

const planes = [
  {
    nombre: 'Starter',
    precio: '$750',
    en_sub: 'A part-time developer, for a first system',
    es_sub: 'Un desarrollador medio tiempo, para un primer sistema',
    en: [
      'Developer 20 h/week',
      'Site or system with 3 to 5 screens',
      'Content admin panel',
      '1 round of revisions per month',
      'Support in under 24 h',
    ],
    es: [
      'Desarrollador 20 h/semana',
      'Sitio o sistema de 3 a 5 pantallas',
      'Panel de administración de contenido',
      '1 ronda de revisiones al mes',
      'Soporte en menos de 24 h',
    ],
    en_cta: 'Start',
    es_cta: 'Empezar',
  },
  {
    nombre: 'Growth',
    precio: '$1,900',
    destacado: true,
    en_sub: 'A senior developer full time on your project',
    es_sub: 'Un desarrollador senior a tiempo completo en tu proyecto',
    en: [
      'Senior developer 40 h/week',
      'Custom web or mobile app',
      'UX/UI design and prototype',
      'Payments, billing and CRM integrations',
      '2 rounds of revisions per month',
      'Priority support in under 4 h',
    ],
    es: [
      'Desarrollador senior 40 h/semana',
      'Aplicación web o móvil a la medida',
      'Diseño UX/UI y prototipo',
      'Integraciones con pagos, facturación y CRM',
      '2 rondas de revisiones al mes',
      'Soporte prioritario en menos de 4 h',
    ],
    en_cta: 'Start',
    es_cta: 'Empezar',
  },
  {
    nombre: 'Scale',
    precio: '$3,500',
    en_sub: 'A full team for platforms with hardware in the field',
    es_sub: 'Equipo completo para plataformas con equipo en campo',
    en: [
      'Developer + designer + QA',
      'Complete platform, web and mobile',
      'Hardware supply and on-site installation',
      'Data migration and training',
      'Unlimited revisions',
      'Same-day support and weekly calls',
    ],
    es: [
      'Desarrollador + diseñador + QA',
      'Plataforma completa, web y móvil',
      'Suministro de equipo e instalación en sitio',
      'Migración de datos y capacitación',
      'Revisiones ilimitadas',
      'Soporte el mismo día y llamadas semanales',
    ],
    en_cta: 'Talk to sales',
    es_cta: 'Hablar con ventas',
  },
];
---

<section id="pricing" class="py-24 sm:py-32" aria-labelledby="pricing-title">
  <div class="mx-auto max-w-6xl px-6">
    <header class="mb-12 max-w-2xl">
      <p class="kz-eyebrow">// <span class="en">pricing</span><span class="es">precios</span></p>
      <h2 id="pricing-title" class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
        <span class="en">Monthly plans with<br />a dedicated team.</span>
        <span class="es">Planes mensuales con<br />equipo dedicado.</span>
      </h2>
      <p class="mt-4 leading-relaxed" style="color: var(--color-muted)">
        <span class="en">
          For businesses that need continuous development. One-off projects are quoted separately
          by scope.
        </span>
        <span class="es">
          Para negocios que necesitan desarrollo continuo. Los proyectos puntuales se cotizan
          aparte por alcance.
        </span>
      </p>
    </header>

    <ul class="grid list-none items-start gap-5 lg:grid-cols-3">
      {
        planes.map((p) => (
          <li>
            <article
              class={`kz-card flex h-full flex-col p-7 ${p.destacado ? 'kz-card-principal' : ''}`}
            >
              {p.destacado && (
                <p class="kz-eyebrow mb-3">
                  <span class="en">most chosen</span><span class="es">el más elegido</span>
                </p>
              )}

              <h3 class="text-xl font-bold">{p.nombre}</h3>
              <p class="mt-1.5 text-sm leading-snug" style="color: var(--color-muted)">
                <span class="en">{p.en_sub}</span><span class="es">{p.es_sub}</span>
              </p>

              <p class="mt-6 flex items-baseline gap-1.5">
                <span class="text-4xl font-bold tracking-tight">{p.precio}</span>
                <span class="font-mono text-sm" style="color: var(--color-muted-2)">
                  <span class="en">/mo</span><span class="es">/mes</span>
                </span>
              </p>

              <ul class="mt-7 flex-1 list-none space-y-2.5 text-sm">
                {p.es.map((item, i) => (
                  <li class="flex gap-2.5">
                    <Icon
                      name="lucide:check"
                      size={16}
                      class="mt-0.5 shrink-0"
                      style="color: var(--color-accent)"
                      aria-hidden="true"
                    />
                    <span style="color: var(--color-muted)">
                      <span class="en">{p.en[i]}</span><span class="es">{item}</span>
                    </span>
                  </li>
                ))}
              </ul>

              <a
                href="#contact"
                class={`kz-btn mt-8 w-full justify-center ${p.destacado ? 'kz-btn-primario' : 'kz-btn-secundario'}`}
              >
                <span class="en">{p.en_cta}</span><span class="es">{p.es_cta}</span>
              </a>
            </article>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 font-mono text-[12.5px]" style="color: var(--color-muted-2)">
      <span class="en">
        Prices in USD, before taxes. Hardware is quoted separately based on what each project needs.
      </span>
      <span class="es">
        Precios en USD, antes de impuestos. El equipo se cotiza aparte según lo que requiera cada
        proyecto.
      </span>
    </p>
  </div>
</section>
