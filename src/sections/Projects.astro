---
import ProjectsGrid from '@/components/Projects.tsx';
import { fetchProjects } from '@/lib/api';
import { casosDe, slugCaso, urlCaso } from '@/lib/casos';

// Al compilar: los proyectos van en el HTML. Sin API, igual que antes.
const inicial = await fetchProjects().catch(() => null);
// Schema del portafolio solo donde se pide (/proyectos), no en la portada.
const { schema = false } = Astro.props;

// Caso de éxito destacado arriba de la grilla: el número es lo que vende.
const [destacado] = await casosDe(false);
const destacadoEn = destacado && (await casosDe(true)).find((c) => slugCaso(c) === slugCaso(destacado));
const enPagina = Astro.url.pathname.startsWith('/en/');
const jsonLd = inicial?.length && {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: inicial.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'CreativeWork',
      name: p.title,
      description: p.summary,
      ...(p.imageUrl ? { image: p.imageUrl } : {}),
      ...(p.liveUrl ? { url: p.liveUrl } : {}),
      ...(p.client ? { sourceOrganization: { '@type': 'Organization', name: p.client } } : {}),
      creator: { '@id': 'https://www.kizercode.com/#business' },
    },
  })),
};
---

<section id="casos" class="border-y" style="background: var(--bg2); border-color: var(--line)">
  <div class="mx-auto max-w-[1200px] px-6 py-20">
    <div class="mx-auto mb-9 flex max-w-[560px] flex-col items-center gap-2.5 text-center">
      <p class="kz-eyebrow"><span class="en">Real results</span><span class="es">Resultados reales</span></p>
      <h2 id="projects-title" class="kz-h2">
        <span class="en">Success cases</span>
        <span class="es">Casos de éxito</span>
      </h2>
      <p class="text-base" style="color: var(--mute); text-wrap: pretty">
        <span class="en">Systems running today in real businesses.</span>
        <span class="es">Sistemas que hoy están corriendo en negocios reales.</span>
      </p>
    </div>

    {destacado && (
      <a href={urlCaso(slugCaso(destacado), enPagina && !!destacadoEn)} class="kz-card kz-destacado mb-8 flex flex-wrap items-center gap-x-8 gap-y-3 p-7" style="color: var(--ink)">
        <span class="font-bold leading-none" style="font-size: clamp(34px, 4.4vw, 48px); letter-spacing: -0.02em; color: var(--green2)">{destacado.data.metricas[0].valor}</span>
        <span class="flex min-w-[240px] flex-1 flex-col gap-1">
          <span class="text-[17px] font-bold">{destacado.data.cliente} · {destacado.data.lugar}</span>
          <span class="text-[15px]" style="color: var(--ink2)">
            <span class="es">{destacado.data.metricas[0].etiqueta}</span>
            <span class="en">{destacadoEn?.data.metricas[0].etiqueta ?? destacado.data.metricas[0].etiqueta}</span>
          </span>
        </span>
        <span class="text-[14.5px] font-semibold" style="color: var(--green2)">
          <span class="es">Leer el caso</span><span class="en">Read the case study</span> →
        </span>
      </a>
    )}

    <!-- client:visible: no se pide nada a la API hasta que la sección entra
         en pantalla. Los casos se administran desde /panel. -->
    <ProjectsGrid client:visible inicial={inicial} />
    {schema && jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </div>
</section>
