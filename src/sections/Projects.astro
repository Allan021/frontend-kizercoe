---
import ProjectsGrid from '@/components/Projects.tsx';
---

<section id="casos" class="border-y" style="background: var(--bg2); border-color: var(--line)">
  <div class="mx-auto max-w-[1200px] px-6 py-20">
    <div class="mx-auto mb-9 flex max-w-[560px] flex-col items-center gap-2.5 text-center">
      <p class="kz-eyebrow"><span class="en">Real results</span><span class="es">Resultados reales</span></p>
      <h2 id="projects-title" class="kz-h2">
        <span class="en">Success cases</span>
        <span class="es">Casos de éxito</span>
      </h2>
      <p class="text-base" style="color: var(--mute); text-wrap: pretty">
        <span class="en">Systems running today in real businesses.</span>
        <span class="es">Sistemas que hoy están corriendo en negocios reales.</span>
      </p>
    </div>

    <!-- client:visible: no se pide nada a la API hasta que la sección entra
         en pantalla. Los casos se administran desde /panel. -->
    <ProjectsGrid client:visible />
  </div>
</section>
