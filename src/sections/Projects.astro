---
import ProjectsGrid from '@/components/Projects.tsx';
---

<section id="proyectos" class="py-24 sm:py-32" aria-labelledby="projects-title">
  <div class="mx-auto max-w-6xl px-6">
    <header class="mb-12 max-w-2xl">
      <p class="kz-eyebrow">// <span class="en">work</span><span class="es">trabajo</span></p>
      <h2 id="projects-title" class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
        <span class="en">What we have <span class="gradient-text">built</span></span>
        <span class="es">Lo que hemos <span class="gradient-text">construido</span></span>
      </h2>
      <p class="mt-4 leading-relaxed" style="color: var(--color-muted)">
        <span class="en">Systems running today in real businesses in Honduras.</span>
        <span class="es">Sistemas que hoy están corriendo en negocios reales de Honduras.</span>
      </p>
    </header>

    <!-- client:visible: no se pide nada a la API hasta que la sección entra
         en pantalla. Así el portafolio no pesa en la carga inicial. -->
    <ProjectsGrid client:visible />
  </div>
</section>
