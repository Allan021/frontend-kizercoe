---
/** Proceso en 5 pasos numerados con tiempos, más el callout de hardware. */
const pasos = [
  { num: '1', t_en: 'Diagnosis call', t_es: 'Llamada de diagnóstico', d_en: 'We map how you work today and where the process breaks. Free, no strings.', d_es: 'Mapeamos cómo trabajás hoy y dónde se rompe el proceso. Gratis y sin compromiso.', tiempo: '30 min' },
  { num: '2', t_en: 'Proposal', t_es: 'Propuesta', d_en: 'Written scope, fixed price and a real timeline, hardware included when it applies.', d_es: 'Alcance escrito, precio fijo y cronograma real, con equipo incluido cuando aplica.', tiempo: '2–5 días', tiempo_en: '2–5 days' },
  { num: '3', t_en: 'Design', t_es: 'Diseño', d_en: 'A navigable prototype of every screen. You approve before a line of code is written.', d_es: 'Prototipo navegable de cada pantalla. Lo aprobás antes de escribir una línea de código.', tiempo: '1–2 sem', tiempo_en: '1–2 wks' },
  { num: '4', t_en: 'Development', t_es: 'Desarrollo', d_en: 'Weekly demos in a live environment. You see progress, not status reports.', d_es: 'Demos semanales en un ambiente en línea. Ves avances, no informes de estado.', tiempo: '2–6 sem', tiempo_en: '2–6 wks' },
  { num: '5', t_en: 'Launch and support', t_es: 'Lanzamiento y soporte', d_en: 'Go-live, training, credentials handover and 30 days of support included.', d_es: 'Puesta en marcha, capacitación, entrega de credenciales y 30 días de soporte incluidos.', tiempo: '+30 días', tiempo_en: '+30 days' },
];
---

<section id="como" class="mx-auto grid w-full max-w-[1200px] gap-12 px-6 py-20" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr))">
  <div class="flex flex-col gap-4">
    <p class="kz-eyebrow"><span class="en">Our process</span><span class="es">Nuestro proceso</span></p>
    <h2 class="kz-h2" style="text-wrap: initial">
      <span class="en">Five steps, no surprises along the way.</span>
      <span class="es">Cinco pasos, sin sorpresas en el camino.</span>
    </h2>
    <p class="text-[17px] leading-relaxed" style="color: var(--ink2); text-wrap: pretty">
      <span class="en">You approve each stage before the next one starts. If you change the scope mid-project we quote it separately and you decide.</span>
      <span class="es">Aprobás cada etapa antes de que empiece la siguiente. Si cambiás el alcance a mitad del proyecto lo cotizamos aparte y vos decidís.</span>
    </p>
    <div class="mt-2 grid gap-2.5" style="grid-template-columns: repeat(auto-fit, minmax(150px, 1fr))">
      <div class="rounded-[14px] border p-4" style="background: var(--bg2); border-color: var(--line)">
        <strong class="block text-[15px] font-semibold"><span class="en">Reply in 24 h</span><span class="es">Respuesta en 24 h</span></strong>
        <span class="text-[13px]" style="color: var(--mute)"><span class="en">max, on WhatsApp or email</span><span class="es">máximo, por WhatsApp o correo</span></span>
      </div>
      <div class="rounded-[14px] border p-4" style="background: var(--bg2); border-color: var(--line)">
        <strong class="block text-[15px] font-semibold"><span class="en">Weekly demos</span><span class="es">Demos semanales</span></strong>
        <span class="text-[13px]" style="color: var(--mute)"><span class="en">you see progress, not reports</span><span class="es">ves avances, no informes</span></span>
      </div>
      <div class="rounded-[14px] border p-4" style="background: var(--bg2); border-color: var(--line)">
        <strong class="block text-[15px] font-semibold"><span class="en">100% yours</span><span class="es">100 % tuyo</span></strong>
        <span class="text-[13px]" style="color: var(--mute)"><span class="en">code, domain and hosting</span><span class="es">código, dominio y hosting</span></span>
      </div>
    </div>
    <div class="flex flex-col gap-1 rounded-[14px] border p-5" style="background: var(--green-soft); border-color: color-mix(in srgb, var(--green) 30%, transparent)">
      <strong class="text-[15px] font-semibold" style="color: var(--green2)">
        <span class="en">We also supply the hardware and leave it running.</span>
        <span class="es">También ponemos el equipo y lo dejamos funcionando.</span>
      </strong>
      <p class="text-sm leading-relaxed" style="color: var(--ink2); text-wrap: pretty">
        <span class="en">Terminals, scanners, printers or a server: quoted in the same proposal, installed at your place, with data migration and training.</span>
        <span class="es">Terminales, lectores, impresoras o servidor: cotizados en la misma propuesta, instalados en tu local, con migración de datos y capacitación.</span>
      </p>
    </div>
  </div>

  <ol class="flex list-none flex-col">
    {pasos.map((p) => (
      <li class="grid items-start gap-4 border-b py-4" style="grid-template-columns: 40px 1fr auto; border-color: var(--line)">
        <span class="flex h-8 w-8 items-center justify-center rounded-full text-[13px] font-bold text-white" style="background: var(--green)">{p.num}</span>
        <div class="flex flex-col gap-1">
          <strong class="text-base font-semibold"><span class="en">{p.t_en}</span><span class="es">{p.t_es}</span></strong>
          <span class="text-sm leading-relaxed" style="color: var(--ink2); text-wrap: pretty"><span class="en">{p.d_en}</span><span class="es">{p.d_es}</span></span>
        </div>
        <span class="whitespace-nowrap pt-1.5 text-xs font-semibold" style="color: var(--green2)">
          {p.tiempo_en ? <><span class="en">{p.tiempo_en}</span><span class="es">{p.tiempo}</span></> : p.tiempo}
        </span>
      </li>
    ))}
  </ol>
</section>
