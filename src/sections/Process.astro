---
const pasos = [
  {
    n: '01',
    tiempo: '30 min',
    en_t: 'Diagnostic call',
    es_t: 'Llamada de diagnóstico',
    en_d: 'We map how you work today and where the process breaks. Free, no commitment.',
    es_d: 'Mapeamos cómo trabajás hoy y dónde se rompe el proceso. Gratis y sin compromiso.',
  },
  {
    n: '02',
    tiempo: '2–5 días',
    en_t: 'Proposal',
    es_t: 'Propuesta',
    en_d: 'Written scope, fixed price and a real schedule, with hardware included when it applies.',
    es_d: 'Alcance escrito, precio fijo y cronograma real, con equipo incluido cuando aplica.',
  },
  {
    n: '03',
    tiempo: '1–2 sem',
    en_t: 'Design',
    es_t: 'Diseño',
    en_d: 'A clickable prototype of every screen. You approve it before a line of code is written.',
    es_d: 'Prototipo navegable de cada pantalla. Lo aprobás antes de escribir una línea de código.',
  },
  {
    n: '04',
    tiempo: '2–6 sem',
    en_t: 'Development',
    es_t: 'Desarrollo',
    en_d: 'Weekly demos in a live environment. You see progress, not status reports.',
    es_d: 'Demos semanales en un ambiente en línea. Ves avances, no informes de estado.',
  },
  {
    n: '05',
    tiempo: '+30 días',
    en_t: 'Launch and support',
    es_t: 'Lanzamiento y soporte',
    en_d: 'Go-live, training, handover of credentials and 30 days of support included.',
    es_d: 'Puesta en marcha, capacitación, entrega de credenciales y 30 días de soporte incluidos.',
  },
];
---

<section id="process" class="py-24 sm:py-32" aria-labelledby="process-title">
  <div class="mx-auto max-w-6xl px-6">
    <header class="mb-12 max-w-2xl">
      <p class="kz-eyebrow">// <span class="en">process</span><span class="es">proceso</span></p>
      <h2 id="process-title" class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
        <span class="en">Five steps, no surprises<br />along the way.</span>
        <span class="es">Cinco pasos, sin sorpresas<br />en el camino.</span>
      </h2>
      <p class="mt-4 leading-relaxed" style="color: var(--color-muted)">
        <span class="en">
          You approve each stage before the next one starts. If you change the scope midway, we
          quote it separately and you decide.
        </span>
        <span class="es">
          Aprobás cada etapa antes de que empiece la siguiente. Si cambiás el alcance a mitad del
          proyecto lo cotizamos aparte y vos decidís.
        </span>
      </p>
    </header>

    <!-- Lista ordenada: el orden de los pasos ES la información. -->
    <ol class="grid list-none gap-5 sm:grid-cols-2 lg:grid-cols-5">
      {
        pasos.map((p) => (
          <li class="kz-card h-full p-6">
            <p class="kz-eyebrow">
              {p.n} <span aria-hidden="true">·</span> {p.tiempo}
            </p>
            <h3 class="mt-3.5 font-bold leading-snug">
              <span class="en">{p.en_t}</span><span class="es">{p.es_t}</span>
            </h3>
            <p class="mt-2 text-sm leading-relaxed" style="color: var(--color-muted)">
              <span class="en">{p.en_d}</span><span class="es">{p.es_d}</span>
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
