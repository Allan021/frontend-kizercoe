# API del backend (Railway en producción).
PUBLIC_API_URL=http://localhost:3001

# ── Herramientas de Google (opcionales: sin valor no cargan nada) ──
# Analytics 4: analytics.google.com → Administrar → Flujos de datos → ID "G-...".
PUBLIC_GA_ID=
# Search Console: search.google.com/search-console → Verificación por etiqueta
# HTML → pegar solo el content="..." de la meta.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Cloudinary (subida de imágenes del panel) ──
# Por defecto usa el cloud/preset del proyecto; solo si cambian:
PUBLIC_CLOUDINARY_CLOUD=
PUBLIC_CLOUDINARY_PRESET=
